/* Color module */

import constants

var _ClrBadInitErr = Error("ClrBadInit", "Color expects RGB, RGBA, or a length-3/4 List, Tuple, or Matrix.")

/** Defines the color protocol: anything sampleable via red/green/blue/rgb/rgba. */
class Coloring {
  red(x) { return 0 }
  green(x) { return 0 }
  blue(x) { return 0 }
  alpha(x) { return 1 }
  rgb(x) { return (self.red(x), self.green(x), self.blue(x)) }
  rgba(x) {
    var c = self.rgb(x)
    return (c[0], c[1], c[2], self.alpha(x))
  }
}

/** Fixed RGBA color value. */
class Color is Coloring {
  init(r, g, b) {
    self.r = r
    self.g = g
    self.b = b
    self.a = 1
  }
  init(r, g, b, a) {
    self.r = r
    self.g = g
    self.b = b
    self.a = a
  }

  /** Coerce a length-3/4 sequence into the canonical inits.
   *  Matrix uses column-major single-index access, so the same path works. */
  _initSeq(seq) {
    var n = seq.count()
    if (n == 3) { self.init(seq[0], seq[1], seq[2]); return }
    if (n == 4) { self.init(seq[0], seq[1], seq[2], seq[3]); return }
    _ClrBadInitErr.throw()
  }
  init(List col) { self._initSeq(col) }
  init(Tuple col) { self._initSeq(col) }
  init(Matrix col) { self._initSeq(col) }
  init(x) { _ClrBadInitErr.throw() }

  red(x) { return self.r }
  green(x) { return self.g }
  blue(x) { return self.b }
  alpha(x) { return self.a }
  rgb(x) { return (self.r, self.g, self.b) }
  rgba(x) { return (self.r, self.g, self.b, self.a) }

  /* Binary ops: Morpho routes +/−/× via add, sub, mul/mulr.
   * addr/subr omitted — only Color±Color is supported (left always handles it). */
  add(Color other) {
    return Color(self.r+other.r, self.g+other.g, self.b+other.b, self.a+other.a)
  }

  sub(Color other) {
    return Color(self.r-other.r, self.g-other.g, self.b-other.b, self.a-other.a)
  }

  mul(Color other) {
    return Color(self.r*other.r, self.g*other.g, self.b*other.b, self.a*other.a)
  }
  mul(t) { // scalar × channels (Color * t)
    return Color(t*self.r, t*self.g, t*self.b, t*self.a)
  }
  mulr(t) { return self.mul(t) } // t * Color

  scale(t) { return self.mul(t) }

  blend(Color other, t) {
    return (1-t)*self + t*other
  }
}

// Some predefined colors
var Red = Color(1,0,0)
var Green = Color(0,1,0)
var Blue = Color(0,0,1)
var White = Color(1,1,1)
var Black = Color(0,0,0)
var Cyan = Color(0,1,1)
var Magenta = Color(1,0,1)
var Yellow = Color(1,1,0)
var Brown = Color(0.6,0.4,0.2)
var Orange = Color(1,0.5,0)
var Pink = Color(1,0.5,0.5) 
var Purple = Color(0.5,0,0.5)

fn Gray(x) {
  return Color(x, x, x)
}

fn Gray(x, a) {
  return Color(x, x, x, a)
}

/** Hue Saturation Value constructors: Hue is in degrees (h) and (s, v) 0–1 -> Color. */
fn HSV(h, s, v) {
  return HSV(h, s, v, 1)
}

fn HSV(h, s, v, a) {
  var hh = h - 360*floor(h/360) // [0, 360)
  var c = v*s
  var sector = Int(hh/60)
  var f = hh/60 - Float(sector)
  var x = c*(1 - abs(2*f - 1))
  var m = v - c
  var rgb = [
    [c, x, 0], [x, c, 0], [0, c, x],
    [0, x, c], [x, 0, c], [c, 0, x]
  ]
  var t = rgb[sector]
  return Color(t[0]+m, t[1]+m, t[2]+m, a)
}

/** Linear blend in RGBA; t=0 → c1, t=1 → c2. */
fn Blend(Color c1, Color c2, t) {
  return c1.blend(c2, t)
}

/* Parametric maps — produce a color given a value in [0,1] */

class ColorMap is Coloring {
  init() { }
  /** Sample map at x ∈ [0,1] as a fixed Color (for arithmetic / display). */
  color(x) { return Color(self.red(x), self.green(x), self.blue(x)) }
}

class GradientMap is ColorMap {
  red(x) { return 0.29+0.04*x+0.66*x^2 }
  green(x) { return 0.33+0.42*x+0.24*x^2 }
  blue(x) { return 0.46-0.55*x+x^2 }
}

class GrayMap is ColorMap {
  red(x) { return x }
  green(x) { return x }
  blue(x) { return x }
}

class HueMap is ColorMap {
  red(x) { return (sin(2*Pi*(x+1/4))+1)/2 }
  green(x) { return (sin(2*Pi*x)+1)/2 }
  blue(x) { return (sin(2*Pi*(x-0.4))+1)/2 }
}

/* Color maps expanded onto Chebyshev polynomials */

var _errChebyShevOrderInconsistent = Error("ClrChbyshvOrdr", "Order of Chebyshev approximation inconsistent.") 

class ChebyshevMap is ColorMap {
  init(R,G,B) {
    self.R = R 
    self.G = G
    self.B = B
    self.order = R.count() 
    if (G.count()!=self.order || B.count()!=self.order) _errChebyShevOrderInconsistent.throw()  
  }

  _chebyshev(t) {
    var n = self.order
    var c[n]
    c[0]=1
    c[1]=t
    for (var i=2; i<n; i+=1) c[i]=2*t*c[i-1]-c[i-2]
    return c 
  } 

  _component(x, table) {
    var r=0
    var c = self._chebyshev(2*x-1)
    for (var i=0; i<self.order; i+=1) r+=c[i]*table[i]
    return r
  }

  red(x) { return self._component(x, self.R) }
  green(x) { return self._component(x, self.G) }
  blue(x) { return self._component(x, self.B) }

  rgb(x) { 
    var r=0,g=0,b=0
    var c = self._chebyshev(2*x-1)
  
    for (var i=0; i<self.order; i+=1) {
      r+=c[i]*self.R[i]
      g+=c[i]*self.G[i]
      b+=c[i]*self.B[i]
    }

    return (r,g,b)
  }
}

/* Colormaps corresponding to the MPL colormaps:
   http://bids.github.io/colormap/ 
   Here approximated by an expension in Chebyshev polynomials */

