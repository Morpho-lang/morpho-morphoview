/* Graphics / Scene / Show
 *
 * History:
 * 1/7/25 Redirect error output to /dev/null to suppress errors on macOS
 * 1/2/26 Windows compatibility
 * 7/31/26 Additional features to support new morphoview:
 * - PointCloud / LineSet primitives
 * - display() creates GraphicsEntry, enabling pose information to be decoupled from the item
 * - Show can now clear display list
 * - Scene is Graphics with Broadcaster (move / recolor)
 * Live View sessions live in morphoview.morpho (Listener over ZMQ).
 * Sphere tessellation is a cached UV sphere (no meshtools).
 */

import constants
import xcolor
import broadcast

var _eps = 1e-15
var _defaultRgb = (0.5, 0.5, 0.5)
var _fntntfnd = Error("FntNtFnd", "Font not found.")
var _txtdrnvrtprll = Error("TxtDrnVrtPrll", "Direction and vertical must not be parallel or zero.")
// [Compatibility shim]
var _GfxLegacyTransp = Error("GfxLegacyTransp",
  "filter=/transmit= map to Color.a. Prefer Color(..., a) or Coloring.opacity(a).")
var _warnedLegacyTransp = false
var _GfxXnca = Error("GfxXnca",
  "ColorTable per-element alpha is dropped until the viewer supports xnca.")
var _warnedXnca = false

/* **************************************
 * Utility functions
 **************************************** */

/** Constructs a rotation matrix
  @param[in] theta - rotation angle
  @param[in] axis - axis to rotate about
  @returns the rotation matrix  */
fn _rotation(theta, axis) {
  var x = axis[0], y=axis[1], z=axis[2]
  var ctheta = cos(theta), stheta = sin(theta), cc=1-ctheta

  return Matrix(
  [[x*x*cc+ctheta,   x*y*cc-z*stheta, x*z*cc+y*stheta],
   [x*y*cc+z*stheta, y*y*cc+ctheta,   y*z*cc-x*stheta],
   [z*x*cc-y*stheta, y*z*cc+x*stheta, z*z*cc+ctheta ]]
  )
}

/** Generates a vector normal to a given vector but of arbitrary orientation */
fn _normalVector(vec) {
  var order = [abs(vec[0]), abs(vec[1]), abs(vec[2])].order()
  var out=vec.clone()
  out[order[0]]=0
  out[order[1]]=vec[order[2]]
  out[order[2]]=-vec[order[1]]
  return out
}

/* 3d cross product */
fn _cross3D(a, b) {
  return Matrix([ a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0] ])
}

/* Gram-Schmidt orthonormalization */
fn _orthogonalize(m) { 
  var ncols=m.dimensions()[1]
  for (i in 0...ncols) {
    var x = m.column(i)
    for (j in 0...i) {
      var y = m.column(j)
      x -= x.inner(y)*y
    }
    var nrm = x.norm() 
    if (nrm<_eps) _txtdrnvrtprll.throw() 
    x/=nrm
    m.setcolumn(i, x)
  }
}

/** Coerce list or Matrix to a stored position Matrix (3-vector). nil → origin. */
fn _asPosition(p) {
  if (isnil(p)) return Matrix([0, 0, 0])
  if (ismatrix(p)) return p.clone()
  return Matrix(p)
}

/** Coerce scale: nil → 1; scalar; or 3-vector Matrix (non-uniform). */
fn _asScale(s) {
  if (isnil(s)) return 1
  if (ismatrix(s)) return s.clone()
  if (islist(s)) return Matrix(s)
  return s
}

/** Scalar radius for sphere refine / mesh keys (max |component| if Matrix/list). */
fn _effectiveRadius(scale) {
  if (isnil(scale)) return 1
  if (ismatrix(scale) || islist(scale)) {
    var m = abs(scale[0])
    var a1 = abs(scale[1]), a2 = abs(scale[2])
    if (a1 > m) m = a1
    if (a2 > m) m = a2
    return m
  }
  return scale
}

/** Angle-axis (phi, ax, ay, az) rotating unit @p from onto unit @p to.
 *  Aligned → (0, 1, 0, 0) (so move can clear a prior tilt). */
fn _axisAngleFromTo(from, to) {
  var d = from.inner(to)
  if (d > 1 - 1e-8) return (0, 1, 0, 0)
  if (d < -1 + 1e-8) {
    var ax = _normalVector(from)
    var n = ax.norm()
    if (n < _eps) ax = Matrix([1, 0, 0])
    else ax = ax/n
    return (Pi, ax[0], ax[1], ax[2])
  }
  var axis = _cross3D(from, to)
  axis = axis/axis.norm()
  var phi = acos(d)
  return (phi, axis[0], axis[1], axis[2])
}

/** start→end + aspectratio → (position, scale Matrix(R,R,L), rotate); nil if degenerate.
 *  Unit shaft is +z, height 1, radius 1; world radius = 0.5 * length * aspectratio. */
fn segmentSRT(start, end, aspectratio) {
  var x1 = _asPosition(start)
  var x2 = _asPosition(end)
  var dx = x2 - x1
  var length = dx.norm()
  if (!(length > 1e-8)) return nil
  var R = 0.5*length*aspectratio
  var rotate = _axisAngleFromTo(Matrix([0, 0, 1]), dx/length)
  return (x1, Matrix([R, R, length]), rotate)
}

fn _asColoring(Coloring c) { return c }
fn _asColoring(c) { return asColoring(c) }

// [Compatibility shim] Old Show formula: alpha = 1 − clamp(filter + transmit, 0, 1).
fn _legacyAlpha(filter, transmit) {
  var s = (isnil(filter) ? 0 : filter) + (isnil(transmit) ? 0 : transmit)
  if (s <= 0) return 1
  if (s >= 1) return 0
  return 1 - s
}

fn _warnLegacyTransp() {
  if (_warnedLegacyTransp) return
  _warnedLegacyTransp = true
  _GfxLegacyTransp.warning("Deprecated filter=/transmit=. Use Color(..., a) or Coloring.opacity(a).")
}

fn _withLegacyTransp(color, filter, transmit) {
  if (isnil(filter) && isnil(transmit)) return color
  _warnLegacyTransp()
  var a = _legacyAlpha(filter, transmit)
  if (isnil(color)) return Gray(0.5).opacity(a)
  return asColoring(color).opacity(a)
}

// [Compatibility shim] Public name so xplot veneers can call this across modules.
fn withLegacyTransp(color, filter, transmit) {
  return _withLegacyTransp(color, filter, transmit)
}

/* **************************************
 * Graphics primitives
 **************************************** */

/** Shared albedo for every displayable item. Transparency is Color.a / Coloring. */
class GraphicsPrimitive {
  init(color=nil, filter=nil, transmit=nil) {
    self.color = _asColoring(_withLegacyTransp(color, filter, transmit))
  }

  toTriangleComplex() { return nil }
}

/** TriangleComplexes are a basic graphical unit that draw a set of triangles
   from a given set of vertices. */
class TriangleComplex is GraphicsPrimitive {
  init(position, normals, color, connectivity, filter=nil, transmit=nil) {
    super.init(color=color, filter=filter, transmit=transmit) // [Compatibility shim]
    self.position = position /* Vertex position matrix */
    self.normals = normals /* Matrix of normal vectors */
    self.connectivity = connectivity /* Connectivity matrix; columns are triangles */
  }
}


/** Draws a cylinder
  @param[in] start - start point
  @param[in] end - end point
  @param[in] aspectratio - aspect ratio
  @param[in] n - number of faces to use
  @param[in] color - Color of the cylinder */
class Cylinder is GraphicsPrimitive {
  init(start, end, aspectratio=0.1, n=10, color=nil, filter=nil, transmit=nil) {
    super.init(color=color, filter=filter, transmit=transmit) // [Compatibility shim]
    self.start = Matrix(start)
    self.end = Matrix(end)
    self.aspectratio = aspectratio
    self.n = n
  }

  /** @param unit if true, shaft along +z height 1 radius 1 (pose on Graphics entry). */
  toTriangleComplex(unit=false) {
    var aspectratio = self.aspectratio
    var n = self.n

    var col = self.color
    if (isnil(col)) col = _defaultRgb

    var np=2*n+2 // 2 points at the end plus 2*n point
    var nt=4*n
    var dim=3
    var vertices=Matrix(dim, np)
    var normals=Matrix(dim, np)

    var x1, x2, dx, length, ndx, px
    if (unit) {
      x1 = Matrix([0, 0, 0])
      x2 = Matrix([0, 0, 1])
      dx = Matrix([0, 0, 1])
      length = 1
      ndx = dx
      px = Matrix([1, 0, 0])
    } else {
      x1=self.start
      x2=self.end
      dim=x1.count()
      vertices=Matrix(dim, np)
      normals=Matrix(dim, np)
      dx=x2-x1 // Vector from x1 to x2
      length = dx.norm()
      if (abs(length)<1e-8) return nil
      ndx=dx/length
      px=_normalVector(dx)
      var pxnorm=px.norm()
      if (abs(pxnorm)<1e-15) return nil
      px=0.5*length*aspectratio*px/pxnorm
    }

    // Head and base of the arrow
    vertices.setcolumn(0, x1)
    vertices.setcolumn(np-1, x2)
    normals.setcolumn(0, -1*dx)
    normals.setcolumn(np-1, dx)

    /* The cylinder is structured like so:

           [n+1...2n]
                      \
    [1..n] A------------B
           |            |
           0            1 2n+1
           <---- dx ----> */
    // Unit +z shaft: ring offsets without 3×3 rotation matrices (mesh-cache hot path).
    if (unit) {
      for (i in 1..n) {
        var theta = 2*Pi*(i-1)/n
        var qx = Matrix([cos(theta), sin(theta), 0])
        var pt = qx+x1
        vertices.setcolumn(i, pt)
        vertices.setcolumn(n+i, pt+dx)
        normals.setcolumn(i, qx)
        normals.setcolumn(n+i, qx)
      }
    } else {
      for (i in 1..n) {
        var theta = 2*Pi*(i-1)/n
        var qx = _rotation(theta, ndx)*px
        var nn=qx/qx.norm()
        var pt = qx+x1
        vertices.setcolumn(i, pt)
        vertices.setcolumn(n+i, pt+dx)
        normals.setcolumn(i, nn)
        normals.setcolumn(n+i, nn)
      }
    }

    var conn=Sparse(np,nt)
    for (i in 0...n) {
      // Layer 0-A
      conn[0,i]=1
      conn[i+1,i]=1
      if (i<n-1) conn[i+2,i]=1 else conn[1,i]=1

      // C-1
      conn[np-1,n+i]=1
      conn[n+i+1,n+i]=1
      if (i<n-1) conn[n+i+2,n+i]=1 else conn[n+1,n+i]=1

      // Layer A-B
      conn[i+1,2*n+i]=1
      conn[n+i+1,2*n+i]=1
      if (i<n-1) conn[i+2,2*n+i]=1 else conn[1,2*n+i]=1

      if (i<n-1) conn[i+2,3*n+i]=1 else conn[1,3*n+i]=1
      if (i<n-1) conn[n+i+2,3*n+i]=1 else conn[n+1,3*n+i]=1
      conn[n+i+1,3*n+i]=1
    }

      return TriangleComplex(vertices, normals, col, conn)
  }

}

/* Unit UV-sphere by level (cached). No meshtools. */

var _sphereCache = Dictionary() // level → [verts, faces]

/** Vertex index: poles are 0 / nv-1; else ring i∈1…st−1, slot j. */
fn _sphereIx(i, j, st, sl, nv) {
  if (i == 0) return 0
  if (i == st) return nv - 1
  return 1 + (i - 1) * sl + j
}

/** UV sphere: st / sl grow with level. Single north/south pole verts. */
fn _uvSphere(level) {
  if (_sphereCache.contains(level)) return _sphereCache[level]
  var st = 6 + 4 * level, sl = 10 + 6 * level, nv = 2 + (st - 1) * sl
  var v = Matrix(3, nv), tris = []
  var dphi = Pi / st, dth = 2 * Pi / sl
  for (phi, i in 0..Pi:dphi) {
    var sp = sin(phi), cp = cos(phi)
    for (th, j in 0..(2 * Pi - dth):dth) {
      if (i == 0 || i == st) {
        if (j == 0) v.setcolumn(_sphereIx(i, j, st, sl, nv), Matrix([0, 0, cp]))
      } else {
        v.setcolumn(_sphereIx(i, j, st, sl, nv), Matrix([sp * cos(th), sp * sin(th), cp]))
      }
      if (i < st) {
        var jn = mod(j + 1, sl)
        var a = _sphereIx(i, j, st, sl, nv), b = _sphereIx(i, jn, st, sl, nv)
        var c = _sphereIx(i + 1, j, st, sl, nv), d = _sphereIx(i + 1, jn, st, sl, nv)
        if (a == b || c == d) tris.append(a == b ? [a, c, d] : [a, c, b])
        else { tris.append([a, c, b]); tris.append([b, c, d]) }
      }
    }
  }
  var f = Sparse(nv, tris.count())
  for (tri, i in tris) { for (p in tri) f[p, i] = 1 }
  for (tri, i in tris) f.setrowindices(i, tri)
  _sphereCache[level] = [v, f]
  return _sphereCache[level]
}

/** Draws a sphere */
class Sphere is GraphicsPrimitive {
  init(center, r, color=nil, maxrefine=3, filter=nil, transmit=nil) {
    super.init(color=color, filter=filter, transmit=transmit) // [Compatibility shim]
    self.center = center
    self.r = r
    self.maxrefine = maxrefine
  }

  _refinementLevel() { return self._refinementLevel(self.r) }

  /** Level from effective display radius (entry.scale for unit spheres). */
  _refinementLevel(effectiveradius) {
    var n = 0, r = _effectiveRadius(effectiveradius)
    while (r / (2^n) > 0.1 && n < self.maxrefine) n += 1
    return n
  }

  /** @param scale false → unit ball at origin. @param radiusforrefine picks tessellation. */
  toTriangleComplex(scale=true, radiusforrefine=nil) {
    var col = isnil(self.color) ? _defaultRgb : self.color
    var mesh = _uvSphere(self._refinementLevel(isnil(radiusforrefine) ? self.r : radiusforrefine))
    var unit = mesh[0], v = unit.clone(), nv = v.dimensions()[1]
    var x0 = islist(self.center) ? Matrix(self.center) : self.center
    var r = scale ? self.r : 1
    if (!scale) x0 = Matrix([0, 0, 0])
    for (i in 0...nv) v.setcolumn(i, x0 + r * unit.column(i))
    return TriangleComplex(v, unit.clone(), col, mesh[1].clone())
  }
}

/** Draws an arrow
  @param[in] start - start point
  @param[in] end - end point
  @param[in] aspectratio - aspect ratio of the arrow
  @param[in] n - number of faces to use
  @param[in] color - Color of the arrow */
class Arrow is GraphicsPrimitive {
  init(start, end, aspectratio=0.1, n=10, color=nil, filter=nil, transmit=nil) {
    super.init(color=color, filter=filter, transmit=transmit) // [Compatibility shim]
    self.start = Matrix(start)
    self.end = Matrix(end)
    self.aspectratio = aspectratio
    self.n = n
  }

  /** @param unit if true, shaft along +z height 1 radius 1; tip fraction = aspectratio. */
  toTriangleComplex(unit=false) {
    var aspectratio = self.aspectratio
    var n = self.n

    var col = self.color
    if (isnil(col)) col = _defaultRgb

    var np=3*n+2 // 2 points at the end plus 3*n point
    var nt=6*n
    var dim=3
    var vertices=Matrix(dim, np)
    var normals=Matrix(dim, np)

    var x1, x2, dx, length, ndx, px
    if (unit) {
      x1 = Matrix([0, 0, 0])
      x2 = Matrix([0, 0, 1])
      dx = Matrix([0, 0, 1])
      length = 1
      ndx = dx
      px = Matrix([1, 0, 0])
    } else {
      x1=self.start
      x2=self.end
      dim=x1.count()
      vertices=Matrix(dim, np)
      normals=Matrix(dim, np)
      dx=x2-x1 // Vector from x1 to x2
      length = dx.norm()
      if (abs(length)<1e-8) return nil
      ndx=dx/length
      px=_normalVector(dx)
      var pxnorm=px.norm()
      if (abs(pxnorm)<1e-15) return nil
      px=0.5*length*aspectratio*px/pxnorm
    }

    // Head and base of the arrow
    vertices.setcolumn(0, x1)
    vertices.setcolumn(np-1, x2)
    normals.setcolumn(0, -1*dx)
    normals.setcolumn(np-1, dx)

    /* The arrow is structured like so:

           [n+1...2n]   C--[2n+1...3n]
                      \ |\
    [1..n] A------------B \
           |               \
           0<----- u --->   1 3n+1
           <------ dx ------> */
    var u=(1-aspectratio)*dx
    if (unit) {
      for (i in 1..n) {
        var theta = 2*Pi*(i-1)/n
        var qx = Matrix([cos(theta), sin(theta), 0])
        var pt = qx+x1
        vertices.setcolumn(i, pt)
        vertices.setcolumn(n+i, pt+u)
        vertices.setcolumn(2*n+i, pt+u+qx)
        normals.setcolumn(i, qx)
        normals.setcolumn(n+i, qx)
        normals.setcolumn(2*n+i, qx)
      }
    } else {
      for (i in 1..n) {
        var theta = 2*Pi*(i-1)/n
        var qx = _rotation(theta, ndx)*px
        var nn=qx/qx.norm()
        var pt = qx+x1
        vertices.setcolumn(i, pt)
        vertices.setcolumn(n+i, pt+u)
        vertices.setcolumn(2*n+i, pt+u+qx)
        normals.setcolumn(i, nn)
        normals.setcolumn(n+i, nn)
        normals.setcolumn(2*n+i, nn)
      }
    }

    var conn=Sparse(np,nt)
    for (i in 0...n) {
      // Layer 0-A
      conn[0,i]=1
      conn[i+1,i]=1
      if (i<n-1) conn[i+2,i]=1 else conn[1,i]=1

      // C-1
      conn[np-1,n+i]=1
      conn[2*n+i+1,n+i]=1
      if (i<n-1) conn[2*n+i+2,n+i]=1 else conn[2*n+1,n+i]=1

      // Layer A-B
      conn[i+1,2*n+i]=1
      conn[n+i+1,2*n+i]=1
      if (i<n-1) conn[i+2,2*n+i]=1 else conn[1,2*n+i]=1

      if (i<n-1) conn[i+2,3*n+i]=1 else conn[1,3*n+i]=1
      if (i<n-1) conn[n+i+2,3*n+i]=1 else conn[n+1,3*n+i]=1
      conn[n+i+1,3*n+i]=1

      // Layer B-C
      conn[n+i+1,4*n+i]=1
      if (i<n-1) conn[n+i+2,4*n+i]=1 else conn[n+1,4*n+i]=1
      conn[2*n+i+1,4*n+i]=1

      if (i<n-1) conn[n+i+2,5*n+i]=1 else conn[n+1,5*n+i]=1
      if (i<n-1) conn[2*n+i+2,5*n+i]=1 else conn[2*n+1,5*n+i]=1
      conn[2*n+i+1,5*n+i]=1
    }

    return TriangleComplex(vertices, normals, col, conn)
  }

}

/** Draws a tube
  @param[in] pts - list of points or a matrix with points as the columns
  @param[in] rad - radius
  @param[in] n - number of faces to use per point
  @param[in] closed - whether to treat the point list as closed or not
  @param[in] color - Color of the tube */
class Tube is GraphicsPrimitive {
  _shaftNormal(vec) { // no abs — unlike module _normalVector
    var order = [vec[0], vec[1], vec[2]].order()
    var out=vec.clone()
    out[order[0]]=0
    out[order[1]]=vec[order[2]]
    out[order[2]]=-vec[order[1]]
    return out
  }

  init(pts, rad, n=10, color=nil, closed=false, filter=nil, transmit=nil) {
    super.init(color=color, filter=filter, transmit=transmit) // [Compatibility shim]
    self.pts = pts
    self.radius = rad
    self.n = n
    self.closed = closed
  }

  toTriangleComplex() {
    var n = self.n
    var col = self.color
    if (isnil(col)) col = _defaultRgb

    var mat = self.pts
    if (islist(self.pts)) mat = Matrix(self.pts).transpose();

    var np=mat.dimensions()[1]
    if (np < 2) return nil
    var dim=mat.dimensions()[0]
    var nv=n*np
    var nt=n*(2*(np-1))
    if (!self.closed) {
      nv+=2 // Two points for the caps
      nt+=2*n // n triangles for each cap
    }

    var vertices=Matrix(dim, nv);
    var normals=Matrix(dim, nv);

    var sep[np], ndx[np]

    // Loop over line segments to calculate separation vectors
    for (k in 0..np-2) {
      var dx=mat.column(k+1)-mat.column(k)
      var dlen=dx.norm()
      if (!(dlen > 1e-8)) return nil
      sep[k]=dx/dlen
      ndx[k]+=sep[k]
      ndx[k+1]+=sep[k]
    }

    // Correct ends if closed
    if (self.closed) {
      var dx=mat.column(0)-mat.column(np-1)
      var dlen=dx.norm()
      if (!(dlen > 1e-8)) return nil
      sep[np-1]=dx/dlen
      ndx[np-1]+=sep[np-1]
      ndx[0]+=sep[np-1]
    }

    // Now generate vertices
    for (k in 0...np) {
      var px // Vertices are generated from a point plus this displacement
      if (k==0) {
        px=self._shaftNormal(ndx[k])
      } else { // This aligns vertices generated from successive points
        var dx=vertices.column((k-1)*n)-mat.column(k-1)
        px=dx-dx.inner(ndx[k])*ndx[k]/ndx[k].norm()
      }
      px=self.radius*px/px.norm()

      var x1 = mat.column(k)
      var axis = ndx[k]
      for (i in 0...n) {
        /* Find vertex ring at point k by rotating px about ndx, to obtain qx, and then adding x1 */
        var theta = i*2*Pi/n
        var qx = _rotation(theta, axis)*px
        vertices.setcolumn(k*n+i, x1+qx)

        normals.setcolumn(k*n+i, qx/qx.norm())
      }
    }

    /* Loop over segments again to create the triangles */
    var conn=Sparse(nv,nt)

    var m=0
    for (k in 0..np-2) {
      for (i in 0...n) {
        conn[k*n+i,m]=1
        if (i==n-1) conn[k*n,m]=1 else conn[k*n+i+1,m]=1
        conn[((k+1)*n+i),m]=1
        m+=1
        if (i==n-1) conn[k*n,m]=1 else conn[k*n+i+1,m]=1
        if (i==n-1) conn[(k+1)*n,m]=1 else conn[((k+1)*n+i)+1,m]=1
        conn[((k+1)*n+i),m]=1
        m+=1
      }
    }

    if (self.closed) {
      // Connect first and last points
      var k=np-1
      for (i in 0...n) {
        conn[k*n+i,m]=1
        if (i==n-1) conn[k*n,m]=1 else conn[k*n+i+1,m]=1
        conn[i,m]=1
        m+=1
        if (i==n-1) conn[k*n,m]=1 else conn[k*n+i+1,m]=1
        if (i==n-1) conn[0,m]=1 else conn[i+1,m]=1
        conn[i,m]=1
        m+=1
      }
    } else {
      // End caps
      vertices.setcolumn(nv-2, mat.column(0))
      vertices.setcolumn(nv-1, mat.column(np-1))

      normals.setcolumn(nv-2, -sep[0]/sep[0].norm())
      normals.setcolumn(nv-1, sep[np-2]/sep[np-2].norm())

      for (i in 0...n) {
        conn[i,m]=1
        if (i==n-1) conn[0,m]=1 else conn[i+1,m]=1
        conn[nv-2,m]=1
        m+=1
        conn[((np-1)*n+i),m]=1
        if (i==n-1) conn[(np-1)*n,m]=1 else conn[((np-1)*n+i)+1,m]=1
        conn[nv-1,m]=1
        m+=1
      }
    }

    return TriangleComplex(vertices, normals, col, conn)
  }

}

/* **************************************
 * Text
 **************************************** */

class Text is GraphicsPrimitive {
  init(string, posn, dirn=nil, vertical=nil, size=10, font=nil, color=nil, filter=nil, transmit=nil) {
    super.init(color=color, filter=filter, transmit=transmit) // [Compatibility shim]
    self.posn = posn
    if (islist(self.posn)) self.posn = Matrix(self.posn)

    self.dirn = dirn // Direction of flow for the text 
    if (islist(self.dirn)) self.dirn = Matrix(self.dirn)

    self.vertical = vertical // Vertical direction
    if (islist(self.vertical)) self.vertical = Matrix(self.vertical)
    
    self.string = string 
    self.font = font
    self.size = size 
  }

  transformationMatrix() {
    if (!(ismatrix(self.dirn) || ismatrix(self.vertical))) return nil 
    var m = Matrix(4,4) 
    for (i in 0..3) m[i,i]=1

    if (!isnil(self.dirn)) for (i in 0..2) m[i,0]=self.dirn[i]
    if (!isnil(self.vertical)) for (i in 0..2) m[i,1]=self.vertical[i]

    // Now set the final direction to the cross product of the two 
    var zp = _cross3D(m.column(1),m.column(0)) 
    for (i in 0..2) m[i,2]=zp[i]

    _orthogonalize(m)

    return m.transpose() 
  }

}

/** Copy Text with origin posn — pose lives on the GraphicsEntry (Phase 5f). */
fn _textAtOrigin(Text item) {
  return Text(item.string, [0, 0, 0], dirn=item.dirn, vertical=item.vertical,
              size=item.size, font=item.font, color=item.color)
}

class Font {
  init (name, size, id=nil) {
    self.name = name 
    self.size = size 
    self.id = id
  }
}

/* **************************************
 * Point and line primitives (viewer `p` / `l`)
 **************************************** */

/** Normalize inputs to a dim×n vertex matrix (points as columns). */
fn _asVertexMatrix(Matrix pts) { return pts }

fn _asVertexMatrix(pts) { // list of points
  return Matrix(pts).transpose()
}

/** Point cloud — positions as Matrix columns (or list of points).
  Optional uniform or per-vertex `color`. Emits viewer points (`p`), not spheres. */
class PointCloud is GraphicsPrimitive {
  init(position, color=nil) {
    super.init(color=color)
    self.position = _asVertexMatrix(position)
  }
}

/** Line set — vertices plus segments.
  @param position - Matrix columns (or list of points)
  @param connectivity - Sparse/Matrix with two vertices per column, or list of [i,j] pairs.
    Omit for a polyline through successive vertices (use `closed=true` to loop).
  Color and flags are keyword args (Morpho optionals are not positional). */
class LineSet is GraphicsPrimitive {
  // Polyline through successive vertices
  init(position, color=nil, closed=false) {
    super.init(color=color)
    self.position = _asVertexMatrix(position)
    self.connectivity = nil
    self.closed = closed
  }

  // Explicit segments
  init(position, connectivity, color=nil, closed=false) {
    super.init(color=color)
    self.position = _asVertexMatrix(position)
    self.connectivity = connectivity
    self.closed = closed
  }

  /** Flat index list for GL_LINES: i0 j0 i1 j1 ... */
  _segmentIndices() {
    var nv = self.position.dimensions()[1]
    var conn = self.connectivity
    var out = []

    if (isnil(conn)) {
      var nseg = self.closed ? nv : nv - 1
      if (nseg < 1) return out
      for (i in 0...nseg) {
        out.append(i)
        out.append(mod(i + 1, nv))
      }
      return out
    }

    if (islist(conn)) {
      for (seg in conn) {
        out.append(seg[0])
        out.append(seg[1])
      }
      return out
    }

    // Sparse or dense incidence matrix: columns are segments
    var nf = conn.dimensions()[1]
    for (i in 0...nf) {
      if (issparse(conn)) {
        var indx = conn.rowindices(i)
        for (j in 0...indx.count()) out.append(indx[j])
      } else {
        var nvf = conn.dimensions()[0]
        for (j in 0...nvf) {
          if (conn[j, i] != 0) out.append(j)
        }
      }
    }
    return out
  }

}

/* **************************************
 * Graphics class
 **************************************** */

/** One placed item in a Graphics: stable id + item + presentation SRT. */
class GraphicsEntry {
  init(id, item, position=nil, scale=nil, rotate=nil, color=nil) {
    self.id = id
    self.item = item
    self.position = _asPosition(position)
    self.scale = _asScale(scale)
    self.rotate = rotate
    self.color = _asColoring(color) // presentation albedo (Sphere / recolor); nil → item
    self.flat = false              // unlit draw (set true for solid facet colors)
  }

  /** Axis-angle rotate → 3×3; nil if identity / missing. */
  rotationMatrix() {
    var r = self.rotate
    if (isnil(r) || abs(r[0]) < 1e-8) return nil
    return _rotation(r[0], [r[1], r[2], r[3]])
  }
}

/** Events from Scene (Broadcaster). Typed subclasses enable multiple dispatch.
 *  Named GraphicsEvent* for continuity with the Graphics entry model. */
class GraphicsEvent with BroadcastEvent {
  init(id) {
    self.id = id
  }
}

class GraphicsEventDefined is GraphicsEvent {}

/** Merge `into.ids` into `prev`'s accumulating list (first-seen order, deduped).
 *  O(|into.ids|) per call via prev._seen — not a full rebuild. */
fn _coalesceIds(into, prev) {
  if (isnil(prev._seen)) {
    prev._seen = Dictionary()
    for (id in prev.ids) prev._seen[id] = true
  }
  for (id in into.ids) {
    if (!prev._seen.contains(id)) {
      prev._seen[id] = true
      prev.ids.append(id)
    }
  }
  into.ids = prev.ids
  into._seen = prev._seen
}

/** Coalesces within a Broadcaster batch; `ids` accumulates every mover. */
class GraphicsEventMoved is GraphicsEvent {
  init(id) {
    super.init(id)
    self.ids = [id]
    self._seen = nil // filled on first coalesce
  }
  batchKey() { return GraphicsEventMoved }
  coalesce(prev) { _coalesceIds(self, prev) }
}

/** Coalesces within a Broadcaster batch; `ids` accumulates every recolor target. */
class GraphicsEventRecolored is GraphicsEvent {
  init(id) {
    super.init(id)
    self.ids = [id]
    self._seen = nil
  }
  batchKey() { return GraphicsEventRecolored }
  coalesce(prev) { _coalesceIds(self, prev) }
}

/** Entry removed from Scene (no coalesce — each id flushed). */
class GraphicsEventRemoved is GraphicsEvent {}

/** Entry item replaced (no coalesce — each id flushed). */
class GraphicsEventReplaced is GraphicsEvent {}

/** Unit Sphere for entry storage (pose lives on the GraphicsEntry). */
fn _unitSphere(Sphere item) {
  return Sphere([0, 0, 0], 1, color=item.color, maxrefine=item.maxrefine)
}

/** Unit Cylinder for entry storage (pose lives on the GraphicsEntry). */
fn _unitCylinder(Cylinder item) {
  return Cylinder([0, 0, 0], [0, 0, 1], aspectratio=item.aspectratio, n=item.n,
                  color=item.color)
}

/** Unit Arrow for entry storage (pose lives on the GraphicsEntry). */
fn _unitArrow(Arrow item) {
  return Arrow([0, 0, 0], [0, 0, 1], aspectratio=item.aspectratio, n=item.n,
               color=item.color)
}

/** Show mesh-cache key for a unit primitive (entry.scale used by Sphere refine). */
fn _meshKey(Sphere item, entry) {
  return "sphere:${item._refinementLevel(_effectiveRadius(entry.scale))}"
}
fn _meshKey(Cylinder item, entry) { return "cylinder:${item.n}" }
fn _meshKey(Arrow item, entry) { return "arrow:${item.n}:${item.aspectratio}" }

/** Unit TriangleComplex for a cached mesh define. */
fn _unitTri(Sphere item, entry) {
  return item.toTriangleComplex(scale=false, radiusforrefine=_effectiveRadius(entry.scale))
}
fn _unitTri(Cylinder item, entry) { return item.toTriangleComplex(unit=true) }
fn _unitTri(Arrow item, entry) { return item.toTriangleComplex(unit=true) }

/** Static displaylist container. Accepted by Show / View.open / View.update.
 *  For live mutation (move / recolor / batch) use Scene. */
class Graphics {
  init(title = nil, background = nil) {
    self.displaylist = [] // GraphicsEntry list
    self._entryById = Dictionary()
    self._nextId = 1
    self.title = title
    if (!self.title) self.title="Morpho" // Title to show
    self.background = isnil(background) ? Black : _asColoring(background)
    if (isnil(self.background)) self.background = Black
  }

  /** Look up an entry by Graphics-owned id; nil if missing. */
  findEntry(id) {
    if (!self._entryById.contains(id)) return nil
    return self._entryById[id]
  }

  /** Allocate id and append a GraphicsEntry; returns the id. No events. */
  _append(item, position=nil, scale=nil, rotate=nil, color=nil, flat=nil) {
    var id = self._nextId
    self._nextId += 1
    var e = GraphicsEntry(id, item, position=position, scale=scale,
                          rotate=rotate, color=color)
    if (!isnil(flat)) e.flat = flat
    self.displaylist.append(e)
    self._entryById[id] = e
    return id
  }

  /** Copy this displaylist into @p g (same ids); does not remap right-hand entries. */
  _copyEntriesInto(g) {
    for (el in self.displaylist) {
      var e = GraphicsEntry(el.id, el.item, position=el.position, scale=el.scale,
                            rotate=el.rotate, color=el.color)
      e.flat = el.flat
      g.displaylist.append(e)
      g._entryById[e.id] = e
    }
  }

  /** Unit item + explicit pose (color defaults to item.color). */
  _displayUnit(unitItem, position, scale=nil, rotate=nil, color=nil, flat=nil) {
    var scl = isnil(scale) ? 1 : scale
    var col = isnil(color) ? unitItem.color : color
    return self._append(unitItem, position=position, scale=scl, rotate=rotate,
                        color=col, flat=flat)
  }

  /** Unit shaft item + SRT from start→end; nil if degenerate. */
  _displaySegment(unitItem, start, end, aspectratio, color=nil, flat=nil) {
    var srt = segmentSRT(start, end, aspectratio)
    if (isnil(srt)) return nil
    return self._displayUnit(unitItem, srt[0], scale=srt[1], rotate=srt[2],
                             color=color, flat=flat)
  }

  /** Append a GraphicsPrimitive (identity SRT). Returns Graphics-owned id. */
  display(GraphicsPrimitive item, color=nil, flat=nil) {
    return self._append(item, color=color, flat=flat)
  }

  /** GraphicsPrimitive with pose: 2nd positional position + scale=/rotate=/color=/flat=. */
  display(GraphicsPrimitive item, position, scale=nil, rotate=nil, color=nil, flat=nil) {
    return self._append(item, position=position, scale=scale, rotate=rotate,
                        color=color, flat=flat)
  }

  /** Unit Sphere + entry SRT from authored center/r. */
  display(Sphere item, color=nil, flat=nil) {
    return self._displayUnit(_unitSphere(item), item.center, scale=item.r,
                             color=color, flat=flat)
  }

  /** Unit Sphere + pose args on the entry (sole pose authority). */
  display(Sphere item, position, scale=nil, rotate=nil, color=nil, flat=nil) {
    return self._displayUnit(_unitSphere(item), position, scale=scale, rotate=rotate,
                             color=color, flat=flat)
  }

  /** Unit Cylinder + entry SRT from authored start→end. */
  display(Cylinder item, color=nil, flat=nil) {
    return self._displaySegment(_unitCylinder(item), item.start, item.end,
                                item.aspectratio, color=color, flat=flat)
  }

  /** Unit Cylinder + pose args on the entry (sole pose authority). */
  display(Cylinder item, position, scale=nil, rotate=nil, color=nil, flat=nil) {
    return self._displayUnit(_unitCylinder(item), position, scale=scale, rotate=rotate,
                             color=color, flat=flat)
  }

  /** Unit Arrow + entry SRT from authored start→end. */
  display(Arrow item, color=nil, flat=nil) {
    return self._displaySegment(_unitArrow(item), item.start, item.end,
                                item.aspectratio, color=color, flat=flat)
  }

  /** Unit Arrow + pose args on the entry (sole pose authority). */
  display(Arrow item, position, scale=nil, rotate=nil, color=nil, flat=nil) {
    return self._displayUnit(_unitArrow(item), position, scale=scale, rotate=rotate,
                             color=color, flat=flat)
  }

  /** Text: lift authored posn onto the entry; item kept at origin. */
  display(Text item, color=nil, flat=nil) {
    var col = isnil(color) ? item.color : color
    return self._append(_textAtOrigin(item), position=item.posn, color=col, flat=flat)
  }

  /** Text + explicit pose on the entry (sole pose authority for move). */
  display(Text item, position, scale=nil, rotate=nil, color=nil, flat=nil) {
    var col = isnil(color) ? item.color : color
    return self._append(_textAtOrigin(item), position=position, scale=scale,
                        rotate=rotate, color=col, flat=flat)
  }

  /** PointCloud defaults to unlit (entry.flat). */
  display(PointCloud item, color=nil, flat=nil) {
    return self._append(item, color=color, flat=isnil(flat) ? true : flat)
  }
  display(PointCloud item, position, scale=nil, rotate=nil, color=nil, flat=nil) {
    return self._append(item, position=position, scale=scale, rotate=rotate,
                        color=color, flat=isnil(flat) ? true : flat)
  }

  /** LineSet defaults to unlit (entry.flat). */
  display(LineSet item, color=nil, flat=nil) {
    return self._append(item, color=color, flat=isnil(flat) ? true : flat)
  }
  display(LineSet item, position, scale=nil, rotate=nil, color=nil, flat=nil) {
    return self._append(item, position=position, scale=scale, rotate=rotate,
                        color=color, flat=isnil(flat) ? true : flat)
  }

  /** Union of two Graphics. Left-hand ids kept; right-hand ids remapped unique in the result.
   *  Entry records are copied (item refs shared); no Defined notifications. */
  add(Graphics right) {
    var g = Graphics()
    g.title = self.title
    g.background = self.background
    g._nextId = self._nextId
    self._copyEntriesInto(g)
    for (el in right.displaylist) {
      g._append(el.item, position=el.position, scale=el.scale, rotate=el.rotate,
                color=el.color, flat=el.flat)
    }
    return g
  }

  /** In-place union (`+=`); also Morpho's right-hand `+` fallback. */
  addr(Graphics right) {
    for (el in right.displaylist) {
      self._append(el.item, position=el.position, scale=el.scale, rotate=el.rotate,
                   color=el.color, flat=el.flat)
    }
    return self
  }
}

/** Live Graphics: Broadcaster + move / recolor / remove / replace / morph / batch.
 *  Call _broadcasterInit from Scene.init (mixins do not auto-init state). */
class Scene is Graphics with Broadcaster {
  init(title = nil, background = nil) {
    super.init(title=title, background=background)
    self._broadcasterInit()
  }

  /** Allocate id, append entry, optionally notify Defined. */
  _append(item, position=nil, scale=nil, rotate=nil, color=nil, flat=nil, notify=true) {
    var id = super._append(item, position=position, scale=scale, rotate=rotate,
                           color=color, flat=flat)
    if (notify) self.notify(GraphicsEventDefined(id))
    return id
  }

  /** Update scale=/rotate= only; omitted kwargs leave that component unchanged. */
  move(id, scale=nil, rotate=nil) {
    var e = self.findEntry(id)
    if (isnil(e)) return false
    if (!isnil(scale)) e.scale = _asScale(scale)
    if (!isnil(rotate)) e.rotate = rotate
    self.notify(GraphicsEventMoved(id))
    return true
  }

  /** Set position (always); scale=/rotate= only when provided. */
  move(id, position, scale=nil, rotate=nil) {
    var e = self.findEntry(id)
    if (isnil(e)) return false
    e.position = _asPosition(position)
    if (!isnil(scale)) e.scale = _asScale(scale)
    if (!isnil(rotate)) e.rotate = rotate
    self.notify(GraphicsEventMoved(id))
    return true
  }

  /** Set presentation color for an entry (viewer slot albedo via `C`). */
  recolor(id, color) {
    var e = self.findEntry(id)
    if (isnil(e)) return false
    e.color = _asColoring(color)
    self.notify(GraphicsEventRecolored(id))
    return true
  }

  /** Remove an entry by Graphics-owned id; notifies Removed. */
  remove(id) {
    var e = self.findEntry(id)
    if (isnil(e)) return false
    self.displaylist.remove(e)
    self._entryById.remove(id)
    self.notify(GraphicsEventRemoved(id))
    return true
  }

  /** Replace entry item; SRT unchanged. Full redefine in the viewer (not same-length U V). */
  replace(id, GraphicsPrimitive item) {
    var e = self.findEntry(id)
    if (isnil(e)) return false
    e.item = item
    self.notify(GraphicsEventReplaced(id))
    return true
  }

  /** Store unit item on entry; keep SRT; copy item.color if entry has none. */
  _replaceUnit(id, unitItem) {
    var e = self.findEntry(id)
    if (isnil(e)) return false
    e.item = unitItem
    if (isnil(e.color)) e.color = unitItem.color
    self.notify(GraphicsEventReplaced(id))
    return true
  }

  replace(id, Sphere item) { return self._replaceUnit(id, _unitSphere(item)) }
  replace(id, Cylinder item) { return self._replaceUnit(id, _unitCylinder(item)) }
  replace(id, Arrow item) { return self._replaceUnit(id, _unitArrow(item)) }

  /** Replace Text content/orientation; entry SRT unchanged (string/font via redefine). */
  replace(id, Text item) {
    var e = self.findEntry(id)
    if (isnil(e)) return false
    e.item = _textAtOrigin(item)
    if (isnil(e.color)) e.color = item.color
    self.notify(GraphicsEventReplaced(id))
    return true
  }

  /** Same-length mesh swap: set entry.item only. Pair with View.refreshMesh or View.morph.
   *  Connectivity changes need replace. */
  morph(id, GraphicsPrimitive item) {
    var e = self.findEntry(id)
    if (isnil(e)) return false
    e.item = item
    return true
  }

  morph(id, item) { return false }

  replace(id, item) { return false }

  /** Union as Scene. Entry copies; no Defined notifications. */
  add(Graphics right) {
    var g = Scene()
    g.title = self.title
    g.background = self.background
    g._nextId = self._nextId
    self._copyEntriesInto(g)
    for (el in right.displaylist) {
      g._append(el.item, position=el.position, scale=el.scale, rotate=el.rotate,
                color=el.color, flat=el.flat, notify=false)
    }
    return g
  }
}

/* **************************************
 * Resolve morphoview executable (Show launch + View spawn)
 **************************************** */

var _mvbin = nil
var _mvpmold = Error("MvPmOld", "morphopm is too old (unrecognized path command); please upgrade morphopm.")

fn findMorphoViewBin() {
  if (!isnil(_mvbin)) return _mvbin

  var exe = (System.platform()=="windows" ? "morphoview.exe" : "morphoview")
  var roots = []
  var haspm = System.subprocess(System.platform()=="windows" ? "where morphopm" : "command -v morphopm")

  if (haspm["exitstatus"]==0) {
    var line = System.subprocess("morphopm path morphoview")["stdout"].split("\n")[0]
    var parts = line.split("'")
    var code = (parts.count()>1) ? parts[1] : ""
    if (code == "ErrMorphoPMUnrcgnzd") _mvpmold.throw()
    /* Only trust morphopm when it prints a real directory; otherwise fall through
     * (NotInst, empty/stderr-only output, stale path, other errors). */
    if (line.count()>0 && Folder.isFolder(line)) roots.append(line)
  }

  /* No usable morphopm path — scan ~/.morphopackages (dev checkout). */
  if (roots.count()==0 && Folder.contents(System.homefolder()).contains(".morphopackages")) {
    for (p in File(Folder.normalizePath("${System.homefolder()}/.morphopackages")).lines()) {
      if (p.split("/\\").contains("morpho-morphoview")) roots.append(p)
    }
  }

  for (root in roots) {
    var bindir = Folder.normalizePath("${root}/bin")
    if (root.count()>0 && Folder.isFolder(bindir) && Folder.contents(bindir).contains(exe)) {
      _mvbin = Folder.normalizePath("${bindir}/${exe}")
      return _mvbin
    }
  }

  // [Compatibility shim] Old Show launched a bare `morphoview` on PATH.
  _mvbin = "morphoview"
  return _mvbin
}

/** Resolve font files and common font roles across platforms.
 *  Returns a font *name* for `Text(..., font=...)`, or nil → Show default. */
class FontFinder {
  init() { }

  folders() {
    var platform = System.platform()
    if (platform=="macos") return ["/System/Library/Fonts"]
    if (platform=="windows") return [Folder.normalizePath("C:/Windows/Fonts")]
    return ["/usr/share/fonts", "/usr/local/share/fonts"]
  }

  match(file, font) {
    var parts = file.split(".")
    var n = parts.count()
    if (n < 2) return false
    var ext = parts[n-1]
    var base = file.substring(0, file.count() - ext.count() - 1)
    return base==font && (ext=="ttc" || ext=="ttf")
  }

  search(folder, font) {
    if (!Folder.isFolder(folder)) return nil
    for (f in Folder.contents(folder)) {
      var path = Folder.normalizePath("${folder}/${f}")
      if (self.match(f, font)) return path
      if (Folder.isFolder(path)) {
        var nested = self.search(path, font)
        if (nested) return nested
      }
    }
    return nil
  }

  /** Filesystem path for a font name, or nil. */
  find(font) {
    for (folder in self.folders()) {
      var found = self.search(folder, font)
      if (found) return found
    }
    return nil
  }

  /** First candidate that resolves on this machine, else nil. */
  pick(candidates) {
    for (name in candidates) {
      if (self.find(name)) return name
    }
    return nil
  }

  /** Platform default body face (Helvetica / arial / FreeSans). */
  default() {
    var platform = System.platform()
    var candidates
    if (platform=="macos") {
      candidates = ["Helvetica", "Arial", "DejaVuSans", "FreeSans"]
    } else if (platform=="windows") {
      candidates = ["arial", "segoeui", "calibri", "tahoma"]
    } else {
      candidates = ["DejaVuSans", "FreeSans", "LiberationSans", "NimbusSans-Regular", "Ubuntu-R"]
    }
    var name = self.pick(candidates)
    return isnil(name) ? candidates[0] : name
  }

  /** Math / emoji / symbol coverage when available. */
  symbol() {
    return self.pick(["Apple Symbols", "seguisym", "DejaVuSans", "FreeSans", "Symbola"])
  }

  /** CJK body face when available. */
  cjk() {
    return self.pick(["Hiragino Sans GB", "msyh", "NotoSansCJK-Regular", "NotoSansCJKjp-Regular", "TakaoPGothic"])
  }
}

/* **************************************
 * Show a graphics object
 *
 *  - `Show()`     — serializer only (uid / font / color state)
 *  - `Show(g)`    — fire-and-forget (temp file + morphoview -t)
 *  - `show.write(g, out)` — emit ASCII commands to any `out.write(...)` sink
 **************************************** */

class Show {
  // Serializer only — use write(g, out) with any write-able sink.
  init() {
    self.uidInit()
    self.fonts = []
    self.colors = Dictionary()
    self.sceneId = 1
    self.replace = false
    self.objectMap = Dictionary()    // graphicsId → viewer object id
    self.entryColorId = Dictionary() // graphicsId → color id when draw needs `C`
    self.flatIds = Dictionary()      // graphicsId → true if draw needs `M flat`
    self.textIds = Dictionary()      // graphicsId → true if TEXT draw-slot (no `X O`)
    self.vertexLayout = Dictionary() // graphicsId → "xn" | "xnc" (TriangleComplex)
    self.meshCache = Dictionary()    // mesh key → viewer object id (shared geometry)
    self._lastColorId = nil
    self._lastVertexLayout = nil
  }

  // Fire-and-forget: temp file + morphoview -t.
  init(g) {
    self.init()
    self._launch(g)
  }

  /** Fire-and-forget: temp file + morphoview -t (viewer unlinks the file on exit). */
  _launch(g) {
    var isWindows = System.platform()=="windows"
    // Build with /; Folder.normalizePath rewrites separators for the platform.
    var tempFolder = isWindows ?
      "${System.homefolder()}/AppData/Local/Temp" : "/tmp"
    var fname = self._randomAlphanumString(10)
    var path = Folder.normalizePath("${tempFolder}/morpho${fname}.draw")
    var out = File(path, "w")
    var bin = findMorphoViewBin()

    self.write(g, out)

    out.close()

    if (isWindows) {
      system("powershell -Command \"Start-Process '${bin}' -ArgumentList '-t', '${path}'\"")
    } else {
      // 1/7/25 Redirect error output to /dev/null
      system("\"${bin}\" -t \"${path}\" > /dev/null 2>&1 &")
    }
  }

  /** Generate a random name */
  _randomAlphanumString(n) {
    var alpha="abcdefghijklmnopqrstuvwxyz0123456789"
    var name=""
    var nalpha = alpha.count()
    for (i in 1..n) {
      var k = Int(random()*nalpha)
      if (k >= nalpha) k = nalpha-1
      name+=alpha[k]
    }
    return name
  }

  uidInit() {
    self.uid = 0
  }

  uid() { // Generate unique identifiers
    self.uid+=1
    return self.uid
  }

  preamble(graphic, out) {
    if (self.replace) {
      out.write("U S ${self.sceneId}")
    } else {
      out.write("S ${self.sceneId} 3")
      out.write("W \"${graphic.title}\"")
    }
    var bg = graphic.background.rgb(0)
    out.write("G ${self.fmt(bg[0])} ${self.fmt(bg[1])} ${self.fmt(bg[2])}")
  }

  // 3 significant figures — enough for display; keeps ASCII small vs full doubles.
  // Morpho requires a width field (`%.3g` is rejected); use 0 to avoid padding spaces.
  // Coerce via Float: Matrix/Color often yield Ints, and Int.format rejects %g.
  fmt(x) {
    return Float(x).format("%0.3g")
  }

  /* Bake via item.toTriangleComplex(). Separate from visit(entry, item) so typed
   * overloads can fall back without recursing into themselves. */
  visitGeneric(entry, item, out) {
    var tri = item.toTriangleComplex()
    if (isnil(tri)) return // e.g. zero-length Cylinder/Arrow
    self.visit(entry, tri, out)
  }

  visit(entry, GraphicsPrimitive item, out) {
    self.visitGeneric(entry, item, out)
  }

  /** Emit entry i / s / r (no translation, no draw). */
  _emitEntryBasis(entry, out) {
    out.write("i")
    var scl = entry.scale
    if (ismatrix(scl) || islist(scl)) {
      out.write("s ${self.fmt(scl[0])} ${self.fmt(scl[1])} ${self.fmt(scl[2])}")
    } else if (scl != 1) {
      out.write("s ${self.fmt(scl)}")
    }
    if (!isnil(entry.rotate)) {
      var r = entry.rotate
      if (!(abs(r[0]) < 1e-8)) {
        out.write("r ${self.fmt(r[0])} ${self.fmt(r[1])} ${self.fmt(r[2])} ${self.fmt(r[3])}")
      }
    }
  }

  /** Emit entry t when position is not the origin. */
  _emitEntryTranslation(entry, out) {
    var p = entry.position
    if (!(p[0] == 0 && p[1] == 0 && p[2] == 0)) {
      out.write("t ${self.fmt(p[0])} ${self.fmt(p[1])} ${self.fmt(p[2])}")
    }
  }

  /** Emit entry SRT as i / s / r / t (no draw command). */
  _emitEntrySRT(entry, out) {
    self._emitEntryBasis(entry, out)
    self._emitEntryTranslation(entry, out)
  }

  /** Emit i/s/r/t/d. With viewerid: d <graphicsId> <viewerid> (or d <viewerid> if entry.id==0).
   *  Without viewerid: d <graphicsId> (pose-only). */
  emitEntryDraw(entry, out, viewerid=nil) {
    self._emitEntrySRT(entry, out)
    if (isnil(viewerid)) {
      out.write("d ${entry.id}")
    } else if (entry.id != 0) {
      out.write("d ${entry.id} ${viewerid}")
    } else {
      out.write("d ${viewerid}")
    }
  }

  /** Record graphicsId → viewer id (and optional draw color / flat shade / layout). */
  _recordObject(entry, viewerid, colorid=nil, flat=false) {
    if (isnil(entry) || entry.id == 0) return
    self.objectMap[entry.id] = viewerid
    if (!isnil(colorid)) self.entryColorId[entry.id] = colorid
    if (flat) self.flatIds[entry.id] = true
    if (!isnil(self._lastVertexLayout)) {
      self.vertexLayout[entry.id] = self._lastVertexLayout
    }
  }

  /** Record a TEXT draw-slot (objectMap sentinel = graphicsId; never emit `X O`). */
  _recordText(entry, colorid=nil) {
    if (isnil(entry) || entry.id == 0) return
    self.objectMap[entry.id] = entry.id
    self.textIds[entry.id] = true
    if (!isnil(colorid)) self.entryColorId[entry.id] = colorid
  }

  /** Re-issue draws for all mapped entries after `D` (entry SRT).
   *  TEXT slots need a full `T` redefine (string is not recoverable from `d`). */
  emitPoseDraws(graphic, out) {
    for (entry in graphic.displaylist) {
      if (!self.objectMap.contains(entry.id)) continue
      if (self.textIds.contains(entry.id)) {
        self.writeEntry(entry, out)
        continue
      }
      var vid = self.objectMap[entry.id]
      var needFlat = self.flatIds.contains(entry.id)
      if (needFlat) out.write("M flat")
      if (self.entryColorId.contains(entry.id)) {
        out.write("C ${self.entryColorId[entry.id]}")
      }
      self.emitEntryDraw(entry, out, viewerid=vid)
      if (needFlat) out.write("M shaded")
    }
  }

  /** Pose-only draw for one graphics id (no C/M — for in-place `d` update after open). */
  emitEntryPose(graphic, graphicsId, out) {
    if (!self.objectMap.contains(graphicsId)) return false
    var entry = graphic.findEntry(graphicsId)
    if (isnil(entry)) return false
    if (self.textIds.contains(graphicsId)) {
      self._emitTextTransforms(entry, entry.item, out)
      out.write("d ${graphicsId}")
      return true
    }
    self.emitEntryDraw(entry, out)
    return true
  }

  /** Presentation RGB for an entry (entry.color, else typed item albedo). */
  entryRgb(entry) {
    if (!isnil(entry.color)) return self._rgbValue(entry.color)
    return self._itemRgb(entry.item)
  }

  /** Item albedo by concrete type (closed display-item set → multiple dispatch). */
  _itemRgb(GraphicsPrimitive item) { return self._rgbValue(item.color) }
  _itemRgb(item) { return _defaultRgb }

  _perElement(ColorTable col) { return col.count() > 1 }
  _perElement(Coloring col) { return false }
  _perElement(col) { return false }

  // [Compatibility shim]
  _warnDroppedVertexAlpha(ColorTable col) {
    if (col.channels() < 4) return
    if (_warnedXnca) return
    _warnedXnca = true
    _GfxXnca.warning("ColorTable per-element alpha is not sent to the viewer yet (no xnca). Use uniform Color.a.")
  }
  _warnDroppedVertexAlpha(col) { }

  _rgbValue(Coloring col) { return col.rgb(0) }
  _rgbValue(col) { return _defaultRgb }

  /** Recolor: ensure `c`/`C`, then `d <graphicsId>` with no transforms (matrix preserved). */
  emitEntryRecolor(graphic, graphicsId, out) {
    if (!self.objectMap.contains(graphicsId)) return false
    var entry = graphic.findEntry(graphicsId)
    if (isnil(entry)) return false
    var cid = self.addRgb(self.entryRgb(entry), self.opacity(entry), out)
    self.entryColorId[graphicsId] = cid
    out.write("C ${cid}")
    out.write("d ${graphicsId}")
    return true
  }

  /** How many Graphics entries map to this viewer object id. */
  objectUserCount(viewerid) {
    var n = 0
    for (gid in self.objectMap) {
      if (self.objectMap[gid] == viewerid) n += 1
    }
    return n
  }

  /** Drop Show maps for one Graphics entry id. */
  forgetEntry(graphicsId) {
    if (self.objectMap.contains(graphicsId)) self.objectMap.remove(graphicsId)
    if (self.entryColorId.contains(graphicsId)) self.entryColorId.remove(graphicsId)
    if (self.flatIds.contains(graphicsId)) self.flatIds.remove(graphicsId)
    if (self.textIds.contains(graphicsId)) self.textIds.remove(graphicsId)
    if (self.vertexLayout.contains(graphicsId)) self.vertexLayout.remove(graphicsId)
  }

  /** Drop meshCache keys that point at @p viewerid. */
  _forgetMeshCacheFor(viewerid) {
    var drop = []
    for (key in self.meshCache) {
      if (self.meshCache[key] == viewerid) drop.append(key)
    }
    for (key in drop) self.meshCache.remove(key)
  }

  /** Emit `X D` (+ `X O` if last user of a shared mesh object). Text never emits `X O`. */
  emitEntryRemove(graphicsId, out) {
    var isText = self.textIds.contains(graphicsId)
    if (!self.objectMap.contains(graphicsId)) {
      out.write("X D ${graphicsId}")
      return true
    }
    var vid = self.objectMap[graphicsId]
    out.write("X D ${graphicsId}")
    self.forgetEntry(graphicsId)
    if (!isText && self.objectUserCount(vid) == 0) {
      out.write("X O ${vid}")
      self._forgetMeshCacheFor(vid)
    }
    return true
  }

  /** Redefine a replaced entry: reuse shared Sphere `o` when possible; else remove + writeEntry. */
  emitEntryReplace(graphic, graphicsId, out) {
    var entry = graphic.findEntry(graphicsId)
    if (isnil(entry)) return false
    return self._emitReplace(entry, entry.item, out)
  }

  /** Reuse cached unit `o` when key still matches; else remove + rewrite. */
  _emitCachedReplace(entry, item, key, out) {
    var graphicsId = entry.id
    var oldVid = self.objectMap.contains(graphicsId) ? self.objectMap[graphicsId] : nil
    if (!isnil(oldVid) && self.meshCache.contains(key) && self.meshCache[key] == oldVid) {
      var cid = self.addRgb(self.entryRgb(entry), self.opacity(entry), out)
      self.entryColorId[graphicsId] = cid
      out.write("C ${cid}")
      self.emitEntryDraw(entry, out, viewerid=oldVid)
      return true
    }
    self.emitEntryRemove(graphicsId, out)
    self.writeEntry(entry, out)
    return true
  }

  _emitReplace(entry, Sphere item, out) {
    return self._emitCachedReplace(entry, item, _meshKey(item, entry), out)
  }
  _emitReplace(entry, Cylinder item, out) {
    return self._emitCachedReplace(entry, item, _meshKey(item, entry), out)
  }
  _emitReplace(entry, Arrow item, out) {
    return self._emitCachedReplace(entry, item, _meshKey(item, entry), out)
  }

  /** Unique mesh: drop old draw/object, then define+draw fresh. */
  _emitReplace(entry, item, out) {
    self.emitEntryRemove(entry.id, out)
    self.writeEntry(entry, out)
    return true
  }

  /** Same-length vertex replace for a mapped TriangleComplex (`U V`).
   *  Float layout must match define (`xn` vs `xnc`); returns false if unmapped,
   *  wrong type, or layout unknown (never emit a length the viewer will drop). */
  emitEntryVertices(graphic, graphicsId, out) {
    if (!self.objectMap.contains(graphicsId)) return false
    var entry = graphic.findEntry(graphicsId)
    if (isnil(entry)) return false
    return self._emitVertices(entry, entry.item, out)
  }

  _emitVertices(entry, TriangleComplex item, out) {
    if (!self.vertexLayout.contains(entry.id)) return false
    var layout = self.vertexLayout[entry.id]
    var vid = self.objectMap[entry.id]
    out.write("U V ${vid}")
    if (layout == "xnc") {
      self._triangleComplexVertexFloats(item, out, includecolor=true)
    } else if (layout == "xn") {
      self._triangleComplexVertexFloats(item, out, includecolor=false)
    } else {
      return false
    }
    return true
  }

  _emitVertices(entry, item, out) {
    return false
  }

  /** Alpha from Coloring. ColorTable is per-element; do not collapse on first-vertex alpha. */
  _clamp01(a) { return (a < 0) ? 0 : ((a > 1) ? 1 : a) }

  _colorAlpha(ColorTable col) { return 1 }
  _colorAlpha(Coloring col) { return self._clamp01(col.alpha(0)) }
  _colorAlpha(col) { return 1 }

  /** Item color field (GraphicsPrimitive.color). */
  _itemColor(GraphicsPrimitive item) { return item.color }
  _itemColor(item) { return nil }

  /** Presentation / item Color.a (entry.color wins over item color). */
  opacity(GraphicsEntry entry) {
    if (!isnil(entry.color)) return self._colorAlpha(entry.color)
    return self._colorAlpha(self._itemColor(entry.item))
  }

  /** Uniform RGB for a TriangleComplex (first vertex if per-vertex colors). */
  uniformRgb(item) {
    return self._rgbValue(item.color)
  }

  /** Emit `c` for rgb[+alpha]; returns color id. Alpha < ~1 → RGBA. */
  addRgb(rgb, alpha, out) {
    var r = self.fmt(rgb[0])
    var g = self.fmt(rgb[1])
    var b = self.fmt(rgb[2])
    var a = self.fmt(alpha)
    var key = "${r} ${g} ${b} ${a}"
    if (!self.colors.contains(key)) {
      var id = self.colors[key] = self.colors.count()
      out.write(alpha < 0.999 ?
                "c ${id} ${r} ${g} ${b} ${a}" :
                "c ${id} ${r} ${g} ${b}")
    }
    return self.colors[key]
  }

  triangleComplexObjectData(item, out, includecolor=true) {
    if (includecolor) {
      out.write("v \"xnc\"")
    } else {
      out.write("v \"xn\"")
    }
    self._triangleComplexVertexFloats(item, out, includecolor=includecolor)

    out.write("f")
    var f=item.connectivity
    var nf=f.dimensions()[1]

    for (i in 0...nf) {
      var line = ""
      // Sparse connectivity preserves face winding via rowindices (cf. povray Show).
      // Dense Matrix incidence only stores membership — fall back to ascending ids.
      if (issparse(f)) {
        var indx = f.rowindices(i)
        for (j in 0...indx.count()) line+="${indx[j]} "
      } else {
        var nvf=f.dimensions()[0]
        for (j in 0...nvf) {
          if (f[j,i]!=0) line+="${j} "
        }
      }
      out.write(line)
    }
  }

  /** Position + normal [+ RGB] float rows only (shared by define `v` and `U V`).
   *  ColorTable per-element alpha is dropped until viewer xnca. */
  _triangleComplexVertexFloats(item, out, includecolor=true) {
    var x = item.position
    var n = item.normals
    var col = item.color
    var indexed = self._perElement(col)
    var rgb = indexed ? nil : self._rgbValue(col)
    var dimensions = x.dimensions()
    var dim = dimensions[0]
    var nv = dimensions[1]

    for (i in 0...nv) {
      var line = ""
      for (j in 0...dim) line += "${self.fmt(x[j,i])} "
      for (j in 0...dim) line += "${self.fmt(n[j,i])} "
      if (includecolor) {
        var c = indexed ? col.rgb(i) : rgb
        line += "${self.fmt(c[0])} ${self.fmt(c[1])} ${self.fmt(c[2])} "
      }
      out.write(line)
    }
  }

  /** Define a TriangleComplex with `v "xn"` only (no vertex colors); returns viewer id.
   *  Does not emit `C` — caller stamps color for the draw slot. */
  defineXnTriangleComplex(item, out) {
    var id = self.uid()
    self._lastVertexLayout = "xn"
    out.write("o ${id}")
    self.triangleComplexObjectData(item, out, includecolor=false)
    return id
  }

  /** Define a TriangleComplex (`o`/`v`/`f`, optional `C`); returns viewer object id.
   *  Sets `self._lastColorId` when a uniform `C` is selected (else nil).
   *  Sets `self._lastVertexLayout` to `"xn"` (translucent) or `"xnc"` (opaque).
   *  ColorTable meshes stay `"xnc"` (per-vertex RGB; alpha deferred). */
  defineTriangleComplex(entry, item, out) {
    var id = self.uid()
    var indexed = isnil(entry.color) && self._perElement(item.color)
    self._warnDroppedVertexAlpha(item.color)
    var alpha = indexed ? 1 : self.opacity(entry)
    self._lastColorId = nil
    if (alpha < 0.999) {
      var cid = self.addRgb(self.uniformRgb(item), alpha, out)
      self._lastColorId = cid
      self._lastVertexLayout = "xn"
      out.write("C ${cid}")
      out.write("o ${id}")
      self.triangleComplexObjectData(item, out, includecolor=false)
    } else {
      self._lastVertexLayout = "xnc"
      out.write("o ${id}")
      self.triangleComplexObjectData(item, out)
    }
    return id
  }

  /** Uniform RGB for PointCloud / LineSet color field. */
  pointLineRgb(item) {
    return self._rgbValue(item.color)
  }

  /** Emit vertex positions (+ optional per-vertex RGB) for points/lines. */
  pointLineVertexData(item, out, includecolor=true) {
    var x = item.position
    var col = item.color
    var indexed = self._perElement(col)
    var rgb = indexed ? nil : self._rgbValue(col)
    var dimensions = x.dimensions()
    var dim = dimensions[0]
    var nv = dimensions[1]

    if (includecolor) {
      out.write("v \"xc\"")
    } else {
      out.write("v \"x\"")
    }

    for (i in 0...nv) {
      var line = ""
      for (j in 0...dim) line += "${self.fmt(x[j,i])} "
      if (includecolor) {
        var c = indexed ? col.rgb(i) : rgb
        line += "${self.fmt(c[0])} ${self.fmt(c[1])} ${self.fmt(c[2])} "
      }
      out.write(line)
    }
  }

  /** Define PointCloud geometry (`o`/`v`/`p`); sets `_lastColorId`. Returns viewer id or nil. */
  definePointCloud(entry, item, out) {
    var id = self.uid()
    var indexed = isnil(entry.color) && self._perElement(item.color)
    self._warnDroppedVertexAlpha(item.color)
    var alpha = indexed ? 1 : self.opacity(entry)
    var nv = item.position.dimensions()[1]
    if (nv < 1) return nil
    self._lastColorId = nil
    var cid = nil
    if (alpha < 0.999) {
      cid = self.addRgb(self.pointLineRgb(item), alpha, out)
      self._lastColorId = cid
      out.write("C ${cid}")
      out.write("o ${id}")
      self.pointLineVertexData(item, out, includecolor=false)
    } else {
      out.write("o ${id}")
      self.pointLineVertexData(item, out, includecolor=true)
    }
    var pline = "p"
    for (i in 0...nv) pline += " ${i}"
    out.write(pline)
    return id
  }

  /** Define LineSet geometry (`o`/`v`/`l`); sets `_lastColorId`. Returns viewer id or nil. */
  defineLineSet(entry, item, out) {
    var id = self.uid()
    var indexed = isnil(entry.color) && self._perElement(item.color)
    self._warnDroppedVertexAlpha(item.color)
    var alpha = indexed ? 1 : self.opacity(entry)
    var nv = item.position.dimensions()[1]
    var segs = item._segmentIndices()
    if (nv < 1 || segs.count() < 2) return nil
    self._lastColorId = nil
    var cid = nil
    if (alpha < 0.999) {
      cid = self.addRgb(self.pointLineRgb(item), alpha, out)
      self._lastColorId = cid
      out.write("C ${cid}")
      out.write("o ${id}")
      self.pointLineVertexData(item, out, includecolor=false)
    } else {
      out.write("o ${id}")
      self.pointLineVertexData(item, out, includecolor=true)
    }
    var lline = "l"
    for (i in 0...segs.count()) lline += " ${segs[i]}"
    out.write(lline)
    return id
  }

  findFont(font) { return FontFinder().find(font) }
  defaultFontName() { return FontFinder().default() }

  addFont(font, size, out) {
    var path = self.findFont(font)
    if (!path) _fntntfnd.throw()
    var id = self.uid()
    var fnt = Font(font, size, id=id)
    self.fonts.append(fnt)

    out.write("F ${id} \"${path}\" ${size}")
    return id
  }

  findFontId(font, size, out) {
    for (f in self.fonts) {
      if (f.name == font && f.size == size) return f.id
    }
    return self.addFont(font, size, out)
  }

  /** Entry SRT (+ optional dirn/vertical `m` before translation) before `T` / pose `d`. */
  _emitTextTransforms(entry, Text item, out) {
    self._emitEntryBasis(entry, out)
    var m = item.transformationMatrix()
    if (!isnil(m)) {
      var str = "m"
      for (i in 0..3) for (j in 0..3) str+=" "+self.fmt(m[i,j])
      out.write(str)
    }
    self._emitEntryTranslation(entry, out)
  }

  write(graphic, out) {
    self.preamble(graphic, out)
    self.objectMap = Dictionary()
    self.entryColorId = Dictionary()
    self.flatIds = Dictionary()
    self.textIds = Dictionary()
    self.vertexLayout = Dictionary()
    self.meshCache = Dictionary()

    for (entry in graphic.displaylist) {
      self.visit(entry, entry.item, out)
    }
  }

  /** Define + draw a single entry (mid-session `defined`); updates object maps. */
  writeEntry(entry, out) {
    self.visit(entry, entry.item, out)
  }

  /** Text draw-slot: entry pose + `T <entryId> <fontId> "…"`. */
  visit(entry, Text item, out) {
    var font = item.font
    if (!font) font = self.defaultFontName()
    var fid = self.findFontId(font, item.size, out)
    var cid = self.addRgb(self.entryRgb(entry), self.opacity(entry), out)
    out.write("C ${cid}")
    self._emitTextTransforms(entry, item, out)
    out.write("T ${entry.id} ${fid} \"${item.string}\"")
    self._recordText(entry, colorid=cid)
  }

  /** Unit mesh from cache + entry SRT + `C` (Sphere / Cylinder / Arrow). */
  _visitUnitMesh(entry, item, out) {
    var key = _meshKey(item, entry)
    var vid
    if (self.meshCache.contains(key)) {
      vid = self.meshCache[key]
    } else {
      var tri = _unitTri(item, entry)
      if (isnil(tri)) return
      vid = self.defineXnTriangleComplex(tri, out)
      self.meshCache[key] = vid
    }
    var cid = self.addRgb(self.entryRgb(entry), self.opacity(entry), out)
    out.write("C ${cid}")
    self._recordObject(entry, vid, colorid=cid)
    self.emitEntryDraw(entry, out, viewerid=vid)
  }

  visit(entry, Sphere item, out) { self._visitUnitMesh(entry, item, out) }
  visit(entry, Cylinder item, out) { self._visitUnitMesh(entry, item, out) }
  visit(entry, Arrow item, out) { self._visitUnitMesh(entry, item, out) }

  /** PointCloud: define once, draw with entry SRT. Obeys entry.flat. */
  visit(entry, PointCloud item, out) {
    var flat = entry.flat
    if (flat) out.write("M flat")
    var vid = self.definePointCloud(entry, item, out)
    if (!isnil(vid)) {
      self._recordObject(entry, vid, colorid=self._lastColorId, flat=flat)
      self.emitEntryDraw(entry, out, viewerid=vid)
    }
    if (flat) out.write("M shaded")
  }

  /** LineSet: define once, draw with entry SRT. Obeys entry.flat. */
  visit(entry, LineSet item, out) {
    var flat = entry.flat
    if (flat) out.write("M flat")
    var vid = self.defineLineSet(entry, item, out)
    if (!isnil(vid)) {
      self._recordObject(entry, vid, colorid=self._lastColorId, flat=flat)
      self.emitEntryDraw(entry, out, viewerid=vid)
    }
    if (flat) out.write("M shaded")
  }

  /** TriangleComplex: define once for this write, draw with entry SRT.
   *  Pass `flat=true` on `display` (or set `entry.flat`) for unlit solid facet colors. */
  visit(entry, TriangleComplex item, out) {
    var flat = entry.flat
    if (flat) out.write("M flat")
    var vid = self.defineTriangleComplex(entry, item, out)
    self._recordObject(entry, vid, colorid=self._lastColorId, flat=flat)
    self.emitEntryDraw(entry, out, viewerid=vid)
    if (flat) out.write("M shaded")
  }
}
