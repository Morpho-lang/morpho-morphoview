/* Graphics
 *
 * History:
 * 1/7/25 Redirect error output to /dev/null to suppress errors on macOS
 * 1/2/26 Windows compatibility
 * 7/31/26 Additional features to support new morphoview: 
 * - View class to enable communication between the viewer and the application
 * - PointCloud / LineSet primitives
 * - display() creates GraphicsEntry, enabling pose information to be decoupled from the item
 * - Show can now clear display list
 * - Scene is Graphics with Broadcaster (move / recolor); View is Listener
 */

import constants
import meshtools
import color
import broadcast

var _eps = 1e-15
var _fntntfnd = Error("FntNtFnd", "Font not found.")
var _txtdrnvrtprll = Error("TxtDrnVrtPrll", "Direction and vertical must not be parallel or zero.")

/* **************************************
 * Utility functions
 **************************************** */

/** Constructs a rotation matrix
  @param[in] theta - rotation angle
  @param[in] axis - axis to rotate about
  @returns the rotation matrix  */
fn _rotation(theta, axis) {
  var x = axis[0], y=axis[1], z=axis[2]
  var ctheta = cos(theta), stheta = sin(theta), cc=1-ctheta

  return Matrix(
  [[x*x*cc+ctheta,   x*y*cc-z*stheta, x*z*cc+y*stheta],
   [x*y*cc+z*stheta, y*y*cc+ctheta,   y*z*cc-x*stheta],
   [z*x*cc-y*stheta, y*z*cc+x*stheta, z*z*cc+ctheta ]]
  )
}

/** Generates a vector normal to a given vector but of arbitrary orientation */
fn _normalvector(vec) {
  var order = [abs(vec[0]), abs(vec[1]), abs(vec[2])].order()
  var out=vec.clone()
  out[order[0]]=0
  out[order[1]]=vec[order[2]]
  out[order[2]]=-vec[order[1]]
  return out
}

/* 3d cross product */
fn _cross3d(a, b) {
  return Matrix([ a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0] ])
}

/* Gram-Schmitt orthonormalization */
fn _orthogonalize(m) { 
  var ncols=m.dimensions()[1]
  for (i in 0...ncols) {
    var x = m.column(i)
    for (j in 0...i) {
      var y = m.column(j)
      x -= x.inner(y)*y
    }
    var nrm = x.norm() 
    if (nrm<_eps) _txtdrnvrtprll.throw() 
    x/=nrm
    m.setcolumn(i, x)
  }
}

/** Coerce list or Matrix to a stored position Matrix (3-vector). nil → origin. */
fn _asposition(p) {
  if (isnil(p)) return Matrix([0, 0, 0])
  if (ismatrix(p)) return p.clone()
  return Matrix(p)
}

/* **************************************
 * Graphics primitives
 **************************************** */

/** TriangleComplexes are a basic graphical unit that draw a set of triangles
   from a given set of vertices. */
class TriangleComplex {
  init(position, normals, colors, connectivity, filter=nil, transmit=nil) {
    self.position=position /* Vertex position matrix */
    self.normals=normals /* Matrix of normal vectors */
    self.colors=colors /* Color */
    self.connectivity=connectivity /* Connectivity matrix; columns are triangles */
    
    /* Optional arguments to be used by povray*/
    self.filter = filter 
    self.transmit = transmit
  }

}

/** Draws a cylinder
  @param[in] start - start point
  @param[in] end - end point
  @param[in] aspectratio - aspect ratio
  @param[in] n - number of faces to use
  @param[in] color - Color of the sphere */
class Cylinder {
  init(start, end, aspectratio=0.1, n=10, color=nil, filter=nil, transmit=nil) {
    self.start = Matrix(start)
    self.end = Matrix(end)
    self.aspectratio = aspectratio
    self.n = n
    self.color = color

    /* Optional arguments to be used by povray*/
    self.filter = filter 
    self.transmit = transmit
  }

  totrianglecomplex() {
    var aspectratio = self.aspectratio
    var n = self.n

    var col = self.color
    if (isnil(col)) col = [0.5,0.5,0.5]

    var np=2*n+2 // 2 points at the end plus 2*n point
    var nt=4*n
    var dim=self.start.count()
    var vertices=Matrix(dim, np);
    var normals=Matrix(dim, np);

    var x1=self.start, x2=self.end
    var dx=x2-x1 // Vector from x1 to x2
    var length = dx.norm()
    if (abs(length)<1e-8) return nil
    var ndx=dx/length

    var px=_normalvector(dx)
    var pxnorm=px.norm()
    if (abs(pxnorm)<1e-15) return
    px=0.5*length*aspectratio*px/pxnorm

    // Head and base of the arrow
    vertices.setcolumn(0, x1)
    vertices.setcolumn(np-1, x2)
    normals.setcolumn(0, -1*dx)
    normals.setcolumn(np-1, dx)

    /* The cylinder is structured like so:

           [n+1...2n]
                      \
    [1..n] A------------B
           |            |
           0            1 2n+1
           <---- dx ----> */
    for (i in 1..n) {
        var theta = 2*Pi*(i-1)/n
        var qx = _rotation(theta, ndx)*px
        var nn=qx/qx.norm()
        var pt = qx+x1
        // Find vertex ring A by rotating px about ndx, to obtain qx, and then adding x1
        vertices.setcolumn(i, pt)
        // Vertex ring B is obtained by simply translating the first circle by dx*(1-ar)
        vertices.setcolumn(n+i, pt+dx)

        // Normals
        normals.setcolumn(i, nn)
        normals.setcolumn(n+i, nn)
    }

    var conn=Sparse(np,nt)
    for (i in 0...n) {
      // Layer 0-A
      conn[0,i]=1
      conn[i+1,i]=1
      if (i<n-1) conn[i+2,i]=1 else conn[1,i]=1

      // C-1
      conn[np-1,n+i]=1
      conn[n+i+1,n+i]=1
      if (i<n-1) conn[n+i+2,n+i]=1 else conn[n+1,n+i]=1

      // Layer A-B
      conn[i+1,2*n+i]=1
      conn[n+i+1,2*n+i]=1
      if (i<n-1) conn[i+2,2*n+i]=1 else conn[1,2*n+i]=1

      if (i<n-1) conn[i+2,3*n+i]=1 else conn[1,3*n+i]=1
      if (i<n-1) conn[n+i+2,3*n+i]=1 else conn[n+1,3*n+i]=1
      conn[n+i+1,3*n+i]=1
    }

      return TriangleComplex(vertices, normals, col, conn)
  }

}

var _sphere = [ PolyhedronMesh(
  [[-0.982247, 0.0, 0.187592], [0.982247,
    0.0, -0.187592], [-0.303531, -0.934172, 0.187592], [-0.303531,
    0.934172, 0.187592], [0.794654, -0.57735, 0.187592], [0.794654,
    0.57735, 0.187592], [-0.187592, -0.57735, 0.794654], [-0.187592,
    0.57735, 0.794654], [-0.491123, -0.356822, -0.794654], [-0.491123,
    0.356822, -0.794654], [0.491123, -0.356822, 0.794654], [0.491123,
    0.356822, 0.794654], [0.607062,
    0.0, -0.794654], [-0.794654, -0.57735, -0.187592], [-0.794654,
    0.57735, -0.187592], [-0.607062, 0.0,
    0.794654], [0.187592, -0.57735, -0.794654], [0.187592,
    0.57735, -0.794654], [0.303531, -0.934172, -0.187592], [0.303531,
    0.934172, -0.187592]]
  ,
  [[14, 9, 8, 13, 0], [1, 5, 11, 10, 4], [4, 10, 6, 2, 18], [10, 11, 7,
    15, 6], [11, 5, 19, 3, 7], [5, 1, 12, 17, 19], [1, 4, 18, 16,
    12], [3, 19, 17, 9, 14], [17, 12, 16, 8, 9], [16, 18, 2, 13, 8], [2,
     6, 15, 0, 13], [15, 7, 3, 14, 0]]
) ]

/** Draws a sphere
  @param[in] center - the center of the sphere
  @param[in] r - radius
  @param[in] color - Color of the sphere */
class Sphere {
  init(center, r, color=nil, maxrefine = 3, filter=nil, transmit=nil) {
    self.center = center
    self.r = r
    self.color = color
    self.maxrefine = maxrefine

    /* Optional arguments to be used by povray */
    self.filter = filter 
    self.transmit = transmit
  }

  refinementlevel() {
    return self.refinementlevel(self.r)
  }

  /** Tessellation level from an effective display radius (entry.scale for unit spheres). */
  refinementlevel(effectiveradius) {
    var n = 0
    var r = effectiveradius
    while (r/(2^n)>0.1 && n<self.maxrefine) {
      if (n>=_sphere.count()-1) {
        _sphere.append(refinemesh(_sphere[-1]))
      }
      n += 1
    }
    return n
  }

  /** @param scale if false, unit ball at origin (pose on Graphics entry).
   *  @param radiusForRefine radius used only to pick tessellation (defaults to self.r). */
  totrianglecomplex(scale=true, radiusForRefine=nil) {
    var center = self.center, r = self.r
    var col = self.color
    if (isnil(col)) col = [0.5,0.5,0.5]
    var refineR = isnil(radiusForRefine) ? self.r : radiusForRefine
    var n = self.refinementlevel(refineR)

    var v = _sphere[n].vertexmatrix().clone()
    var normals = _sphere[n].vertexmatrix().clone()
    var conn = _sphere[n].connectivitymatrix(0,2) // Should clone!
    var nv = v.dimensions()[1]

    var x0=center
    if (islist(center)) x0=Matrix(center)

    // Unit ball at the origin; keep authored color (pose lives on the Graphics entry).
    if (!scale) { x0*=0; r=1 }

    for (i in 0...nv) { // Normalize, scale and translate
      var x = v.column(i)
      var nn = x/x.norm()
      normals.setcolumn(i, nn)
      v.setcolumn(i, x0 + r*nn)
    }

    return TriangleComplex(v, normals, col, conn,
                           filter=self.filter, transmit=self.transmit)
  }

}

/** Draws an arrow
  @param[in] start - start point
  @param[in] end - end point
  @param[in] aspectratio - aspect ratio of the arrow
  @param[in] n - number of faces to use
  @param[in] color - Color of the sphere */
class Arrow {
  init(start, end, aspectratio=0.1, n=10, color=nil, filter=nil, transmit=nil) {
    self.start = Matrix(start)
    self.end = Matrix(end)
    self.aspectratio = aspectratio
    self.n = n
    self.color = color

    /* Optional arguments to be used by povray*/
    self.filter = filter 
    self.transmit = transmit
  }

  totrianglecomplex () {
    var aspectratio = self.aspectratio
    var n = self.n

    var col = self.color
    if (isnil(col)) col = [0.5,0.5,0.5]

    var np=3*n+2 // 2 points at the end plus 3*n point
    var nt=6*n
    var dim=self.start.count()
    var vertices=Matrix(dim, np)
    var normals=Matrix(dim, np)

    var x1=self.start, x2=self.end
    var dx=x2-x1 // Vector from x1 to x2
    var length = dx.norm()
    var ndx=dx/length

    var px=_normalvector(dx)
    var pxnorm=px.norm()
    if (abs(pxnorm)<1e-15) return
    px=0.5*length*aspectratio*px/pxnorm

    // Head and base of the arrow
    vertices.setcolumn(0, x1)
    vertices.setcolumn(np-1, x2)
    normals.setcolumn(0, -1*dx)
    normals.setcolumn(np-1, dx)

    /* The arrow is structured like so:

           [n+1...2n]   C--[2n+1...3n]
                      \ |\
    [1..n] A------------B \
           |               \
           0<----- u --->   1 3n+1
           <------ dx ------> */
    var u=(1-aspectratio)*dx
    for (i in 1..n) {
        var theta = 2*Pi*(i-1)/n
        var qx = _rotation(theta, ndx)*px
        var nn=qx/qx.norm()
        var pt = qx+x1
        // Find vertex ring A by rotating px about ndx, to obtain qx, and then adding x1
        vertices.setcolumn(i, pt)
        // Vertex ring B is obtained by simply translating the first circle by dx*(1-ar)
        vertices.setcolumn(n+i, pt+u)
        // Vertex ring C is obtained by simply adding qx to the point in vertex ring B
        vertices.setcolumn(2*n+i, pt+u+qx)

        // Normals
        normals.setcolumn(i, nn)
        normals.setcolumn(n+i, nn)
        normals.setcolumn(2*n+i, nn)
    }

    var conn=Sparse(np,nt)
    for (i in 0...n) {
      // Layer 0-A
      conn[0,i]=1
      conn[i+1,i]=1
      if (i<n-1) conn[i+2,i]=1 else conn[1,i]=1

      // C-1
      conn[np-1,n+i]=1
      conn[2*n+i+1,n+i]=1
      if (i<n-1) conn[2*n+i+2,n+i]=1 else conn[2*n+1,n+i]=1

      // Layer A-B
      conn[i+1,2*n+i]=1
      conn[n+i+1,2*n+i]=1
      if (i<n-1) conn[i+2,2*n+i]=1 else conn[1,2*n+i]=1

      if (i<n-1) conn[i+2,3*n+i]=1 else conn[1,3*n+i]=1
      if (i<n-1) conn[n+i+2,3*n+i]=1 else conn[n+1,3*n+i]=1
      conn[n+i+1,3*n+i]=1

      // Layer B-C
      conn[n+i+1,4*n+i]=1
      if (i<n-1) conn[n+i+2,4*n+i]=1 else conn[n+1,4*n+i]=1
      conn[2*n+i+1,4*n+i]=1

      if (i<n-1) conn[n+i+2,5*n+i]=1 else conn[n+1,5*n+i]=1
      if (i<n-1) conn[2*n+i+2,5*n+i]=1 else conn[2*n+1,5*n+i]=1
      conn[2*n+i+1,5*n+i]=1
    }

    return TriangleComplex(vertices, normals, col, conn)
  }

}

/** Draws a tube
  @param[in] pts - list of points or a matrix with points as the columns
  @param[in] rad - radius
  @param[in] n - number of faces to use per point
  @param[in] closed - whether to treat the point list as closed or not
  @param[in] color - Color of the sphere */
class Tube {
  normalvector(vec) { // Musn't take the abs for Tube
    var order = [vec[0], vec[1], vec[2]].order()
    var out=vec.clone()
    out[order[0]]=0
    out[order[1]]=vec[order[2]]
    out[order[2]]=-vec[order[1]]
    return out
  }

  init(pts, rad, n=10, color=nil, closed=false, filter=nil, transmit=nil) {
    self.pts = pts
    self.radius = rad
    self.n = n
    self.closed = closed
    self.color = color

    /* Optional arguments to be used by povray*/
    self.filter = filter
    self.transmit = transmit
  }

  totrianglecomplex() {
    var n = self.n
    var col = self.color
    if (isnil(col)) col = [0.5,0.5,0.5]

    var mat = self.pts
    if (islist(self.pts)) mat = Matrix(self.pts).transpose();

    var np=mat.dimensions()[1]
  	var dim=mat.dimensions()[0]
    var nv=n*np
  	var nt=n*(2*(np-1))
    if (!self.closed) {
  		nv+=2 // Two points for the caps
  		nt+=2*n // n triangles for each cap
  	}

    var vertices=Matrix(dim, nv);
    var normals=Matrix(dim, nv);

  	var sep[np], ndx[np]

  	// Loop over line segments to calculate separation vectors
  	for (k in 0..np-2) {
  		var dx=mat.column(k+1)-mat.column(k)
  		sep[k]=dx/dx.norm()
  		ndx[k]+=sep[k]
  		ndx[k+1]+=sep[k]
  	}

  	// Correct ends if closed
  	if (self.closed) {
  		var dx=mat.column(0)-mat.column(np-1)
  		sep[np-1]=dx/dx.norm()
  		ndx[np-1]+=sep[np-1]
  		ndx[0]+=sep[np-1]
  	}

  	// Now generate vertices
   	for (k in 0...np) {
  		var px // Vertices are generated from a point plus this displacement
   		if (k==0) {
  			px=self.normalvector(ndx[k])
  		} else { // This aligns vertices generated from successive points
  			var dx=vertices.column((k-1)*n)-mat.column(k-1)
  			px=dx-dx.inner(ndx[k])*ndx[k]/ndx[k].norm()
  		}
  		px=self.radius*px/px.norm()

  		var x1 = mat.column(k)
  		for (i in 0...n) {
  			/* Find vertex ring at point k by rotating px about ndx, to obtain qx, and then adding x1 */
        var theta = i*2*Pi/n
  			var qx = _rotation(theta, ndx[k])*px
  			vertices.setcolumn(k*n+i, x1+qx)

  			normals.setcolumn(k*n+i, qx/qx.norm())
  		}
   	}

  	/* Loop over segments again to create the triangles */
  	var conn=Sparse(nv,nt)

  	var m=0
  	for (k in 0..np-2) {
  		for (i in 0...n) {
  			conn[k*n+i,m]=1
  			if (i==n-1) conn[k*n,m]=1 else conn[k*n+i+1,m]=1
  			conn[((k+1)*n+i),m]=1
  			m+=1
  			if (i==n-1) conn[k*n,m]=1 else conn[k*n+i+1,m]=1
  			if (i==n-1) conn[(k+1)*n,m]=1 else conn[((k+1)*n+i)+1,m]=1
  			conn[((k+1)*n+i),m]=1
  			m+=1
  		}
  	}

  	if (self.closed) {
  		// Connect first and last points
  		var k=np-1
  		for (i in 0...n) {
  			conn[k*n+i,m]=1
  			if (i==n-1) conn[k*n,m]=1 else conn[k*n+i+1,m]=1
  			conn[i,m]=1
  			m+=1
  			if (i==n-1) conn[k*n,m]=1 else conn[k*n+i+1,m]=1
  			if (i==n-1) conn[0,m]=1 else conn[i+1,m]=1
  			conn[i,m]=1
  			m+=1
  		}
  	} else {
  		// End caps
  		vertices.setcolumn(nv-2, mat.column(0))
  		vertices.setcolumn(nv-1, mat.column(np-1))

  		normals.setcolumn(nv-2, -sep[0]/sep[0].norm())
  		normals.setcolumn(nv-1, sep[np-2]/sep[np-2].norm())

  		for (i in 0...n) {
  			conn[i,m]=1
  			if (i==n-1) conn[0,m]=1 else conn[i+1,m]=1
  			conn[nv-2,m]=1
  			m+=1
  			conn[((np-1)*n+i),m]=1
  			if (i==n-1) conn[(np-1)*n,m]=1 else conn[((np-1)*n+i)+1,m]=1
  			conn[nv-1,m]=1
  			m+=1
  		}
  	}

      return TriangleComplex(vertices, normals, col, conn, filter=self.filter, transmit=self.transmit)
  }

}

/* **************************************
 * Text
 **************************************** */

class Text {
  init(string, posn, dirn=nil, vertical=nil, size=10, font=nil, color=nil, filter=nil, transmit=nil) {
    self.posn = posn
    if (islist(self.posn)) self.posn = Matrix(self.posn)

    self.dirn = dirn // Direction of flow for the text 
    if (islist(self.dirn)) self.dirn = Matrix(self.dirn)

    self.vertical = vertical // Vertical direction
    if (islist(self.vertical)) self.vertical = Matrix(self.vertical)
    
    self.string = string 
    self.font = font
    self.color = color 
    self.size = size 
    
    /* Optional arguments to be used by povray*/
    self.filter = filter 
    self.transmit = transmit
  }

  transformationmatrix() {
    if (!(ismatrix(self.dirn) || ismatrix(self.vertical))) return nil 
    var m = Matrix(4,4) 
    for (i in 0..3) m[i,i]=1

    if (self.dirn) for (i in 0..2) m[i,0]=self.dirn[i]
    if (self.vertical) for (i in 0..2) m[i,1]=self.vertical[i]

    // Now set the final direction to the cross product of the two 
    var zp = _cross3d(m.column(1),m.column(0)) 
    for (i in 0..2) m[i,2]=zp[i]

    _orthogonalize(m)

    return m.transpose() 
  }

}

class Font {
  init (name, size, id=nil) {
    self.name = name 
    self.size = size 
    self.id = id
  }
}

/* **************************************
 * Point and line primitives (viewer `p` / `l`)
 **************************************** */

/** Normalize inputs to a dim×n vertex matrix (points as columns). */
fn _asvertexmatrix(Matrix pts) { return pts }

fn _asvertexmatrix(pts) { // list of points
  return Matrix(pts).transpose()
}

/** Point cloud — positions as Matrix columns (or list of points).
  Optional uniform or per-vertex `color`. Emits viewer points (`p`), not spheres. */
class PointCloud {
  init(position, color=nil, filter=nil, transmit=nil) {
    self.position = _asvertexmatrix(position)
    self.color = color
    self.filter = filter
    self.transmit = transmit
  }
}

/** Line set — vertices plus segments.
  @param position - Matrix columns (or list of points)
  @param connectivity - Sparse/Matrix with two vertices per column, or list of [i,j] pairs.
    Omit for a polyline through successive vertices (use `closed=true` to loop).
  Color and flags are keyword args (Morpho optionals are not positional). */
class LineSet {
  // Polyline through successive vertices
  init(position, color=nil, closed=false, filter=nil, transmit=nil) {
    self.position = _asvertexmatrix(position)
    self.connectivity = nil
    self.color = color
    self.closed = closed
    self.filter = filter
    self.transmit = transmit
  }

  // Explicit segments
  init(position, connectivity, color=nil, closed=false, filter=nil, transmit=nil) {
    self.position = _asvertexmatrix(position)
    self.connectivity = connectivity
    self.color = color
    self.closed = closed
    self.filter = filter
    self.transmit = transmit
  }

  /** Flat index list for GL_LINES: i0 j0 i1 j1 ... */
  segmentindices() {
    var nv = self.position.dimensions()[1]
    var conn = self.connectivity
    var out = []

    if (isnil(conn)) {
      var nseg = self.closed ? nv : nv - 1
      if (nseg < 1) return out
      for (i in 0...nseg) {
        out.append(i)
        out.append(mod(i + 1, nv))
      }
      return out
    }

    if (islist(conn)) {
      for (seg in conn) {
        out.append(seg[0])
        out.append(seg[1])
      }
      return out
    }

    // Sparse or dense incidence matrix: columns are segments
    var nf = conn.dimensions()[1]
    for (i in 0...nf) {
      if (issparse(conn)) {
        var indx = conn.rowindices(i)
        for (j in 0...indx.count()) out.append(indx[j])
      } else {
        var nvf = conn.dimensions()[0]
        for (j in 0...nvf) {
          if (conn[j, i] != 0) out.append(j)
        }
      }
    }
    return out
  }
}

/* **************************************
 * Graphics class
 **************************************** */

/** One placed item in a Graphics: stable id + item + presentation SRT. */
class GraphicsEntry {
  init(id, item, position=nil, scale=nil, rotate=nil, color=nil) {
    self.id = id
    self.item = item
    self.position = _asposition(position)
    self.scale = isnil(scale) ? 1 : scale
    self.rotate = rotate
    self.color = color             // presentation albedo (Sphere / recolor); nil → item
    self.flat = false              // unlit draw (set true for solid facet colors)
  }
}

/** Events from Scene (Broadcaster). Typed subclasses enable multiple dispatch.
 *  Named GraphicsEvent* for continuity with the Graphics entry model. */
class GraphicsEvent with BroadcastEvent {
  init(id) {
    self.id = id
  }
}

class GraphicsEventDefined is GraphicsEvent {}

/** Merge `prev.ids` then `into.ids` (first-seen order, deduped). */
fn _coalesceIds(into, prev) {
  var seen = Dictionary()
  var out = []
  for (id in prev.ids) {
    if (!seen.contains(id)) {
      seen[id] = true
      out.append(id)
    }
  }
  for (id in into.ids) {
    if (!seen.contains(id)) {
      seen[id] = true
      out.append(id)
    }
  }
  into.ids = out
}

/** Coalesces within a Broadcaster batch; `ids` accumulates every mover. */
class GraphicsEventMoved is GraphicsEvent {
  init(id) {
    super.init(id)
    self.ids = [id]
  }
  batchKey() { return GraphicsEventMoved }
  coalesce(prev) { _coalesceIds(self, prev) }
}

/** Coalesces within a Broadcaster batch; `ids` accumulates every recolor target. */
class GraphicsEventRecolored is GraphicsEvent {
  init(id) {
    super.init(id)
    self.ids = [id]
  }
  batchKey() { return GraphicsEventRecolored }
  coalesce(prev) { _coalesceIds(self, prev) }
}

/** Entry removed from Scene (no coalesce — each id flushed). */
class GraphicsEventRemoved is GraphicsEvent {}

/** Entry item replaced (no coalesce — each id flushed). */
class GraphicsEventReplaced is GraphicsEvent {}

/** Unit Sphere for entry storage (pose lives on the GraphicsEntry). */
fn _unitsphere(Sphere item) {
  return Sphere([0, 0, 0], 1, color=item.color, maxrefine=item.maxrefine,
                filter=item.filter, transmit=item.transmit)
}

/** Static displaylist container. Accepted by Show / View.open / View.update.
 *  For live mutation (move / recolor / batch) use Scene. */
class Graphics {
  init(title = nil, background = nil) {
    self.displaylist = [] // GraphicsEntry list
    self._nextid = 1
    self.title = title
    if (!self.title) self.title="Morpho" // Title to show
    self.background = background
    if (!self.background) self.background = Black
  }

  /** Look up an entry by Graphics-owned id; nil if missing. */
  findEntry(id) {
    for (e in self.displaylist) {
      if (e.id == id) return e
    }
    return nil
  }

  /** Allocate id and append a GraphicsEntry; returns the id. No events. */
  _append(item, position=nil, scale=nil, rotate=nil, color=nil) {
    var id = self._nextid
    self._nextid += 1
    self.displaylist.append(GraphicsEntry(id, item, position=position, scale=scale,
                                          rotate=rotate, color=color))
    return id
  }

  /** Append a non-Sphere item (identity SRT). Returns Graphics-owned id.
   *  Morpho: defaults are keyword-only, so pose uses the 2-arg overload below. */
  display(item) {
    if (!isobject(item)) return nil
    return self._append(item)
  }

  /** Non-Sphere with pose: 2nd positional position (list/Matrix/nil) + scale=/rotate=. */
  display(item, position, scale=nil, rotate=nil) {
    if (!isobject(item)) return nil
    return self._append(item, position=position, scale=scale, rotate=rotate)
  }

  /** Unit Sphere + entry SRT from authored center/r. */
  display(Sphere item) {
    return self._append(_unitsphere(item), position=item.center, scale=item.r,
                        color=item.color)
  }

  /** Unit Sphere + pose args on the entry (sole pose authority). */
  display(Sphere item, position, scale=nil, rotate=nil) {
    var scl = isnil(scale) ? 1 : scale
    return self._append(_unitsphere(item), position=position, scale=scl, rotate=rotate,
                        color=item.color)
  }

  /** Union of two Graphics. Left-hand ids kept; right-hand ids remapped unique in the result.
   *  Entry records are copied (item refs shared); no Defined notifications. */
  add(right) {
    var g = Graphics()
    g.title = self.title
    g.background = self.background
    g._nextid = self._nextid
    for (el in self.displaylist) {
      var e = GraphicsEntry(el.id, el.item, position=el.position, scale=el.scale,
                            rotate=el.rotate, color=el.color)
      e.flat = el.flat
      g.displaylist.append(e)
    }
    for (el in right.displaylist) {
      g._append(el.item, position=el.position, scale=el.scale, rotate=el.rotate,
                color=el.color)
    }
    return g
  }
}

/** Live Graphics: Broadcaster + move / recolor / remove / replace / batch. Scene is Graphics, so
 *  Show and View accept Scene wherever Graphics is expected. */
class Scene is Graphics with Broadcaster {
  init(title = nil, background = nil) {
    super.init(title=title, background=background)
    self._broadcasterInit()
  }

  /** Allocate id, append entry, optionally notify Defined. */
  _append(item, position=nil, scale=nil, rotate=nil, color=nil, notify=true) {
    var id = super._append(item, position=position, scale=scale, rotate=rotate, color=color)
    if (notify) self.notify(GraphicsEventDefined(id))
    return id
  }

  /** Update scale=/rotate= only; omitted kwargs leave that component unchanged. */
  move(id, scale=nil, rotate=nil) {
    var e = self.findEntry(id)
    if (isnil(e)) return false
    if (!isnil(scale)) e.scale = scale
    if (!isnil(rotate)) e.rotate = rotate
    self.notify(GraphicsEventMoved(id))
    return true
  }

  /** Set position (always); scale=/rotate= only when provided. */
  move(id, position, scale=nil, rotate=nil) {
    var e = self.findEntry(id)
    if (isnil(e)) return false
    e.position = _asposition(position)
    if (!isnil(scale)) e.scale = scale
    if (!isnil(rotate)) e.rotate = rotate
    self.notify(GraphicsEventMoved(id))
    return true
  }

  /** Set presentation color for an entry (viewer slot albedo via `C`). */
  recolor(id, color) {
    var e = self.findEntry(id)
    if (isnil(e)) return false
    e.color = color
    self.notify(GraphicsEventRecolored(id))
    return true
  }

  /** Remove an entry by Graphics-owned id; notifies Removed. */
  remove(id) {
    var next = []
    var found = false
    for (e in self.displaylist) {
      if (e.id == id) found = true
      else next.append(e)
    }
    if (!found) return false
    self.displaylist = next
    self.notify(GraphicsEventRemoved(id))
    return true
  }

  /** Replace entry item; SRT unchanged. */
  replace(id, item) {
    var e = self.findEntry(id)
    if (isnil(e) || !isobject(item)) return false
    e.item = item
    self.notify(GraphicsEventReplaced(id))
    return true
  }

  /** Replace with unit Sphere (like display); keep entry SRT. */
  replace(id, Sphere item) {
    var e = self.findEntry(id)
    if (isnil(e)) return false
    e.item = _unitsphere(item)
    if (isnil(e.color)) e.color = item.color
    self.notify(GraphicsEventReplaced(id))
    return true
  }

  /** Union as Scene. Entry copies; no Defined notifications. */
  add(right) {
    var g = Scene()
    g.title = self.title
    g.background = self.background
    g._nextid = self._nextid
    for (el in self.displaylist) {
      var e = GraphicsEntry(el.id, el.item, position=el.position, scale=el.scale,
                            rotate=el.rotate, color=el.color)
      e.flat = el.flat
      g.displaylist.append(e)
    }
    for (el in right.displaylist) {
      g._append(el.item, position=el.position, scale=el.scale, rotate=el.rotate,
                color=el.color, notify=false)
    }
    return g
  }
}

/* **************************************
 * Resolve morphoview executable (Show launch + View spawn)
 **************************************** */

var _mvbin = nil

fn _morphoviewbin() {
  if (!isnil(_mvbin)) return _mvbin

  var exe = (System.platform()=="windows" ? "morphoview.exe" : "morphoview")
  var roots = []

  var r = System.subprocess("morphopm path morphoview")
  if (r["exitstatus"]==0) {
    roots.append(r["stdout"].split("\n")[0])
  } else if (Folder.contents(System.homefolder()).contains(".morphopackages")) {
    for (p in File("${System.homefolder()}/.morphopackages").lines()) {
      if (p.split("/\\").contains("morpho-morphoview")) roots.append(p)
    }
  }

  for (root in roots) {
    if (root.count()>0 &&
        Folder.isFolder("${root}/bin") &&
        Folder.contents("${root}/bin").contains(exe)) {
      _mvbin = Folder.normalizePath("${root}/bin/${exe}")
      return _mvbin
    }
  }

  _mvbin = "morphoview"
  return _mvbin
}

/* **************************************
 * Show a graphics object
 *
 *  - `Show()`     — serializer only (uid / font / color state)
 *  - `Show(g)`    — fire-and-forget (temp file + morphoview -t)
 *  - `show.write(g, out)` — emit ASCII commands to any `out.write(...)` sink
 **************************************** */

class Show {
  // Serializer only — use write(g, out) with any write-able sink.
  init() {
    self.uidInit()
    self.fonts = []
    self.colors = Dictionary()
    self.sceneId = 1
    self.replace = false
    self.objectMap = Dictionary()    // graphicsId → viewer object id
    self.entryColorId = Dictionary() // graphicsId → color id when draw needs `C`
    self.flatIds = Dictionary()      // graphicsId → true if draw needs `M flat`
    self.vertexLayout = Dictionary() // graphicsId → "xn" | "xnc" (TriangleComplex)
    self.meshCache = Dictionary()    // mesh key → viewer object id (shared geometry)
    self._currentEntry = nil
    self._lastColorId = nil
    self._lastVertexLayout = nil
  }

  // Fire-and-forget: temp file + morphoview -t.
  init(g) {
    self.init()
    self._launch(g)
  }

  /** Fire-and-forget: temp file + morphoview -t. */
  _launch(g) {
    var isWindows = System.platform()=="windows"
    var tempFolder = (isWindows ? "${System.homefolder()}\\AppData\\local\\Temp" : "/tmp")
    var fname = self._randomAlphanumString(10)
    var out = File("${tempFolder}/morpho${fname}.draw", "w")
    var bin = _morphoviewbin()

    self.write(g, out)

    out.close()

    if (isWindows) {
      system("powershell -Command \"Start-Process '${bin}' -ArgumentList '-t', '${tempFolder}/morpho${fname}.draw' -WindowStyle Hidden\"")
    } else {
      // 1/7/25 Redirect error output to /dev/null
      system("\"${bin}\" -t ${tempFolder}/morpho${fname}.draw > /dev/null 2>&1 &")
    }
  }

  /** Generate a random name */
  _randomAlphanumString(n) {
    var alpha="abcdefghijklmnopqrstuvwxyz0123456789"
    var name=""
    for (i in 1..n) name+=alpha[Int(random()*(alpha.count()-1))]
    return name
  }

  uidInit() {
    self.uid = 0
  }

  uid() { // Generate unique identifiers
    self.uid+=1
    return self.uid
  }

  preamble(graphic, out) {
    if (self.replace) {
      out.write("U S ${self.sceneId}")
    } else {
      out.write("S ${self.sceneId} 3")
      out.write("W \"${graphic.title}\"")
    }
    var bg = graphic.background.rgb(0)
    out.write("G ${self.fmt(bg[0])} ${self.fmt(bg[1])} ${self.fmt(bg[2])}")
  }

  // 3 significant figures — enough for display; keeps ASCII small vs full doubles.
  // Morpho requires a width field (`%.3g` is rejected); use 0 to avoid padding spaces.
  // Coerce via Float: Matrix/Color often yield Ints, and Int.format rejects %g.
  fmt(x) {
    return Float(x).format("%0.3g")
  }

  /* The visit method for a generic `item`.

  Here, we define this separate `visitGeneric` method that performs the intended generic task, and have the actual generic `visit` method call `visitGeneric`. This enables calls to the generic fallback from *within a specific implementation*.
  For example, `visit(Cylinder)` can call `self.visitGeneric(item, out)` after a degenerate check; calling `self.visit(item, out)` would recurse on the typed overload.
  */
  visitGeneric(item, out) {
    var tri = item.totrianglecomplex()
    if (isnil(tri)) return // e.g. zero-length Cylinder/Arrow
    // Most converters drop filter/transmit (Tube is the exception); copy from the source.
    if (!isnil(item.filter)) tri.filter = item.filter
    if (!isnil(item.transmit)) tri.transmit = item.transmit
    self.visit(tri, out)
  }

  // Will be used by Tube (and other meshes with totrianglecomplex)
  visit(item, out) {
    self.visitGeneric(item, out)
  }

  visit(Cylinder item, out) {
    // Skip degenerate shafts (zero/NaN length). `!(len > eps)` rejects NaN too.
    var len = (item.end - item.start).norm()
    if (!(len > 1e-8)) return
    self.visitGeneric(item, out)
  }

  visit(Arrow item, out) {
    var len = (item.end - item.start).norm()
    if (!(len > 1e-8)) return
    self.visitGeneric(item, out)
  }

  visit(Sphere item, out) {
    // Prefer visitEntry(Sphere); fallback bakes (no entry SRT / cache).
    self.visitGeneric(item, out)
  }

  /** Emit i / s / r / t / d.
   *  - viewerId set, entry.id ≠ 0 → `d <graphicsId> <viewerId>` (define/redraw)
   *  - viewerId set, entry.id == 0 → `d <viewerId>` (no Graphics entry; raw bake only)
   *  - viewerId nil → `d <graphicsId>` (pose-only update)
   *  Callers under an entry must pass that entry (not GraphicsEntry(0,…)). */
  emitEntryDraw(entry, out, viewerId=nil) {
    out.write("i")
    if (entry.scale != 1) out.write("s ${self.fmt(entry.scale)}")
    if (!isnil(entry.rotate)) {
      var r = entry.rotate
      out.write("r ${self.fmt(r[0])} ${self.fmt(r[1])} ${self.fmt(r[2])} ${self.fmt(r[3])}")
    }
    var p = entry.position
    if (!(p[0] == 0 && p[1] == 0 && p[2] == 0)) {
      out.write("t ${self.fmt(p[0])} ${self.fmt(p[1])} ${self.fmt(p[2])}")
    }
    if (isnil(viewerId)) {
      out.write("d ${entry.id}")
    } else if (entry.id != 0) {
      out.write("d ${entry.id} ${viewerId}")
    } else {
      out.write("d ${viewerId}")
    }
  }

  /** Entry for a draw under visit: prefer `_currentEntry`, else synthetic id 0. */
  _drawEntry(item) {
    if (!isnil(self._currentEntry)) return self._currentEntry
    return GraphicsEntry(0, item)
  }

  /** Record graphicsId → viewer id (and optional draw color / flat shade / layout). */
  _recordObject(viewerId, colorId=nil, flat=false) {
    var entry = self._currentEntry
    if (isnil(entry) || entry.id == 0) return
    self.objectMap[entry.id] = viewerId
    if (!isnil(colorId)) self.entryColorId[entry.id] = colorId
    if (flat) self.flatIds[entry.id] = true
    if (!isnil(self._lastVertexLayout)) {
      self.vertexLayout[entry.id] = self._lastVertexLayout
    }
  }

  /** Re-issue draws for all mapped entries after `D` (entry SRT). */
  emitPoseDraws(graphic, out) {
    for (entry in graphic.displaylist) {
      if (!self.objectMap.contains(entry.id)) continue
      var vid = self.objectMap[entry.id]
      var needFlat = self.flatIds.contains(entry.id)
      if (needFlat) out.write("M flat")
      if (self.entryColorId.contains(entry.id)) {
        out.write("C ${self.entryColorId[entry.id]}")
      }
      self.emitEntryDraw(entry, out, viewerId=vid)
      if (needFlat) out.write("M shaded")
    }
  }

  /** Pose-only draw for one graphics id (no C/M — for in-place `d` update after open). */
  emitEntryPose(graphic, graphicsId, out) {
    if (!self.objectMap.contains(graphicsId)) return false
    var entry = graphic.findEntry(graphicsId)
    if (isnil(entry)) return false
    self.emitEntryDraw(entry, out)
    return true
  }

  /** Presentation RGB for an entry (entry.color, else typed item albedo). */
  entryRgb(entry) {
    if (!isnil(entry.color)) return self._rgbValue(entry.color)
    return self._itemRgb(entry.item)
  }

  /** Item albedo by concrete type (closed display-item set → multiple dispatch). */
  _itemRgb(TriangleComplex item) { return self._rgbValue(item.colors) }
  _itemRgb(Sphere item) { return self._rgbValue(item.color) }
  _itemRgb(Cylinder item) { return self._rgbValue(item.color) }
  _itemRgb(Arrow item) { return self._rgbValue(item.color) }
  _itemRgb(Tube item) { return self._rgbValue(item.color) }
  _itemRgb(Text item) { return self._rgbValue(item.color) }
  _itemRgb(PointCloud item) { return self._rgbValue(item.color) }
  _itemRgb(LineSet item) { return self._rgbValue(item.color) }
  _itemRgb(item) { return [0.5, 0.5, 0.5] }

  /** Normalize Matrix / list / Color / ColorMap-like values to RGB (open value shapes). */
  _rgbValue(col) {
    if (isnil(col)) return [0.5, 0.5, 0.5]
    if (ismatrix(col)) return [col[0,0], col[1,0], col[2,0]]
    if (islist(col)) return col
    if (isobject(col)) {
      if (!isnil(col.r) && !isnil(col.g) && !isnil(col.b)) return [col.r, col.g, col.b]
      return col.rgb(0)
    }
    return [0.5, 0.5, 0.5]
  }

  /** Recolor: ensure `c`/`C`, then `d <graphicsId>` with no transforms (matrix preserved). */
  emitEntryRecolor(graphic, graphicsId, out) {
    if (!self.objectMap.contains(graphicsId)) return false
    var entry = graphic.findEntry(graphicsId)
    if (isnil(entry)) return false
    var alpha = self.opacity(entry.item)
    var cid = self.addRgb(self.entryRgb(entry), alpha, out)
    self.entryColorId[graphicsId] = cid
    out.write("C ${cid}")
    out.write("d ${graphicsId}")
    return true
  }

  /** How many Graphics entries map to this viewer object id. */
  objectUserCount(viewerId) {
    var n = 0
    for (gid in self.objectMap) {
      if (self.objectMap[gid] == viewerId) n += 1
    }
    return n
  }

  /** Drop Show maps for one Graphics entry id. */
  forgetEntry(graphicsId) {
    if (self.objectMap.contains(graphicsId)) self.objectMap.remove(graphicsId)
    if (self.entryColorId.contains(graphicsId)) self.entryColorId.remove(graphicsId)
    if (self.flatIds.contains(graphicsId)) self.flatIds.remove(graphicsId)
    if (self.vertexLayout.contains(graphicsId)) self.vertexLayout.remove(graphicsId)
  }

  /** Drop meshCache keys that point at @p viewerId. */
  _forgetMeshCacheFor(viewerId) {
    var drop = []
    for (key in self.meshCache) {
      if (self.meshCache[key] == viewerId) drop.append(key)
    }
    for (key in drop) self.meshCache.remove(key)
  }

  /** Emit `X D` (+ `X O` if last user of the viewer object). */
  emitEntryRemove(graphicsId, out) {
    if (!self.objectMap.contains(graphicsId)) {
      out.write("X D ${graphicsId}")
      return true
    }
    var vid = self.objectMap[graphicsId]
    out.write("X D ${graphicsId}")
    self.forgetEntry(graphicsId)
    if (self.objectUserCount(vid) == 0) {
      out.write("X O ${vid}")
      self._forgetMeshCacheFor(vid)
    }
    return true
  }

  /** Redefine a replaced entry: reuse shared Sphere `o` when possible; else remove + writeEntry. */
  emitEntryReplace(graphic, graphicsId, out) {
    var entry = graphic.findEntry(graphicsId)
    if (isnil(entry)) return false
    return self._emitReplace(entry, entry.item, out)
  }

  /** Shared Sphere: keep cached `o` when refine key matches; else drop + rewrite. */
  _emitReplace(entry, Sphere item, out) {
    var graphicsId = entry.id
    var key = "sphere:${item.refinementlevel(entry.scale)}"
    var oldVid = self.objectMap.contains(graphicsId) ? self.objectMap[graphicsId] : nil
    if (!isnil(oldVid) && self.meshCache.contains(key) && self.meshCache[key] == oldVid) {
      var cid = self.addRgb(self.entryRgb(entry), self.opacity(item), out)
      self.entryColorId[graphicsId] = cid
      out.write("C ${cid}")
      self.emitEntryDraw(entry, out, viewerId=oldVid)
      return true
    }
    self.emitEntryRemove(graphicsId, out)
    self.writeEntry(entry, out)
    return true
  }

  /** Unique mesh: drop old draw/object, then define+draw fresh. */
  _emitReplace(entry, item, out) {
    self.emitEntryRemove(entry.id, out)
    self.writeEntry(entry, out)
    return true
  }

  /** Same-length vertex replace for a mapped TriangleComplex (`U V`).
   *  Float layout must match define (`xn` vs `xnc`); returns false if unmapped,
   *  wrong type, or layout unknown (never emit a length the viewer will drop). */
  emitEntryVertices(graphic, graphicsId, out) {
    if (!self.objectMap.contains(graphicsId)) return false
    var entry = graphic.findEntry(graphicsId)
    if (isnil(entry)) return false
    return self._emitVertices(entry, entry.item, out)
  }

  _emitVertices(entry, TriangleComplex item, out) {
    if (!self.vertexLayout.contains(entry.id)) return false
    var layout = self.vertexLayout[entry.id]
    var vid = self.objectMap[entry.id]
    out.write("U V ${vid}")
    if (layout == "xnc") {
      self._triangleComplexVertexFloats(item, out, includeColor=true)
    } else if (layout == "xn") {
      self._triangleComplexVertexFloats(item, out, includeColor=false)
    } else {
      return false
    }
    return true
  }

  _emitVertices(entry, item, out) {
    return false
  }

  /** POVRay transmit/filter → OpenGL alpha: a = 1 - clamp(transmit + filter, 0, 1). */
  opacity(item) {
    var t = isnil(item.transmit) ? 0 : item.transmit
    var f = isnil(item.filter) ? 0 : item.filter
    var a = 1 - (t + f)
    return (a < 0) ? 0 : ((a > 1) ? 1 : a)
  }

  /** Uniform RGB for a TriangleComplex (first vertex if per-vertex colors). */
  uniformRgb(item) {
    return self._rgbValue(item.colors)
  }

  /** Emit `c` for rgb[+alpha]; returns color id. Alpha < ~1 → RGBA. */
  addRgb(rgb, alpha, out) {
    var r = self.fmt(rgb[0])
    var g = self.fmt(rgb[1])
    var b = self.fmt(rgb[2])
    var a = self.fmt(alpha)
    var key = "${r} ${g} ${b} ${a}"
    if (!self.colors.contains(key)) {
      var id = self.colors[key] = self.colors.count()
      out.write(alpha < 0.999 ?
                "c ${id} ${r} ${g} ${b} ${a}" :
                "c ${id} ${r} ${g} ${b}")
    }
    return self.colors[key]
  }

  triangleComplexObjectData(item, out, includeColor=true) {
    if (includeColor) {
      out.write("v \"xnc\"")
    } else {
      out.write("v \"xn\"")
    }
    self._triangleComplexVertexFloats(item, out, includeColor=includeColor)

    out.write("f")
    var f=item.connectivity
    var nf=f.dimensions()[1]

    for (i in 0...nf) {
      var line = ""
      // Sparse connectivity preserves face winding via rowindices (cf. povray Show).
      // Dense Matrix incidence only stores membership — fall back to ascending ids.
      if (issparse(f)) {
        var indx = f.rowindices(i)
        for (j in 0...indx.count()) line+="${indx[j]} "
      } else {
        var nvf=f.dimensions()[0]
        for (j in 0...nvf) {
          if (f[j,i]!=0) line+="${j} "
        }
      }
      out.write(line)
    }
  }

  /** Position + normal [+ color] float rows only (shared by define `v` and `U V`). */
  _triangleComplexVertexFloats(item, out, includeColor=true) {
    var x = item.position
    var n = item.normals
    var col = item.colors
    var localColor = false
    var dimensions = x.dimensions()
    var dim = dimensions[0]
    var nv = dimensions[1]

    if (includeColor) {
      if (ismatrix(col)) {
        if (col.dimensions()[1] > 1) localColor = true
      } else if (isobject(col) && !islist(col)) col = col.rgb(0)
    }

    for (i in 0...nv) {
      var line = ""
      for (j in 0...dim) line += "${self.fmt(x[j,i])} "
      for (j in 0...dim) line += "${self.fmt(n[j,i])} "
      if (includeColor) {
        if (localColor) {
          for (j in 0...3) line += "${self.fmt(col[j,i])} "
        } else {
          for (j in 0...item.colors.count()) line += "${self.fmt(col[j])} "
        }
      }
      out.write(line)
    }
  }

  /** Define a TriangleComplex with `v "xn"` only (no vertex colors); returns viewer id.
   *  Does not emit `C` — caller stamps color for the draw slot. */
  defineXnTriangleComplex(item, out) {
    var id = self.uid()
    self._lastVertexLayout = "xn"
    out.write("o ${id}")
    self.triangleComplexObjectData(item, out, includeColor=false)
    return id
  }

  /** Define a TriangleComplex (`o`/`v`/`f`, optional `C`); returns viewer object id.
   *  Sets `self._lastColorId` when a uniform `C` is selected (else nil).
   *  Sets `self._lastVertexLayout` to `"xn"` (translucent) or `"xnc"` (opaque). */
  defineTriangleComplex(item, out) {
    var id = self.uid()
    var alpha = self.opacity(item)
    self._lastColorId = nil
    if (alpha < 0.999) {
      // Uniform albedo + alpha (viewer transparent pass); vertex colors deferred.
      var cid = self.addRgb(self.uniformRgb(item), alpha, out)
      self._lastColorId = cid
      self._lastVertexLayout = "xn"
      out.write("C ${cid}")
      out.write("o ${id}")
      self.triangleComplexObjectData(item, out, includeColor=false)
    } else {
      self._lastVertexLayout = "xnc"
      out.write("o ${id}")
      self.triangleComplexObjectData(item, out)
    }
    return id
  }

  /** From visitGeneric (baked Sphere/Cylinder/…): draw with `_currentEntry` when set. */
  visit(TriangleComplex item, out) {
    var vid = self.defineTriangleComplex(item, out)
    self._recordObject(vid, colorId=self._lastColorId)
    self.emitEntryDraw(self._drawEntry(item), out, viewerId=vid)
  }

  /** Uniform RGB for PointCloud / LineSet color field. */
  pointLineRgb(item) {
    return self._rgbValue(item.color)
  }

  /** Emit vertex positions (+ optional per-vertex color) for points/lines. */
  pointLineVertexData(item, out, includeColor=true) {
    var x = item.position
    var col = item.color
    var localColor = false
    var dimensions = x.dimensions()
    var dim = dimensions[0]
    var nv = dimensions[1]

    if (includeColor) {
      if (ismatrix(col)) {
        if (col.dimensions()[1] > 1) localColor = true
      } else if (isobject(col) && !islist(col)) {
        if (!isnil(col.r) && !isnil(col.g) && !isnil(col.b)) col = [col.r, col.g, col.b]
        else col = col.rgb(0)
      }
      out.write("v \"xc\"")
    } else {
      out.write("v \"x\"")
    }

    for (i in 0...nv) {
      var line = ""
      for (j in 0...dim) line += "${self.fmt(x[j,i])} "
      if (includeColor) {
        if (localColor) {
          for (j in 0...3) line += "${self.fmt(col[j,i])} "
        } else if (islist(col) || (isobject(col) && !ismatrix(col))) {
          for (j in 0...col.count()) line += "${self.fmt(col[j])} "
        } else if (ismatrix(col)) {
          for (j in 0...3) line += "${self.fmt(col[j,0])} "
        } else {
          line += "0.5 0.5 0.5 "
        }
      }
      out.write(line)
    }
  }

  /** Define PointCloud geometry (`o`/`v`/`p`); sets `_lastColorId`. Returns viewer id or nil. */
  definePointCloud(item, out) {
    var id = self.uid()
    var alpha = self.opacity(item)
    var nv = item.position.dimensions()[1]
    if (nv < 1) return nil
    self._lastColorId = nil
    var cid = nil
    if (alpha < 0.999) {
      cid = self.addRgb(self.pointLineRgb(item), alpha, out)
      self._lastColorId = cid
      out.write("C ${cid}")
      out.write("o ${id}")
      self.pointLineVertexData(item, out, includeColor=false)
    } else {
      out.write("o ${id}")
      self.pointLineVertexData(item, out, includeColor=true)
    }
    var pline = "p"
    for (i in 0...nv) pline += " ${i}"
    out.write(pline)
    return id
  }

  /** Define LineSet geometry (`o`/`v`/`l`); sets `_lastColorId`. Returns viewer id or nil. */
  defineLineSet(item, out) {
    var id = self.uid()
    var alpha = self.opacity(item)
    var nv = item.position.dimensions()[1]
    var segs = item.segmentindices()
    if (nv < 1 || segs.count() < 2) return nil
    self._lastColorId = nil
    var cid = nil
    if (alpha < 0.999) {
      cid = self.addRgb(self.pointLineRgb(item), alpha, out)
      self._lastColorId = cid
      out.write("C ${cid}")
      out.write("o ${id}")
      self.pointLineVertexData(item, out, includeColor=false)
    } else {
      out.write("o ${id}")
      self.pointLineVertexData(item, out, includeColor=true)
    }
    var lline = "l"
    for (i in 0...segs.count()) lline += " ${segs[i]}"
    out.write(lline)
    return id
  }

  visit(PointCloud item, out) {
    out.write("M flat")
    var id = self.definePointCloud(item, out)
    if (isnil(id)) { out.write("M shaded"); return }
    self._recordObject(id, colorId=self._lastColorId, flat=true)
    self.emitEntryDraw(self._drawEntry(item), out, viewerId=id)
    out.write("M shaded")
  }

  visit(LineSet item, out) {
    out.write("M flat")
    var id = self.defineLineSet(item, out)
    if (isnil(id)) { out.write("M shaded"); return }
    self._recordObject(id, colorId=self._lastColorId, flat=true)
    self.emitEntryDraw(self._drawEntry(item), out, viewerId=id)
    out.write("M shaded")
  }

  fontPath() {
    var platform = System.platform()
    if (platform=="macos") {
      return ["/System/Library/Fonts"]
    } else if (platform=="windows") {
      return ["C:/Windows/Fonts"]
    } else return ["/usr/share/fonts","/usr/local/share/fonts"]
  }

  matchFontFile(file, font) {
    var fname = file.split(".")
    if (fname[0]==font &&
        (fname[1]=="ttc" || fname[1]=="ttf")) return true
    return false
  }

  searchFontFolder(folder, font) {
    for (f in Folder.contents(folder)) {
      var path = folder + "/" + f
      if (self.matchFontFile(f, font)) return path

      if (Folder.isFolder(path)) { // Recurse
        var result = self.searchFontFolder(path, font)
        if (result) return result
      }
    }
    return nil
  }

  findFont(font) {
    var base = self.fontPath()
    for (f in base) {
      var found = self.searchFontFolder(f, font)
      if (found) return found
    }
    return nil
  }

  defaultFontName() {
    var platform = System.platform()
    if (platform=="macos") {
      return "Helvetica"
    } else if (platform=="windows") {
      return "arial" // Note case sensitive
    } else return "FreeSans"
  }

  addColor(color, out) {
    if (!self.colors.contains(color)) {
      var id = self.colors[color] = self.colors.count()
      out.write("c ${id} ${self.fmt(color.r)} ${self.fmt(color.g)} ${self.fmt(color.b)}")
    }
    return self.colors[color]
  }

  addFont(font, size, out) {
    var path = self.findFont(font)
    if (!path) _fntntfnd.throw()
    var id = self.uid()
    var fnt = Font(font, size, id=id)
    self.fonts.append(fnt)

    out.write("F ${id} \"${path}\" ${size}")
    return id
  }

  findFontId(font, size, out) {
    for (f in self.fonts) {
      if (f.name == font && f.size == size) return f.id
    }
    return self.addFont(font, size, out)
  }

  visit(Text item, out) {
    var font = item.font
    if (!font) font = self.defaultFontName()
    var id = self.findFontId(font, item.size, out)

    if (item.color) {
      var id = self.addColor(item.color, out)
      out.write("C ${id}")
    }

    out.write("i")
    var m = item.transformationmatrix()
    if (m) {
      var str = "m"
      for (i in 0..3) for (j in 0..3) str+=" "+self.fmt(m[i,j])
      out.write(str)
    }
    out.write("t ${self.fmt(item.posn[0])} ${self.fmt(item.posn[1])} ${self.fmt(item.posn[2])}")
    out.write("T ${id} \"${item.string}\"")
  }

  write(graphic, out) {
    self.preamble(graphic, out)
    self.objectMap = Dictionary()
    self.entryColorId = Dictionary()
    self.flatIds = Dictionary()
    self.vertexLayout = Dictionary()
    self.meshCache = Dictionary()

    for (entry in graphic.displaylist) {
      self.visitEntry(entry, entry.item, out)
    }
  }

  /** Define + draw a single entry (mid-session `defined`); updates object maps. */
  writeEntry(entry, out) {
    self.visitEntry(entry, entry.item, out)
  }

  /** Default: world-baked item, identity draw (Cylinder/Arrow/Text/…). */
  visitEntry(entry, item, out) {
    self._currentEntry = entry
    self.visit(item, out)
    self._currentEntry = nil
  }

  /** Unit sphere mesh (cached by refine level) + entry SRT + `C` color. */
  visitEntry(entry, Sphere item, out) {
    self._currentEntry = entry
    var n = item.refinementlevel(entry.scale)
    var key = "sphere:${n}"
    var vid
    if (self.meshCache.contains(key)) {
      vid = self.meshCache[key]
    } else {
      var tri = item.totrianglecomplex(scale=false, radiusForRefine=entry.scale)
      if (!isnil(item.filter)) tri.filter = item.filter
      if (!isnil(item.transmit)) tri.transmit = item.transmit
      vid = self.defineXnTriangleComplex(tri, out)
      self.meshCache[key] = vid
    }
    var alpha = self.opacity(item)
    var cid = self.addRgb(self.entryRgb(entry), alpha, out)
    out.write("C ${cid}")
    self._recordObject(vid, colorId=cid)
    self.emitEntryDraw(entry, out, viewerId=vid)
    self._currentEntry = nil
  }

  /** PointCloud: define once, draw with entry SRT. */
  visitEntry(entry, PointCloud item, out) {
    self._currentEntry = entry
    out.write("M flat")
    var vid = self.definePointCloud(item, out)
    if (!isnil(vid)) {
      self._recordObject(vid, colorId=self._lastColorId, flat=true)
      self.emitEntryDraw(entry, out, viewerId=vid)
    }
    out.write("M shaded")
    self._currentEntry = nil
  }

  /** LineSet: define once, draw with entry SRT. */
  visitEntry(entry, LineSet item, out) {
    self._currentEntry = entry
    out.write("M flat")
    var vid = self.defineLineSet(item, out)
    if (!isnil(vid)) {
      self._recordObject(vid, colorId=self._lastColorId, flat=true)
      self.emitEntryDraw(entry, out, viewerId=vid)
    }
    out.write("M shaded")
    self._currentEntry = nil
  }

  /** TriangleComplex: define once for this write, draw with entry SRT.
   *  Set `entry.flat = true` (after display) for unlit solid facet colors. */
  visitEntry(entry, TriangleComplex item, out) {
    self._currentEntry = entry
    var flat = entry.flat
    if (flat) out.write("M flat")
    var vid = self.defineTriangleComplex(item, out)
    self._recordObject(vid, colorId=self._lastColorId, flat=flat)
    self.emitEntryDraw(entry, out, viewerId=vid)
    if (flat) out.write("M shaded")
    self._currentEntry = nil
  }
}
