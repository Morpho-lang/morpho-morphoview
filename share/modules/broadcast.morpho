/** Broadcaster / Listener
 *
 *    class Hub with Broadcaster { ... }
 *    class Sink with Listener { ... }
 *
 *    sink.listen(hub)
 *    hub.notify(event)          // → sink.receive(hub, event)
 *    sink.ignore(hub)
 *
 *  Nested batches coalesce same-key events before delivery:
 *
 *    hub.beginBatch()
 *    hub.notify(ev1)
 *    hub.notify(ev2)
 *    hub.endBatch()             // flush once
 *
 *  Mix in BroadcastEvent so batched events can expose batchKey / coalesce.
 */

/** Defaults: no coalesce. Override batchKey (non-nil) and coalesce as needed. */
class BroadcastEvent {
  batchKey() { return nil }
  coalesce(prev) { }
}

class Broadcaster {
  _broadcasterInit() {
    self.listeners = []
    self._batchDepth = 0
    self._pending = []       // delivery order (non-keyed + first-seen keys)
    self._pendingByKey = Dictionary()  // batchKey → event (keyed coalesce)
  }

  subscribe(listener) {
    if (!self.listeners.contains(listener)) self.listeners.append(listener)
  }

  unsubscribe(listener) {
    self.listeners.remove(listener)
  }

  beginBatch() {
    self._batchDepth += 1
  }

  /** Flush pending when outermost batch ends. Nested notify during flush is
   *  re-queued (depth held > 0) and drained before returning. */
  endBatch() {
    if (self._batchDepth <= 0) return
    self._batchDepth -= 1
    if (self._batchDepth > 0) return
    while (self._pending.count() > 0) {
      var pending = self._pending
      self._pending = []
      self._pendingByKey = Dictionary()
      self._batchDepth += 1
      for (event in pending) {
        self._deliver(event)
      }
      self._batchDepth -= 1
    }
  }

  /** Queue while batching; deliver immediately otherwise.
   *  Events use BroadcastEvent: nil batchKey → append; non-nil → replace by key. */
  notify(event) {
    if (self._batchDepth > 0) {
      var key = event.batchKey()
      if (isnil(key)) {
        self._pending.append(event)
      } else if (self._pendingByKey.contains(key)) {
        var prev = self._pendingByKey[key]
        event.coalesce(prev)
        self._pendingByKey[key] = event
        for (i in 0...self._pending.count()) {
          if (self._pending[i] == prev) {
            self._pending[i] = event
            break
          }
        }
      } else {
        self._pendingByKey[key] = event
        self._pending.append(event)
      }
    } else {
      self._deliver(event)
    }
  }

  /** Snapshot listeners so receive may subscribe/unsubscribe safely. */
  _deliver(event) {
    var ls = self.listeners.clone()
    for (l in ls) {
      l.receive(self, event)
    }
  }
}

class Listener {
  listen(broadcaster) {
    broadcaster.subscribe(self)
  }

  ignore(broadcaster) {
    broadcaster.unsubscribe(self)
  }

  receive(broadcaster, event) { }
}
