/** Broadcaster / Listener
 *
 *    class Hub with Broadcaster { ... }
 *    class Sink with Listener { ... }
 *
 *    sink.listen(hub)
 *    hub.notify(event)          // → sink.receive(hub, event)
 *    sink.ignore(hub)
 *
 *  Nested batches coalesce same-key events before delivery:
 *
 *    hub.beginBatch()
 *    hub.notify(ev1)
 *    hub.notify(ev2)
 *    hub.endBatch()             // flush once
 *
 *  Mix in BroadcastEvent so batched events can expose batchKey / coalesce.
 */

/** Defaults: no coalesce. Override batchKey (non-nil) and coalesce as needed. */
class BroadcastEvent {
  batchKey() { return nil }
  coalesce(prev) { }
}

class Broadcaster {
  _broadcasterInit() {
    self.listeners = []
    self._batchDepth = 0
    self._pending = []
  }

  subscribe(listener) {
    for (l in self.listeners) {
      if (l == listener) return
    }
    self.listeners.append(listener)
  }

  unsubscribe(listener) {
    var out = []
    for (l in self.listeners) {
      if (l != listener) out.append(l)
    }
    self.listeners = out
  }

  beginBatch() {
    self._batchDepth += 1
  }

  endBatch() {
    if (self._batchDepth <= 0) return
    self._batchDepth -= 1
    if (self._batchDepth > 0) return
    var pending = self._pending
    self._pending = []
    for (event in pending) {
      self._deliver(event)
    }
  }

  /** Queue while batching; deliver immediately otherwise. */
  notify(event) {
    if (self._batchDepth > 0) {
      if (!event.respondsto("batchKey")) {
        self._pending.append(event)
      } else {
        var key = event.batchKey()
        if (isnil(key)) {
          self._pending.append(event)
        } else {
          var out = []
          var prev = nil
          for (e in self._pending) {
            if (e.respondsto("batchKey") && e.batchKey() == key) {
              prev = e
            } else {
              out.append(e)
            }
          }
          if (!isnil(prev)) event.coalesce(prev)
          out.append(event)
          self._pending = out
        }
      }
    } else {
      self._deliver(event)
    }
  }

  _deliver(event) {
    for (l in self.listeners) {
      l.receive(self, event)
    }
  }
}

class Listener {
  listen(broadcaster) {
    broadcaster.subscribe(self)
  }

  ignore(broadcaster) {
    broadcaster.unsubscribe(self)
  }

  receive(broadcaster, event) { }
}
