/* *******************************************************************************************
 * POV-Ray
 * *******************************************************************************************
 * Ray-trace an xgraphics Graphics/Scene with POV-Ray.
 * Displaylists contain GraphicsEntry objects with GraphicsPrimitives.
 *
 * Public: Camera, POVRaytracer, write, render, visit.
 ******************************************************************************************* */

import constants
import xgraphics
import xcolor
import xfonts

var _PovExecErr = Error("PovExec", "Could not run POV-Ray.")
var _PovLightRig = Error("PovLightRig",
  "Could not form a camera frame for named lighting; emitting no lights (ambient only).")
var _warnedLightRig = false
// [Compatibility shim]
var _PovLegacyCam = Error("PovLegacyCam",
  "POVRaytracer.viewpoint/viewangle/light/look_at/sky/width/height/antialias are mirrored onto camera. Prefer pov.camera.*.")
var _warnedLegacyCam = false

fn _num(x) { return (abs(x) < 1e-12) ? 0 : x }

fn _povVector(v) {
  if (v.count() < 3) return "<${_num(v[0])}, ${_num(v[1])}, 0>"
  return "<${_num(v[0])}, ${_num(v[1])}, ${_num(v[2])}>"
}

fn _povMatrix(R) {
  return "matrix <${_num(R[0,0])}, ${_num(R[1,0])}, ${_num(R[2,0])}, ${_num(R[0,1])}, ${_num(R[1,1])}, ${_num(R[2,1])}, ${_num(R[0,2])}, ${_num(R[1,2])}, ${_num(R[2,2])}, 0, 0, 0>"
}

/** Escape `\` and `"` for POV quoted strings.
 *  Keep in sync with xshow `_mvEscape`. */
fn _povEscape(s) {
  var out = ""
  var n = s.count()
  for (i in 0...n) {
    var ch = s.substring(i, i+1)
    if (ch == "\\" || ch == "\"") out += "\\"
    out += ch
  }
  return out
}

/** Quote a path for a shell command string (not POV source). */
fn _shellQuote(s) {
  var out = ""
  var n = s.count()
  for (i in 0...n) {
    var ch = s.substring(i, i+1)
    if (ch == "\\" || ch == "\"" || ch == "$" || ch == "`") out += "\\"
    out += ch
  }
  return out
}

fn _pngPath(path) {
  var n = path.count()
  if (n >= 4) {
    var ext = path.substring(n-4, n)
    if (ext == ".pov" || ext == ".POV") return path.substring(0, n-4) + ".png"
  }
  return path + ".png"
}

/** View-space axes matching MorphoView: +X right, +Y up, +Z toward the camera. */
fn _povCameraAxes(cam) {
  var z = cam.viewpoint - cam.look_at
  var zn = z.norm()
  if (!(zn > 1e-12)) return nil
  z = z/zn
  var y = cam.sky - z*cam.sky.inner(z)
  var yn = y.norm()
  if (!(yn > 1e-12)) return nil
  y = y/yn
  return (cross3D(y, z), y, z)
}

/** Named rig as distant point lights in the POV camera frame. Empty if the frame fails. */
fn _povNamedRig(cam, name) {
  var axes = _povCameraAxes(cam)
  if (isnil(axes)) {
    if (!_warnedLightRig) {
      _warnedLightRig = true
      _PovLightRig.warning()
    }
    return []
  }
  var x = axes[0], y = axes[1], z = axes[2]
  var specs
  if (name == "threepoint") {
    specs = [
      (Matrix([0.5, 0.5, 1.5]), 0.85),
      (Matrix([-1.5, -2.5, 1.5]), 0.40),
      (Matrix([0.0, 1.5, -1.5]), 0.10)
    ]
  } else {
    specs = [
      (Matrix([1.5, -0.5, 1.5]), 0.40),
      (Matrix([1.5, 1.5, 1.5]), 0.40),
      (Matrix([-0.5, 1.5, 1.5]), 0.40)
    ]
  }
  var out = []
  for (s in specs) {
    var d = s[0]
    var dir = x*d[0] + y*d[1] + z*d[2]
    var n = dir.norm()
    if (!(n > 1e-12)) continue
    out.append((cam.look_at + 100*(dir/n), s[1]))
  }
  return out
}

class Camera {
  init(antialias=true, width=2048, height=1536, viewangle=24,
       viewpoint=nil, look_at=nil, sky=nil) {
    self.antialias = antialias
    self.width = width
    self.height = height
    self.viewangle = viewangle
    self.viewpoint = viewpoint
    self.look_at = look_at
    self.sky = sky
    self.light = nil
    if (!self.viewpoint) self.viewpoint = Matrix([0, 0, 5])
    if (!self.look_at) self.look_at = Matrix([0, 0, 0])
    if (!self.sky) self.sky = Matrix([0, 1, 0])
  }
}

class POVRaytracer {
  init(graphic, camera=nil) {
    self.graphic = graphic
    self.camera = isnil(camera) ? Camera() : camera
    self.pointradius = 0.02
    self.lineradius = 0.01
    self._fonts = Dictionary()
  }

  // Morpho optionals are keyword-only; this required-arg overload is `POVRaytracer(g, cam)`.
  init(graphic, camera) {
    self.graphic = graphic
    self.camera = camera
    self.pointradius = 0.02
    self.lineradius = 0.01
    self._fonts = Dictionary()
  }

  // [Compatibility shim] Old POVRaytracer copied Camera fields onto the tracer;
  // callers set pov.viewpoint = … before write/render. Sync onto camera once per write.
  _legacyCamera() {
    var cam = self.camera
    var used = false
    if (self.has("viewpoint")) { cam.viewpoint = self.viewpoint; used = true }
    if (self.has("viewangle")) { cam.viewangle = self.viewangle; used = true }
    if (self.has("look_at")) { cam.look_at = self.look_at; used = true }
    if (self.has("sky")) { cam.sky = self.sky; used = true }
    if (self.has("light")) { cam.light = self.light; used = true }
    if (self.has("width")) { cam.width = self.width; used = true }
    if (self.has("height")) { cam.height = self.height; used = true }
    if (self.has("antialias")) { cam.antialias = self.antialias; used = true }
    if (used && !_warnedLegacyCam) {
      _warnedLegacyCam = true
      _PovLegacyCam.warning("Deprecated POVRaytracer.viewpoint (and related fields). Use pov.camera.viewpoint instead.")
    }
    return cam
  }

  _pigment(Coloring col, i) {
    var t = col.rgba(i)
    var a = t[3]
    if (a < 0.999) {
      return "pigment { rgbt <${t[0]}, ${t[1]}, ${t[2]}, ${1-a}> }"
    }
    return "pigment { rgb <${t[0]}, ${t[1]}, ${t[2]}> }"
  }
  _pigment(Coloring col) { return self._pigment(col, 0) }

  _finish(flat) { return flat ? " finish { ambient 1 diffuse 0 }" : "" }

  _texture(col, flat) {
    return "texture { ${self._pigment(col)}${self._finish(flat)} }"
  }

  _skin(entry) {
    return self._texture(entry.effectiveColor(), entry.flat)
  }

  _wrap(entry) {
    var s = ""
    var scl = entry.scale
    if (ismatrix(scl) || islist(scl)) s += " scale ${_povVector(scl)}"
    else if (!isnil(scl) && scl != 1) s += " scale ${scl}"
    var R = entry.rotationMatrix()
    if (!isnil(R)) s += " ${_povMatrix(R)}"
    var p = entry.position
    if (!isnil(p) && !(p[0] == 0 && p[1] == 0 && p[2] == 0)) {
      s += " translate ${_povVector(p)}"
    }
    return s
  }

  visit(entry, Sphere item, out) {
    out.write("sphere { <0, 0, 0>, 1 ${self._skin(entry)}${self._wrap(entry)} }")
  }

  visit(entry, Cylinder item, out) {
    out.write("cylinder { <0, 0, 0>, <0, 0, 1>, 1 ${self._skin(entry)}${self._wrap(entry)} }")
  }

  visit(entry, Arrow item, out) {
    var h = 1 - item.aspectratio, sk = self._skin(entry)
    out.write("union {")
    out.write("  cylinder { <0, 0, 0>, <0, 0, ${h}>, 1 ${sk} }")
    out.write("  cone { <0, 0, ${h}>, 2, <0, 0, 1>, 0 ${sk} }")
    out.write("${self._wrap(entry)}")
    out.write("}")
  }

  visit(entry, TriangleComplex item, out) {
    self._mesh(entry, item, out)
  }

  visit(entry, Tube item, out) {
    self._sweep(item, self._skin(entry), self._wrap(entry), out)
  }

  visit(entry, PointCloud item, out) {
    self._points(item, entry.effectiveColor(), entry.flat, self._wrap(entry), out)
  }

  visit(entry, LineSet item, out) {
    self._lines(item, entry.effectiveColor(), entry.flat, self._wrap(entry), out)
  }

  visit(entry, Text item, out) {
    self._text(item, self._skin(entry), self._orient(item) + self._wrap(entry), out)
  }

  visit(entry, GraphicsPrimitive item, out) {
    var tri = item.toTriangleComplex()
    if (!isnil(tri)) self._mesh(entry, tri, out)
  }

  _perVertex(ColorTable col) { return true }
  _perVertex(Coloring col) { return false }
  _perVertex(col) { return false }

  _mesh(entry, item, out) {
    var col = entry.effectiveColor()
    var skin = self._skin(entry)
    var tail = self._wrap(entry)
    var flat = entry.flat
    var nv = item.position.dimensions()[1]
    var nf = item.connectivity.dimensions()[1]
    var per = self._perVertex(col)
    out.write("mesh2 {")
    out.write("  vertex_vectors { ${nv},")
    for (i in 0...nv) {
      out.write("${(i > 0) ? ", " : ""}${_povVector(item.position.column(i))}")
    }
    out.write("}")
    out.write("  normal_vectors { ${nv},")
    for (i in 0...nv) {
      out.write("${(i > 0) ? ", " : ""}${_povVector(item.normals.column(i))}")
    }
    out.write("}")
    if (per) {
      var fin = self._finish(flat)
      out.write("  texture_list { ${nv},")
      for (i in 0...nv) {
        out.write("${(i > 0) ? ", " : ""}texture { ${self._pigment(col, i)}${fin} }")
      }
      out.write("}")
    }
    out.write("  face_indices { ${nf},")
    for (i in 0...nf) {
      var idx = item.faceIndices(i)
      var s = _povVector(idx)
      if (per) s += ", ${idx[0]}, ${idx[1]}, ${idx[2]}"
      out.write("${(i > 0) ? ", " : ""}${s}")
    }
    out.write("}")
    if (!per) out.write("  ${skin}")
    if (tail.count() > 0) out.write(" ${tail}")
    out.write("}")
  }

  _sweep(item, skin, tail, out) {
    var mat = asVertexMatrix(item.pts)
    var np = mat.dimensions()[1]
    if (np < 2) return
    var n = item.closed ? np + 1 : np
    out.write("sphere_sweep { linear_spline ${n},")
    for (i in 0...n) {
      out.write("${(i > 0) ? "," : ""} ${_povVector(mat.column(i < np ? i : 0))}, ${item.radius}")
    }
    out.write(" ${skin}${tail} }")
  }

  _grouped(tail, out, body) {
    if (tail.count() > 0) out.write("union {")
    body()
    if (tail.count() > 0) out.write("${tail} }")
  }

  _points(item, col, flat, tail, out) {
    var nv = item.position.dimensions()[1]
    if (nv < 1) return
    var per = self._perVertex(col)
    self._grouped(tail, out, fn () {
      for (i in 0...nv) {
        var c = per ? col.color(i) : col
        out.write("sphere { ${_povVector(item.position.column(i))}, ${self.pointradius} ${self._texture(c, flat)} }")
      }
    })
  }

  _lines(item, col, flat, tail, out) {
    var segs = item._segmentIndices()
    if (segs.count() < 2) return
    var per = self._perVertex(col)
    self._grouped(tail, out, fn () {
      for (k in 0...segs.count():2) {
        var i = segs[k], j = segs[k+1]
        var c = per ? col.color(i) : col
        out.write("cylinder { ${_povVector(item.position.column(i))}, ${_povVector(item.position.column(j))}, ${self.lineradius} ${self._texture(c, flat)} }")
      }
    })
  }

  _orient(item) {
    var m = item.transformationMatrix()
    if (isnil(m)) return ""
    var s = " matrix <"
    for (i in 0..3) {
      for (j in 0..2) {
        if (!(i == 0 && j == 0)) s += ", "
        s += "${_num(m[i,j])}"
      }
    }
    return s + ">"
  }

  _text(item, skin, tail, out) {
    out.write("text { ttf \"${_povEscape(self._fontPath(item))}\" \"${_povEscape(item.string)}\" 0.1, 0")
    out.write("  ${skin}")
    out.write("  scale ${item.size/75}${tail} }")
  }

  _fontPath(item) {
    var font = item.font
    if (isnil(font) || !font) return "cyrvetic.ttf"
    if (self._fonts.contains(font)) return self._fonts[font]
    var found = FontFinder().find(font)
    self._fonts[font] = isnil(found) ? font : found
    return self._fonts[font]
  }

  _backgroundAlpha(transparent) {
    if (transparent) return 0
    var col = self.graphic.background
    if (isnil(col)) return 1
    return col.alpha(0)
  }

  _writeBackground(out, transparent) {
    var col = self.graphic.background
    if (isnil(col)) col = Black
    var t = col.rgb(0)
    var a = self._backgroundAlpha(transparent)
    if (a < 0.999) {
      out.write("background { rgbt <${t[0]}, ${t[1]}, ${t[2]}, ${1-a}> }")
    } else {
      out.write("background { rgb ${_povVector(t)} }")
    }
  }

  _writeCamera(out) {
    var cam = self.camera
    var aspect = cam.width / cam.height
    out.write("camera {")
    out.write("  location ${_povVector(cam.viewpoint)}")
    out.write("  up <0, 1, 0> right <-${aspect}, 0, 0> angle ${cam.viewangle}")
    out.write("  look_at ${_povVector(cam.look_at)} sky ${_povVector(cam.sky)}")
    out.write("}")
  }

  _writeNamedRig(out, sl, name) {
    for (lamp in _povNamedRig(self.camera, name)) {
      var c = lamp[1]
      out.write("light_source { ${_povVector(lamp[0])} color rgb <${c}, ${c}, ${c}>${sl} }")
    }
  }

  _writeLightVal(String name, out, sl) {
    self._writeNamedRig(out, sl, (asLightName(name) == "threepoint") ? "threepoint" : "neutral")
  }
  _writeLightVal(List L, out, sl) {
    for (p in asLightPositions(L)) {
      out.write("light_source { ${_povVector(p)} color White${sl} }")
    }
  }
  _writeLightVal(Matrix p, out, sl) { self._writeLightVal(asLightPositions(p), out, sl) }
  _writeLightVal(Tuple t, out, sl) { self._writeLightVal(asLightPositions(t), out, sl) }
  _writeLightVal(val, out, sl) { self._writeNamedRig(out, sl, "neutral") }

  _writeLights(out, shadowless) {
    var sl = shadowless ? " shadowless" : ""
    var lights = isnil(self.camera.light) ? self.graphic.light : self.camera.light
    self._writeLightVal(lights, out, sl)
  }

  write(file, transparent=false, shadowless=false) {
    self._legacyCamera()
    var out = File(file, "write")
    out.write("#include \"colors.inc\"")
    self._writeBackground(out, transparent)
    self._writeCamera(out)
    for (el in self.graphic.displaylist) {
      self.visit(el, el.item, out)
    }
    self._writeLights(out, shadowless)
    out.close()
    return out.relativepath()
  }

  _openImage(png) {
    var p = System.platform()
    var escaped = _shellQuote(png)
    if (p == "macos") system("open \"${escaped}\"")
    else if (p == "windows") system("powershell -Command \"Start-Process '${escaped}'\"")
    else system("xdg-open \"${escaped}\"")
  }

  _renderFlags(transparent, display) {
    var cam = self.camera
    var flags = "+W${cam.width} +H${cam.height}"
    if (!display) flags += " -D"
    if (cam.antialias) flags += " +A"
    if (self._backgroundAlpha(transparent) < 0.999) flags += " +UA"
    return flags
  }

  render(file, quiet=false, display=true, shadowless=false, transparent=false) {
    var path = self.write(file, transparent=transparent, shadowless=shadowless)
    var flags = self._renderFlags(transparent, display)
    var result
    try {
      result = System.subprocess("povray \"${_shellQuote(path)}\" ${flags}")
    } catch {
      "SystmPOpnFld": _PovExecErr.throw()
    }
    if (!quiet && !isnil(result["stdout"])) print result["stdout"]
    if (result["exitstatus"] != 0) _PovExecErr.warning()
    if (!quiet && display) self._openImage(_pngPath(path))
  }
}
