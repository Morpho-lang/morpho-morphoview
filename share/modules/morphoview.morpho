/** Live morphoview session over ZMQ PAIR.
 *
 *  Unlike Show(g) (temp file + morphoview -t), View keeps a duplex channel.
 *  Drive it with poll / System.sleep — Morpho has no async runtime.
 *
 *    var v = View(scene)            // open + listen
 *    v.open(commands)               // or ASCII chunk
 *    scene.move(id, ...)            // → pose-only d / C
 *    v.morph(id, item)              // same-length U V (vs replace)
 *    v.poll(timeoutms=0)
 *    v.wait(sessiontimeout=1500)
 *    v.close()
 *
 *  Requires morpho-zeromq.
 */

import zeromq
import xgraphics
import broadcast

var _vwopnfl = Error("VwOpnFl", "View failed to open morphoview session.")
var _vwemitfl = Error("VwEmitFl", "View failed to emit commands to morphoview.")

/** Pairwise-merge join — O(n log n) copies vs O(n²) for repeated String +=. */
fn _joinLines(lines) {
  if (lines.count() == 0) return ""
  var cur = lines
  while (cur.count() > 1) {
    var nxt = []
    var i = 0
    while (i < cur.count()) {
      if (i + 1 < cur.count()) {
        nxt.append(String(cur[i], cur[i + 1]))
        i += 2
      } else {
        nxt.append(cur[i])
        i += 1
      }
    }
    cur = nxt
  }
  return cur[0]
}

class View with Listener {
  init(connecttimeout=5000, pollms=100) {
    self.connecttimeout = connecttimeout
    self.pollms = pollms
    self.sock = nil
    self.ep = nil
    self.poller = nil
    self.closed = true
    self.gotOk = false
    self.cmdLines = []
    self.graphics = nil
    self.show = nil
  }

  /** Open immediately; throws if the session cannot start. */
  init(Graphics g, connecttimeout=5000, pollms=100) {
    self.init(connecttimeout=connecttimeout, pollms=pollms)
    if (!self.open(g)) _vwopnfl.throw()
  }

  /** Show.write sink — buffers lines; joined once at send. */
  write(line) {
    self.cmdLines.append("${line}\n")
  }

  _takeCommands() {
    var s = _joinLines(self.cmdLines)
    self.cmdLines = []
    return s
  }

  _sendWait(commands) {
    self.gotOk = false
    self._send(commands)
    return self._waitOk()
  }

  /** Bind, spawn viewer, send first chunk, wait for ok. */
  open(commands) {
    if (!isnil(self.sock)) {
      print "morphoview: View already open"
      return false
    }
    self._bind()
    self._spawn()
    self.poller = ZMQPoller(self.sock)
    self.closed = false
    return self._sendWait(commands)
  }

  open(Graphics g) { return self._applyModel(g) }

  open(Scene g) {
    var ok = self._applyModel(g)
    if (ok) self.listen(g)
    return ok
  }

  update(commands) {
    if (self.closed) return false
    return self._sendWait(commands)
  }

  update(Graphics g) { return self._applyModel(g, replace=true) }

  update(Scene g) {
    var ok = self._applyModel(g, replace=true)
    if (ok) self.listen(g)
    return ok
  }

  /** Serialize then open/update; commit model only after success. */
  _applyModel(Graphics g, replace=false) {
    if (replace && self.closed) return false
    var show = Show()
    if (replace) show.replace = true
    self.cmdLines = []
    show.write(g, self)
    var ok = false
    if (replace) ok = self.update(self._takeCommands())
    else ok = self.open(self._takeCommands())
    if (ok) {
      if (!isnil(self.graphics)) self._detach(self.graphics)
      self.show = show
      self.graphics = g
    }
    return ok
  }

  _detach(Graphics g) { }
  _detach(Scene g) { self.ignore(g) }

  /** Clear draws (D) and re-issue draw ASCII without U S. */
  redraw(commands) {
    if (self.closed) return false
    var body = commands
    if (isnil(body)) body = ""
    if (body.count() == 0 || body[0] != "D") body = "D\n${body}"
    return self._sendWait(body)
  }

  _live() { return !self.closed && !isnil(self.show) }

  _ids(ev) {
    if (isnil(ev.ids) || ev.ids.count() == 0) return [ev.id]
    return ev.ids
  }

  receive(Graphics g, GraphicsEventDefined ev) {
    if (!self._live()) return
    var entry = g.findEntry(ev.id)
    if (isnil(entry)) return
    self._tryEmit("defined id ${ev.id}", fn () { self.show.writeEntry(entry, self) })
  }

  receive(Graphics g, GraphicsEventMoved ev) {
    if (!self._live()) return
    self._tryEmit("moved", fn () {
      for (id in self._ids(ev)) self.show.emitEntryPose(g, id, self)
    })
  }

  receive(Graphics g, GraphicsEventRecolored ev) {
    if (!self._live()) return
    self._tryEmit("recolored", fn () {
      for (id in self._ids(ev)) self.show.emitEntryRecolor(g, id, self)
    })
  }

  receive(Graphics g, GraphicsEventRemoved ev) {
    if (!self._live()) return
    self._tryEmit("removed id ${ev.id}", fn () { self.show.emitEntryRemove(ev.id, self) })
  }

  receive(Graphics g, GraphicsEventReplaced ev) {
    if (!self._live()) return
    self._tryEmit("replaced id ${ev.id}", fn () {
      if (!self.show.emitEntryReplace(g, ev.id, self)) return
    })
  }

  /** Run @p emit into the buffer; send if non-empty. Warn on transport failure. */
  _tryEmit(label, emit) {
    self.cmdLines = []
    emit()
    if (self.cmdLines.count() == 0) return
    if (!self._sendWait(self._takeCommands())) _vwemitfl.warning("failed to emit ${label}")
  }

  /** Run @p emit into the buffer; send if non-empty and wait for ok. */
  _emitAndWait(emit) {
    self.cmdLines = []
    emit()
    if (self.cmdLines.count() == 0) return false
    return self._sendWait(self._takeCommands())
  }

  /** Swap item and push same-length vertices (U V). Use replace for new connectivity. */
  morph(graphicsId, item) {
    if (self.closed || isnil(self.graphics)) return false
    if (!self.graphics.morph(graphicsId, item)) return false
    return self.refreshMesh(graphicsId)
  }

  /** Push U V for a TriangleComplex entry (layout must match define: xn / xnc). */
  refreshMesh(graphicsId) {
    if (self.closed || isnil(self.show) || isnil(self.graphics)) return false
    return self._emitAndWait(fn () {
      if (!self.show.emitEntryVertices(self.graphics, graphicsId, self)) return
    })
  }

  /** One reply, or nil on timeout. poll(timeoutms=0) is non-blocking. */
  poll(timeoutms=nil) {
    if (self.closed || isnil(self.poller)) return nil
    var t = self.pollms
    if (!isnil(timeoutms)) t = timeoutms
    if (!self.poller.wait(t)) return nil
    return self._handle(self.sock.receive())
  }

  /** Spin until the window closes, or sessiontimeout ms (0 = forever). */
  wait(sessiontimeout=0) {
    var waited = 0
    while (!self.closed) {
      self.poll(timeoutms=self.pollms)
      if (self.closed) break
      if (sessiontimeout > 0) {
        waited += self.pollms
        if (waited >= sessiontimeout) {
          self.close()
          break
        }
      }
    }
  }

  /** Stop the viewer; idempotent. Prefers Q, then process kill. */
  close() {
    if (!isnil(self.graphics)) self._detach(self.graphics)
    self.graphics = nil
    self.show = nil
    if (isnil(self.sock)) {
      self.closed = true
      return
    }
    if (!self.closed) {
      self._send("Q")
      var waited = 0
      while (!self.closed && waited < self.connecttimeout) {
        self.poll(timeoutms=self.pollms)
        if (self.closed) break
        waited += self.pollms
      }
    }
    if (!self.closed) self._kill()
    self._resetTransport()
  }

  /** Drop ZMQ state so a later open() is not blocked by a stale sock. */
  _resetTransport() {
    self.closed = true
    if (!isnil(self.sock)) self.sock.unbind()
    self.sock = nil
    self.ep = nil
    self.poller = nil
    self.cmdLines = []
  }

  _bind() {
    self.sock = ZMQPair()
    self.sock.bind("tcp://127.0.0.1:!")
    self.ep = self.sock.endpoint()
  }

  _spawn() {
    var bin = _morphoViewBin()
    if (System.platform()=="windows") {
      system("powershell -Command \"Start-Process '${bin}' -ArgumentList '-c', '${self.ep}'\"")
    } else {
      system("\"${bin}\" -c \"${self.ep}\" > /dev/null 2>&1 &")
    }
  }

  _send(commands) { self.sock.send(commands) }

  _waitOk() {
    var waited = 0
    while (!self.closed && !self.gotOk) {
      self.poll(timeoutms=self.pollms)
      if (self.gotOk) return true
      if (self.closed) {
        self._resetTransport()
        return false
      }
      waited += self.pollms
      if (waited >= self.connecttimeout) {
        print "morphoview: timed out waiting for ok"
        self._kill()
        self._resetTransport()
        return false
      }
    }
    return self.gotOk
  }

  _handle(msg) {
    if (!isstring(msg)) {
      self.closed = true
      return nil
    }
    if (msg == "ok") {
      self.gotOk = true
    } else if (msg == "window.closed") {
      self.closed = true
    } else if (msg.count() >= 3 && msg.substring(0, 3) == "err") {
      print "morphoview: ${msg}"
      self._kill()
      self.closed = true
    }
    return msg
  }

  /** Best-effort kill of the morphoview peer for this endpoint. */
  _kill() {
    if (isnil(self.ep)) return
    if (System.platform()=="windows") {
      system("powershell -Command \"Get-CimInstance Win32_Process | Where-Object { $_.Name -match 'morphoview' -and $_.CommandLine -like '*-c*${self.ep}*' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force }\"")
    } else {
      system("pkill -f \"morphoview -c ${self.ep}\" > /dev/null 2>&1")
    }
  }
}
