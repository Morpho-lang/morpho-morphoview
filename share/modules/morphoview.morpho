/** MorphoView live session helper.
 *
 *  `View` is a duplex ZMQ PAIR session with morphoview (distinct from
 *  fire-and-forget `Show(g)` in xgraphics, which writes a temp file and
 *  launches `-t`).
 *
 *  Morpho has no async runtime: keep the channel open and drive the loop
 *  with `poll` / `System.sleep`, or use `wait` as a convenience.
 *
 *    var v = View()
 *    v.open(commands)           // ASCII string
 *    v.open(g)                  // Graphics or Scene: Show.write once
 *    var v = View(scene)        // live: open Scene, then listen for move/recolor
 *    v.update(morecommands)     // e.g. chunk starting with `U S <id>`
 *    v.update(g)                // Graphics/Scene replace via `U S` + rebind
 *    v.redraw(posecommands)     // `D` + redraw draws (no geometry wipe)
 *    // After View(scene): scene.move / recolor drive pose-only `d` / `C`
 *    // refreshMesh(id) — same-length U V for a TriangleComplex entry
 *    v.poll(timeoutMs=0)
 *    v.wait(sessionTimeOut=1500)
 *    v.close()
 *
 *  Requires: import zeromq  (morpho-zeromq package)
 */

import zeromq
import xgraphics
import broadcast

var _vwopnfl = Error("VwOpnFl", "View failed to open morphoview session.")

/* **************************************
 * View — live duplex session
 **************************************** */

class View with Listener {
  init(connectTimeOut=5000, pollMs=100) {
    self.connectTimeOut = connectTimeOut
    self.pollMs = pollMs
    self.sock = nil
    self.ep = nil
    self.poller = nil
    self.closed = true
    self.gotOk = false
    self.cmdBuf = ""
    self.graphics = nil
    self.show = nil
  }

  // Open immediately (same as View() then open(g)). Scene → live listen;
  // plain Graphics → set-and-forget. Throws if the session cannot open.
  init(Graphics g, connectTimeOut=5000, pollMs=100) {
    self.init(connectTimeOut=connectTimeOut, pollMs=pollMs)
    if (!self.open(g)) _vwopnfl.throw()
  }

  // File-compatible sink for Show.write(g, out): each line gets a trailing newline
  // (Morpho File.write does the same).
  write(line) {
    self.cmdBuf += "${line}\n"
  }

  // Bind, spawn morphoview, send the first command chunk, wait for `ok`.
  open(commands) {
    if (!isnil(self.sock)) {
      print "morphoview: View already open"
      return false
    }
    self._bind()
    self._spawn()
    self.poller = ZMQPoller(self.sock)
    self.closed = false
    self.gotOk = false
    self._send(commands)
    return self._waitOk()
  }

  // Serialize Graphics via Show and open (no listener).
  open(Graphics g) { return self._openModel(g) }

  // Serialize Scene, open, then listen for move/recolor/display.
  open(Scene g) {
    var ok = self._openModel(g)
    if (ok) self.listen(g)
    return ok
  }

  // Send another command chunk and wait for `ok`.
  update(commands) {
    if (self.closed) return false
    self.gotOk = false
    self._send(commands)
    return self._waitOk()
  }

  // Full `U S` replace (no listener).
  update(Graphics g) { return self._updateModel(g) }

  // Full `U S` replace and rebind listener.
  update(Scene g) {
    var ok = self._updateModel(g)
    if (ok) self.listen(g)
    return ok
  }

  // Show.write + open(commands); store model. Shared by Graphics/Scene open.
  _openModel(Graphics g) {
    if (!isnil(self.graphics)) self._detach(self.graphics)
    self.show = Show()
    self.cmdBuf = ""
    self.show.write(g, self)
    var ok = self.open(self.cmdBuf)
    if (ok) {
      self.graphics = g
    } else {
      self.show = nil
    }
    return ok
  }

  // Show.write with replace + update(commands); store model.
  _updateModel(Graphics g) {
    if (self.closed) return false
    if (!isnil(self.graphics)) self._detach(self.graphics)
    self.show = Show()
    self.show.replace = true
    self.cmdBuf = ""
    self.show.write(g, self)
    var ok = self.update(self.cmdBuf)
    if (ok) {
      self.graphics = g
    } else {
      self.graphics = nil
      self.show = nil
    }
    return ok
  }

  // No-op for static Graphics; Scene overload unsubscribes.
  _detach(Graphics g) { }

  _detach(Scene g) { self.ignore(g) }

  // Clear draws (`D`) and re-issue pose/draw ASCII without `U S`.
  // Prepends `D` unless `commands` already starts with it.
  redraw(commands) {
    if (self.closed) return false
    self.gotOk = false
    var body = commands
    if (isnil(body)) body = ""
    if (body.count() == 0 || body[0] != "D") {
      body = "D\n${body}"
    }
    self._send(body)
    return self._waitOk()
  }

  // GraphicsEventDefined → define+draw; Moved → pose `d`; Recolored → `C` + `d`;
  // Removed → X D (+ X O if last user); Replaced → sphere-cache refresh or remove+rewrite.
  receive(Graphics g, GraphicsEventDefined ev) {
    if (self.closed || isnil(self.show)) return
    var entry = g.findEntry(ev.id)
    if (isnil(entry)) return
    self.cmdBuf = ""
    self.show.writeEntry(entry, self)
    if (self.cmdBuf.count() == 0) return
    self.gotOk = false
    self._send(self.cmdBuf)
    self._waitOk()
  }

  receive(Graphics g, GraphicsEventMoved ev) {
    if (self.closed || isnil(self.show)) return
    var ids = ev.ids
    if (isnil(ids) || ids.count() == 0) ids = [ev.id]
    self.cmdBuf = ""
    var any = false
    for (id in ids) {
      if (self.show.emitEntryPose(g, id, self)) any = true
    }
    if (!any) {
      // Nothing mapped yet — fall back to full D + pose redraw.
      self.write("D")
      self.show.emitPoseDraws(g, self)
    }
    if (self.cmdBuf.count() == 0) return
    self.gotOk = false
    self._send(self.cmdBuf)
    self._waitOk()
  }

  receive(Graphics g, GraphicsEventRecolored ev) {
    if (self.closed || isnil(self.show)) return
    var ids = ev.ids
    if (isnil(ids) || ids.count() == 0) ids = [ev.id]
    self.cmdBuf = ""
    var any = false
    for (id in ids) {
      if (self.show.emitEntryRecolor(g, id, self)) any = true
    }
    if (self.cmdBuf.count() == 0) return
    self.gotOk = false
    self._send(self.cmdBuf)
    self._waitOk()
  }

  receive(Graphics g, GraphicsEventRemoved ev) {
    if (self.closed || isnil(self.show)) return
    self.cmdBuf = ""
    self.show.emitEntryRemove(ev.id, self)
    if (self.cmdBuf.count() == 0) return
    self.gotOk = false
    self._send(self.cmdBuf)
    self._waitOk()
  }

  receive(Graphics g, GraphicsEventReplaced ev) {
    if (self.closed || isnil(self.show)) return
    self.cmdBuf = ""
    if (!self.show.emitEntryReplace(g, ev.id, self)) return
    if (self.cmdBuf.count() == 0) return
    self.gotOk = false
    self._send(self.cmdBuf)
    self._waitOk()
  }

  /** Push same-length vertex data for a TriangleComplex entry (`U V`).
   *  Layout must match how the object was defined (`xn` / `xnc`).
   *  Call after mutating `entry.item` in place (fixed connectivity). */
  refreshMesh(graphicsId) {
    if (self.closed || isnil(self.show) || isnil(self.graphics)) return false
    self.cmdBuf = ""
    if (!self.show.emitEntryVertices(self.graphics, graphicsId, self)) return false
    if (self.cmdBuf.count() == 0) return false
    self.gotOk = false
    self._send(self.cmdBuf)
    return self._waitOk()
  }

  // Wait briefly for one reply/event. Returns the message string, or nil.
  // Default timeout is self.pollMs; use poll(timeoutMs=0) for a non-blocking check.
  poll(timeoutMs=nil) {
    if (self.closed || isnil(self.poller)) return nil
    var t = self.pollMs
    if (!isnil(timeoutMs)) t = timeoutMs
    var ready = self.poller.wait(t)
    if (!ready) return nil
    return self._handle(self.sock.receive())
  }

  // Poll until the window closes, the peer dies, or sessionTimeOut ms elapse
  // (0 = wait indefinitely for window.closed).
  wait(sessionTimeOut=0) {
    var waited = 0
    while (!self.closed) {
      self.poll(timeoutMs=self.pollMs)
      if (self.closed) break
      if (sessionTimeOut > 0) {
        waited += self.pollMs
        if (waited >= sessionTimeOut) {
          self.close()
          break
        }
      }
    }
  }

  // Best-effort stop of the viewer; idempotent. Prefers command `Q` over pkill.
  close() {
    if (self.closed) return
    if (!isnil(self.graphics)) self._detach(self.graphics)
    self.graphics = nil
    self.show = nil
    if (!isnil(self.sock)) {
      self._send("Q")
      var waited = 0
      while (!self.closed && waited < self.connectTimeOut) {
        self.poll(timeoutMs=self.pollMs)
        if (self.closed) break
        waited += self.pollMs
      }
    }
    if (!self.closed) self._kill()
    self.closed = true
  }

  _bind() {
    self.sock = ZMQPair()
    self.sock.bind("tcp://127.0.0.1:!")
    self.ep = self.sock.endpoint()
  }

  _spawn() {
    var bin = _morphoviewbin()
    if (System.platform()=="windows") {
      system("powershell -Command \"Start-Process '${bin}' -ArgumentList '-c', '${self.ep}'\"")
    } else {
      system("\"${bin}\" -c \"${self.ep}\" > /dev/null 2>&1 &")
    }
  }

  _send(commands) {
    self.sock.send(commands)
  }

  // Block (via poll) until `ok`, error/close, or connectTimeOut.
  _waitOk() {
    var waited = 0
    while (!self.closed && !self.gotOk) {
      self.poll(timeoutMs=self.pollMs)
      if (self.gotOk) return true
      if (self.closed) return false
      waited += self.pollMs
      if (waited >= self.connectTimeOut) {
        print "morphoview: timed out waiting for ok"
        self._kill()
        self.closed = true
        return false
      }
    }
    return self.gotOk
  }

  // Interpret one reply; update gotOk / closed. Returns msg (or nil if peer gone).
  _handle(msg) {
    if (!isstring(msg)) {
      self.closed = true
      return nil
    }
    if (msg == "ok") {
      self.gotOk = true
    } else if (msg == "window.closed") {
      self.closed = true
    } else if (msg.count() >= 3 && msg[0]=="e" && msg[1]=="r" && msg[2]=="r") {
      print "morphoview: ${msg}"
      self._kill()
      self.closed = true
    }
    return msg
  }

  _kill() {
    if (isnil(self.ep)) return
    if (System.platform()=="windows") return
    system("pkill -f \"morphoview -c ${self.ep}\" > /dev/null 2>&1")
  }
}
