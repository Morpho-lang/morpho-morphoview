/** MorphoView live session helper + prototype Show serializer.
 *
 *  `View` is a duplex ZMQ PAIR session with morphoview (distinct from
 *  fire-and-forget `Show(g)`, which writes a temp file and launches `-t`).
 *
 *  Morpho has no async runtime: keep the channel open and drive the loop
 *  with `poll` / `System.sleep`, or use `wait` as a convenience.
 *
 *    var v = View()
 *    v.open(commands)           // ASCII string
 *    v.open(g)                  // Graphics (via Show serializer)
 *    v.update(morecommands)     // e.g. chunk starting with `U S <id>`
 *    v.update(g)                // Graphics replace via `U S`
 *    v.poll(timeoutMs=0)
 *    v.wait(sessionTimeOut=1500)
 *    v.close()
 *
 *  Requires: import zeromq  (morpho-zeromq package)
 *
 *  The `Show` class here is a prototype of a graphics.morpho rewrite:
 *  serializer state is separate from temp-file launch, so any object that
 *  responds to `write(line)` (File, View, …) can be the output delegate.
 *  `Show()` vs `Show(g)` use multiple dispatch on init arity.
 *  Intended to be pushed upstream once settled.
 */

import zeromq
import graphics

var _fntntfnd = Error("FntNtFnd", "Font not found.")

/* Resolve morphoview executable */
var _mvbin = nil

fn _morphoviewbin() {
  if (!isnil(_mvbin)) return _mvbin

  var exe = (System.platform()=="windows" ? "morphoview.exe" : "morphoview")
  var roots = []

  // Attempt to discover package location with morphopm path
  var r = System.subprocess("morphopm path morphoview")
  if (r["exitstatus"]==0) {
    roots.append(r["stdout"].split("\n")[0])
  } else if (Folder.contents(System.homefolder()).contains(".morphopackages")) {
    // Otherwise look in ~/.morphopackages
    for (p in File("${System.homefolder()}/.morphopackages").lines()) {
      if (p.split("/\\").contains("morpho-morphoview")) roots.append(p)
    }
  }

  // Check in these roots for the executable
  for (root in roots) {
    if (root.count()>0 &&
        Folder.isFolder("${root}/bin") &&
        Folder.contents("${root}/bin").contains(exe)) {
      _mvbin = Folder.normalizePath("${root}/bin/${exe}")
      return _mvbin
    }
  }

  // Fall back to just running `morphoview` on PATH
  _mvbin = "morphoview"
  return _mvbin
}

/* **************************************
 * Show — serialize a Graphics object
 *
 *  Prototype for upstream graphics.morpho. Mild rewrite of the stock Show:
 *  - `Show()`     — serializer only (uid / sphere / font / color state)
 *  - `Show(g)`    — same fire-and-forget as before (temp file + morphoview -t)
 *  - `show.write(g, out)` — emit ASCII commands to any `out.write(...)` sink
 *  Two `init` arities via multiple dispatch.
 **************************************** */

class XShow {
  // Serializer only — use write(g, out) with any write-able sink.
  init() {
    self.uidInit()
    self.spheres = Dictionary()
    self.fonts = []
    self.colors = Dictionary()
    self.sceneId = 1
    self.replace = false
  }

  // Fire-and-forget: same as stock Show(g) (temp file + morphoview -t).
  init(g) {
    self.init()
    self._launch(g)
  }

  /** Fire-and-forget: temp file + morphoview -t (former init body). */
  _launch(g) {
    var isWindows = System.platform()=="windows"
    var tempFolder = (isWindows ? "${System.homefolder()}\\AppData\\local\\Temp" : "/tmp")
    var fname = self._randomAlphanumString(10)
    var out = File("${tempFolder}/morpho${fname}.draw", "w")
    var bin = _morphoviewbin()

    self.write(g, out)

    out.close()

    if (isWindows) {
      system("powershell -Command \"Start-Process '${bin}' -ArgumentList '-t', '${tempFolder}/morpho${fname}.draw' -WindowStyle Hidden\"")
    } else {
      // 1/7/25 Redirect error output to /dev/null
      system("\"${bin}\" -t ${tempFolder}/morpho${fname}.draw > /dev/null 2>&1 &")
    }
  }

  /** Generate a random name */
  _randomAlphanumString(n) {
    var alpha="abcdefghijklmnopqrstuvwxyz0123456789"
    var name=""
    for (i in 1..n) name+=alpha[Int(random()*(alpha.count()-1))]
    return name
  }

  uidInit() {
    self.uid = 0
  }

  uid() { // Generate unique identifiers
    self.uid+=1
    return self.uid
  }

  preamble(graphic, out) {
    if (self.replace) {
      out.write("U S ${self.sceneId}")
    } else {
      out.write("S ${self.sceneId} 3")
      out.write("W \"${graphic.title}\"")
    }
  }

  // 3 significant figures — enough for display; keeps ASCII small vs full doubles.
  // Morpho requires a width field (`%.3g` is rejected); use 0 to avoid padding spaces.
  // Coerce via Float: Matrix/Color often yield Ints, and Int.format rejects %g.
  fmt(x) {
    return Float(x).format("%0.3g")
  }

  /* The visit method for a generic `item`.

  Here, we define this separate `visitGeneric` method that performs the intended generic task, and have the actual generic `visit` method call `visitGeneric`. This enables calls to the generic fallback from *within a specific implementation*.
  For example, the `visit` method for a `Sphere` object can call `self.visitGeneric(item, out)` to visit the `TriangleComplex` representation of the sphere, but calling `self.visit(item, out)` would result in an infinite loop.
  */
  visitGeneric(item, out) {
    var tri = item.totrianglecomplex()
    if (isnil(tri)) return // e.g. zero-length Cylinder/Arrow
    // Most converters drop filter/transmit (Tube is the exception); copy from the source.
    if (!isnil(item.filter)) tri.filter = item.filter
    if (!isnil(item.transmit)) tri.transmit = item.transmit
    self.visit(tri, out)
  }

  // Will be used by Tube (and other meshes with totrianglecomplex)
  visit(item, out) {
    self.visitGeneric(item, out)
  }

  visit(Cylinder item, out) {
    // Skip degenerate shafts (zero/NaN length). `!(len > eps)` rejects NaN too.
    var len = (item.end - item.start).norm()
    if (!(len > 1e-8)) return
    self.visitGeneric(item, out)
  }

  visit(Arrow item, out) {
    var len = (item.end - item.start).norm()
    if (!(len > 1e-8)) return
    self.visitGeneric(item, out)
  }

  visit(Sphere item, out) {
    var n = item.refinementlevel()

    // Colored or translucent: expand to a TriangleComplex (instance path is opaque-only).
    if (item.color || !isnil(item.transmit) || !isnil(item.filter)) {
      self.visitGeneric(item, out)
      return
    } else if (!self.spheres.contains(n)) { // Check if we already have a sphere object at this refinement level
      var tri=item.totrianglecomplex(scale=false)
      tri.id = self.uid()
      out.write("o ${tri.id}")
      self.triangleComplexObjectData(tri,out)
      self.spheres[n]=tri
    }

    out.write("i")
    out.write("s ${self.fmt(item.r)}")
    out.write("t ${self.fmt(item.center[0])} ${self.fmt(item.center[1])} ${self.fmt(item.center[2])}")
    out.write("d ${self.spheres[n].id}")
  }

  /** POVRay transmit/filter → OpenGL alpha: a = 1 - clamp(transmit + filter, 0, 1). */
  opacity(item) {
    var t = isnil(item.transmit) ? 0 : item.transmit
    var f = isnil(item.filter) ? 0 : item.filter
    var a = 1 - (t + f)
    return (a < 0) ? 0 : ((a > 1) ? 1 : a)
  }

  /** Uniform RGB for a TriangleComplex (first vertex if per-vertex colors).
   *  Type cascade is fine here — colors may be Matrix, list, or Color. */
  uniformRgb(item) {
    var col = item.colors
    if (isnil(col)) return [0.5, 0.5, 0.5]
    if (ismatrix(col)) return [col[0,0], col[1,0], col[2,0]]
    if (islist(col)) return col
    if (isobject(col)) return col.rgb(0)
    return [0.5, 0.5, 0.5]
  }

  /** Emit `c` for rgb[+alpha]; returns color id. Alpha < ~1 → RGBA. */
  addRgb(rgb, alpha, out) {
    var r = self.fmt(rgb[0])
    var g = self.fmt(rgb[1])
    var b = self.fmt(rgb[2])
    var a = self.fmt(alpha)
    var key = "${r} ${g} ${b} ${a}"
    if (!self.colors.contains(key)) {
      var id = self.colors[key] = self.colors.count()
      out.write(alpha < 0.999 ?
                "c ${id} ${r} ${g} ${b} ${a}" :
                "c ${id} ${r} ${g} ${b}")
    }
    return self.colors[key]
  }

  triangleComplexObjectData(item, out, includeColor=true) {
    var x = item.position
    var n = item.normals
    var col = item.colors
    var localColor = false
    var dimensions=x.dimensions()
    var dim = dimensions[0]
    var nv = dimensions[1]

    if (includeColor) {
      if (ismatrix(col)) {
        if (col.dimensions()[1]>1) localColor = true
      } else if (isobject(col) && !islist(col)) col = col.rgb(0)
      out.write("v \"xnc\"")
    } else {
      out.write("v \"xn\"")
    }

    for (i in 0...nv) {
      var line = ""
      for (j in 0...dim) {
        line+="${self.fmt(x[j,i])} "
      }
      for (j in 0...dim) {
        line+="${self.fmt(n[j,i])} "
      }
      if (includeColor) {
        if (localColor) {
          for (j in 0...3) line+="${self.fmt(col[j,i])} "
        } else {
          for (j in 0...item.colors.count()) line+="${self.fmt(col[j])} "
        }
      }
      out.write(line)
    }

    out.write("f")
    var f=item.connectivity
    var nf=f.dimensions()[1]

    for (i in 0...nf) {
      var line = ""
      // Sparse connectivity preserves face winding via rowindices (cf. povray Show).
      // Dense Matrix incidence only stores membership — fall back to ascending ids.
      if (issparse(f)) {
        var indx = f.rowindices(i)
        for (j in 0...indx.count()) line+="${indx[j]} "
      } else {
        var nvf=f.dimensions()[0]
        for (j in 0...nvf) {
          if (f[j,i]!=0) line+="${j} "
        }
      }
      out.write(line)
    }
  }

  visit(TriangleComplex item, out) {
    var id = self.uid()
    var alpha = self.opacity(item)
    if (alpha < 0.999) {
      // Uniform albedo + alpha (viewer transparent pass); vertex colors deferred.
      var cid = self.addRgb(self.uniformRgb(item), alpha, out)
      out.write("C ${cid}")
      out.write("o ${id}")
      self.triangleComplexObjectData(item, out, includeColor=false)
    } else {
      out.write("o ${id}")
      self.triangleComplexObjectData(item, out)
    }
    out.write("i")
    out.write("d ${id}")
  }

  fontPath() {
    var platform = System.platform()
    if (platform=="macos") {
      return ["/System/Library/Fonts"]
    } else if (platform=="windows") {
      return ["C:/Windows/Fonts"]
    } else return ["/usr/share/fonts","/usr/local/share/fonts"]
  }

  matchFontFile(file, font) {
    var fname = file.split(".")
    if (fname[0]==font &&
        (fname[1]=="ttc" || fname[1]=="ttf")) return true
    return false
  }

  searchFontFolder(folder, font) {
    for (f in Folder.contents(folder)) {
      var path = folder + "/" + f
      if (self.matchFontFile(f, font)) return path

      if (Folder.isFolder(path)) { // Recurse
        var result = self.searchFontFolder(path, font)
        if (result) return result
      }
    }
    return nil
  }

  findFont(font) {
    var base = self.fontPath()
    for (f in base) {
      var found = self.searchFontFolder(f, font)
      if (found) return found
    }
    return nil
  }

  defaultFontName() {
    var platform = System.platform()
    if (platform=="macos") {
      return "Helvetica"
    } else if (platform=="windows") {
      return "arial" // Note case sensitive
    } else return "FreeSans"
  }

  addColor(color, out) {
    if (!self.colors.contains(color)) {
      var id = self.colors[color] = self.colors.count()
      out.write("c ${id} ${self.fmt(color.r)} ${self.fmt(color.g)} ${self.fmt(color.b)}")
    }
    return self.colors[color]
  }

  addFont(font, size, out) {
    var path = self.findFont(font)
    if (!path) _fntntfnd.throw()
    var id = self.uid()
    var fnt = Font(font, size, id=id)
    self.fonts.append(fnt)

    out.write("F ${id} \"${path}\" ${size}")
    return id
  }

  findFontId(font, size, out) {
    for (f in self.fonts) {
      if (f.name == font && f.size == size) return f.id
    }
    return self.addFont(font, size, out)
  }

  visit(Text item, out) {
    var font = item.font
    if (!font) font = self.defaultFontName()
    var id = self.findFontId(font, item.size, out)

    if (item.color) {
      var id = self.addColor(item.color, out)
      out.write("C ${id}")
    }

    out.write("i")
    var m = item.transformationmatrix()
    if (m) {
      var str = "m"
      for (i in 0..3) for (j in 0..3) str+=" "+self.fmt(m[i,j])
      out.write(str)
    }
    out.write("t ${self.fmt(item.posn[0])} ${self.fmt(item.posn[1])} ${self.fmt(item.posn[2])}")
    out.write("T ${id} \"${item.string}\"")
  }

  write(graphic, out) {
    self.preamble(graphic, out)

    for (item in graphic.displaylist) self.visit(item, out)
  }
}

/* **************************************
 * View — live duplex session
 **************************************** */

class View {
  init(connectTimeOut=5000, pollMs=100) {
    self.connectTimeOut = connectTimeOut
    self.pollMs = pollMs
    self.sock = nil
    self.ep = nil
    self.poller = nil
    self.closed = true
    self.gotOk = false
    self.cmdBuf = ""
  }

  // File-compatible sink for Show.write(g, out): each line gets a trailing newline
  // (Morpho File.write does the same).
  write(line) {
    self.cmdBuf += "${line}\n"
  }

  // Bind, spawn morphoview, send the first command chunk, wait for `ok`.
  open(commands) {
    if (!isnil(self.sock)) {
      print "morphoview: View already open"
      return false
    }
    self._bind()
    self._spawn()
    self.poller = ZMQPoller(self.sock)
    self.closed = false
    self.gotOk = false
    self._send(commands)
    return self._waitOk()
  }

  // Serialize Graphics via Show, then open the resulting ASCII chunk.
  open(Graphics g) {
    self.cmdBuf = ""
    var show = XShow()
    show.write(g, self)
    return self.open(self.cmdBuf)
  }

  // Send another command chunk and wait for `ok`.
  update(commands) {
    if (self.closed) return false
    self.gotOk = false
    self._send(commands)
    return self._waitOk()
  }

  // Serialize Graphics with replace preamble (`U S`), then update.
  update(Graphics g) {
    self.cmdBuf = ""
    var show = XShow()
    show.replace = true
    show.write(g, self)
    return self.update(self.cmdBuf)
  }

  // Wait briefly for one reply/event. Returns the message string, or nil.
  // Default timeout is self.pollMs; use poll(timeoutMs=0) for a non-blocking check.
  poll(timeoutMs=nil) {
    if (self.closed || isnil(self.poller)) return nil
    var t = self.pollMs
    if (!isnil(timeoutMs)) t = timeoutMs
    var ready = self.poller.wait(t)
    if (!ready) return nil
    return self._handle(self.sock.receive())
  }

  // Poll until the window closes, the peer dies, or sessionTimeOut ms elapse
  // (0 = wait indefinitely for window.closed).
  wait(sessionTimeOut=0) {
    var waited = 0
    while (!self.closed) {
      self.poll(timeoutMs=self.pollMs)
      if (self.closed) break
      if (sessionTimeOut > 0) {
        waited += self.pollMs
        if (waited >= sessionTimeOut) {
          self.close()
          break
        }
      }
    }
  }

  // Best-effort stop of the viewer; idempotent. Prefers command `Q` over pkill.
  close() {
    if (self.closed) return
    if (!isnil(self.sock)) {
      self._send("Q")
      var waited = 0
      while (!self.closed && waited < self.connectTimeOut) {
        self.poll(timeoutMs=self.pollMs)
        if (self.closed) break
        waited += self.pollMs
      }
    }
    if (!self.closed) self._kill()
    self.closed = true
  }

  _bind() {
    self.sock = ZMQPair()
    self.sock.bind("tcp://127.0.0.1:!")
    self.ep = self.sock.endpoint()
  }

  _spawn() {
    var bin = _morphoviewbin()
    if (System.platform()=="windows") {
      system("powershell -Command \"Start-Process '${bin}' -ArgumentList '-c', '${self.ep}'\"")
    } else {
      system("\"${bin}\" -c \"${self.ep}\" > /dev/null 2>&1 &")
    }
  }

  _send(commands) {
    self.sock.send(commands)
  }

  // Block (via poll) until `ok`, error/close, or connectTimeOut.
  _waitOk() {
    var waited = 0
    while (!self.closed && !self.gotOk) {
      self.poll(timeoutMs=self.pollMs)
      if (self.gotOk) return true
      if (self.closed) return false
      waited += self.pollMs
      if (waited >= self.connectTimeOut) {
        print "morphoview: timed out waiting for ok"
        self._kill()
        self.closed = true
        return false
      }
    }
    return self.gotOk
  }

  // Interpret one reply; update gotOk / closed. Returns msg (or nil if peer gone).
  _handle(msg) {
    if (!isstring(msg)) {
      self.closed = true
      return nil
    }
    if (msg == "ok") {
      self.gotOk = true
    } else if (msg == "window.closed") {
      self.closed = true
    } else if (msg.count() >= 3 && msg[0]=="e" && msg[1]=="r" && msg[2]=="r") {
      print "morphoview: ${msg}"
      self._kill()
      self.closed = true
    }
    return msg
  }

  _kill() {
    if (isnil(self.ep)) return
    if (System.platform()=="windows") return
    system("pkill -f \"morphoview -c ${self.ep}\" > /dev/null 2>&1")
  }
}
