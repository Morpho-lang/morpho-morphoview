/* ***************************************************************
 * MorphoView
 * =========
 * Show and View for the GLFW / OpenGL morphoview binary. 
 **************************************************************** */

/* ----------------------------------------------------------------
 * Example usage:
 *    Show(g)                        // temp file + morphoview -t
 *    var v = View(scene)            // open + listen
 *    v.open(commands)               // or ASCII chunk
 *    scene.move(id, ...)            // pose
 *    scene.recolor(id, ...)         // recolor
 *    v.morph(id, item)              // update in place, or replace
 *    v.refreshMesh(id)              // redefine from the model
 *    v.poll(timeoutms=0)
 *    v.wait(sessiontimeout=1500)
 *    v.close()
 * ---------------------------------------------------------------- */

import morphoviewclient

// Error messages
var _mvpmold = Error("MvPmOld", "morphopm is too old (unrecognized path command); please upgrade morphopm.")

/* ----------------------------------------------------------------
 * findMorphoViewBin 
 *
 * Find the morphoview executable.
 * ---------------------------------------------------------------- */

var _mvbin = nil

fn findMorphoViewBin() { // Path to the morphoview executable
  if (!isnil(_mvbin)) return _mvbin

  var exe = (System.platform()=="windows" ? "morphoview.exe" : "morphoview")
  var roots = []
  var haspm = System.subprocess(System.platform()=="windows" ? "where morphopm" : "command -v morphopm")

  if (haspm["exitstatus"]==0) {
    var line = System.subprocess("morphopm path morphoview")["stdout"].split("\n")[0]
    var parts = line.split("'")
    var code = (parts.count()>1) ? parts[1] : ""
    if (code == "ErrMorphoPMUnrcgnzd") _mvpmold.throw()
    if (line.count()>0 && Folder.isFolder(line)) roots.append(line)
  }

  if (roots.count()==0 && Folder.contents(System.homefolder()).contains(".morphopackages")) {
    for (p in File(Folder.normalizePath("${System.homefolder()}/.morphopackages")).lines()) {
      if (p.split("/\\").contains("morpho-morphoview")) roots.append(p)
    }
  }

  for (root in roots) {
    var bindir = Folder.normalizePath("${root}/bin")
    if (root.count()>0 && Folder.isFolder(bindir) && Folder.contents(bindir).contains(exe)) {
      _mvbin = Folder.normalizePath("${bindir}/${exe}")
      return _mvbin
    }
  }

  _mvbin = "morphoview"
  return _mvbin
}

/* ----------------------------------------------------------------
 * Show
 *
 * Launch morphoview passing the serialized graphic to a temporary file.
 * ---------------------------------------------------------------- */

class Show is MorphoViewShow {
  _launch(g) { // Write a temp file and open GLFW morphoview
    var isWindows = System.platform()=="windows"
    var tempFolder = isWindows ?
      "${System.homefolder()}/AppData/Local/Temp" : "/tmp"
    var fname = self._randomAlphanumString(10)
    var path = Folder.normalizePath("${tempFolder}/morpho${fname}.draw")
    var out = File(path, "w")
    var bin = findMorphoViewBin()

    self.write(g, out)
    out.close()

    if (isWindows) {
      system("powershell -Command \"Start-Process '${bin}' -ArgumentList '-t', '${path}'\"")
    } else {
      system("\"${bin}\" -t \"${path}\" > /dev/null 2>&1 &")
    }
  }

  _randomAlphanumString(n) { // Random filename fragment
    var alpha="abcdefghijklmnopqrstuvwxyz0123456789"
    var name=[]
    var nalpha = alpha.count()
    for (i in 1..n) name.append(alpha[randomint(nalpha)])
    return String.join(name)
  }
}

/* ----------------------------------------------------------------
 * View
 *
 * Launch morphoview in interactive mode.
 * ---------------------------------------------------------------- */

class View is MorphoViewView {
  _spawn() { // Start GLFW morphoview
    var bin = findMorphoViewBin()
    var ep = self._transportEndpoint()
    if (System.platform()=="windows") {
      system("powershell -Command \"Start-Process '${bin}' -ArgumentList '-c', '${ep}'\"")
    } else {
      system("\"${bin}\" -c \"${ep}\" > /dev/null 2>&1 &")
    }
  }

  _kill() { // Kill the morphoview process
    var ep = self._transportEndpoint()
    if (isnil(ep)) return
    if (System.platform()=="windows") {
      system("powershell -Command \"Get-CimInstance Win32_Process | Where-Object { $_.Name -match 'morphoview' -and $_.CommandLine -like '*-c*${ep}*' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force }\"")
    } else {
      system("pkill -9 -f \"morphoview -c ${ep}\" > /dev/null 2>&1")
    }
  }
}
