/* *******************************************************************************************
 * Plot module (local prototype)
 * *******************************************************************************************
 * Modernization of morpho `plot` against xgraphics / xcolor.
 * Canonical API: Plot(Mesh) / Plot(Selection) / Plot(Field) — class Plot is Scene.
 * Extend by subclassing Plot (override _drawMesh / _drawSelection / _drawField / _finish).
 * Legacy plotmesh / plotselection / plotfield are thin veneers over Plot
 * (default style="thick": spheres + tubes, matching classic plot).
 * Presentation: axes=true (domain frame) + scalebar=true / ScaleBar / ScaleBarStrip.
 * ScaleBar is a vertex-colored TriangleComplex (tube; ScaleBarStrip is an open strip).
 * Built locally: cross-section → positions / normals / ColorTable / connectivity. No meshtools.
 * Field coloring: linear normalize (safe on uniform fields) + optional center= for diverging maps.
 * Live: axes / colormap / range / center / refresh [view] mutate Scene (fields: morph via View, not recolor).
 ******************************************************************************************* */

import constants
import xgraphics
import xcolor

/* --------------------------
 * Errors
 * -------------------------- */

var _PltMshClErr = Error("PltMshCl", "Color specification for plotmesh should be either a color, a list of [r,g,b] values or a list of colors for each grade.")
var _PltInvldClErr = Error("PltInvldCl", "Could not convert color to matrix.")
var _PltFldIntErr = Error("PltFldInt", "Can't use 'interpolate' style: Field lacks values on vertices.")
var _PltSlctnEmptyErr = Error("PltSlctnEmpty", "Selection is empty.")
var _PltSclBrVctrErr = Error("PltSclBrVctr", "ScaleBar vector must be a non-zero Matrix, List, or Tuple; tickdirn must not be parallel to dirn.")

/* --------------------------
 * Geometry / bounds
 * -------------------------- */

/* Module-private; not _cross3D — that name collides with xgraphics under MD. */
fn _plotCross3D(a, b) {
  return Matrix([ a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0] ])
}

/** Bounding box from a vertex matrix: list of [min,max] per coordinate row. */
fn _boundingBox(m) {
  var col = m.transpose()
  var bnds = []
  for (i in 0...col.dimensions()[1]) bnds.append(bounds(col.column(i)))
  return bnds
}

/** Scientific bounds from mesh dimensionality (vertexmatrix rows), not planarity. */
fn _scientificBounds(mesh) {
  return _boundingBox(mesh.vertexmatrix())
}

/** Pad scientific bounds to 3D lo/hi Matrices. Returns (lo, hi, dim). */
fn _boundsLoHi(bnds) {
  var dim = bnds.count()
  var lo = Matrix(3)
  var hi = Matrix(3)
  for (i in 0...dim) {
    lo[i] = bnds[i][0]
    hi[i] = bnds[i][1]
  }
  return (lo, hi, dim)
}

/** Midpoint of scientific bounds as Matrix(3). */
fn _boundsCentroid(bb) {
  var c = Matrix(3)
  for (x, i in bb) c[i] = x[0] + (x[1] - x[0])/2
  return c
}

/** Zero-extent coordinate axis for planar normal picking (not GraphicsEntry.flat). */
fn _planarAxis(bb) {
  for (x, i in bb) {
    if (abs(x[1]-x[0])<1e-10) return i
  }
  return nil
}

/** Copy a length-3 vector (Matrix/list) into a fresh Matrix(3). */
fn _pt3(src) {
  var p = Matrix(3)
  for (j in 0...3) p[j] = src[j]
  return p
}

/** Point on axis `ax` at coordinate `t`, other coords from `lo`. */
fn _ptOnAxis(lo, ax, t) {
  var p = _pt3(lo)
  p[ax] = t
  return p
}

/** Pad/truncate a vertex matrix to 3×n. */
fn _vertexMatrix3(mesh) {
  var v = mesh.vertexmatrix()
  var d = v.dimensions()[0]
  var n = v.dimensions()[1]
  if (d == 3) return v
  var out = Matrix(3, n)
  var m = min(d, 3)
  for (i in 0...n) {
    for (j in 0...m) out[j, i] = v[j, i]
  }
  return out
}

fn _to3D(x) {
  var y = Matrix(3)
  for (i in 0...min(x.count(), 3)) y[i] = x[i]
  return y
}

fn _centroid(m, g, id) {
  if (g == 0) return m.vertexposition(id)
  var el = m.connectivitymatrix(0, g).rowindices(id)
  var x = 0
  for (vid in el) x += m.vertexposition(vid)
  return x/el.count()
}

/* --------------------------
 * Grade / style predicates
 * -------------------------- */

/** Must precede _gradeList: a module-level fn cannot call a fn defined later
 *  (Morpho "Closure unavailable" and it poisons later fns in the file). */
fn _copySeq(seq) {
  var out = []
  for (x in seq) out.append(x)
  return out
}

/** Resolve grade= to a fresh list of grades to draw. */
fn _gradeList(mesh, grade) {
  if (isnil(grade)) return [mesh.maxgrade()]
  if (islist(grade)) return _copySeq(grade)
  if (isnumber(grade)) return [grade]
  if (istuple(grade)) return _copySeq(grade)
  return [mesh.maxgrade()]
}

/** True if grade= includes g (nil means all grades). */
fn _wantsGrade(grade, g) {
  if (isnil(grade)) return true
  if (islist(grade)) return grade.ismember(g)
  if (isnumber(grade)) return grade == g
  if (istuple(grade)) {
    for (x in grade) {
      if (x == g) return true
    }
    return false
  }
  return true
}

/** style= may be a string or list/tuple: "interpolate", "shaded", "spheres", "tubes", "thick", … */
fn _styleHas(style, name) {
  if (isnil(style)) return false
  if (islist(style) || isarray(style)) return style.ismember(name)
  if (istuple(style)) {
    for (x in style) {
      if (x == name) return true
    }
    return false
  }
  return style == name
}

/** Classic plotmesh look: Sphere / Cylinder unless the caller set style=. */
fn _legacyStyle(style) {
  if (isnil(style)) return "thick"
  return style
}

// [Compatibility shim] Fold filter=/transmit= into color or colormap before Plot.
fn _plotLegacyTransp(color, filter, transmit) {
  if (isnil(filter) && isnil(transmit)) return color
  if (islist(color) || isarray(color) || istuple(color)) {
    if (color.count() >= 1 && (isnil(color[0]) || !isnumber(color[0]))) {
      if (isarray(color)) {
        var n = color.count()
        var out[n]
        for (i in 0...n) {
          out[i] = isnil(color[i]) ? nil : withLegacyTransp(color[i], filter, transmit)
        }
        return out
      }
      var out = []
      for (c in color) out.append(isnil(c) ? nil : withLegacyTransp(c, filter, transmit))
      return out
    }
  }
  return withLegacyTransp(color, filter, transmit)
}

/** Element ids of `grade` that pass an optional selection. */
fn _selectedIds(mesh, selection, grade) {
  var ids = []
  for (i in 0...mesh.count(grade)) {
    if (isselection(selection) && !selection.isselected(grade, i)) continue
    ids.append(i)
  }
  return ids
}

/* --------------------------
 * Color coercion (MD)
 * -------------------------- */

fn _asPlotColor(Coloring c) { return c }
fn _asPlotColor(Matrix c) { return asColoring(c) }
fn _asPlotColor(c) { _PltMshClErr.throw(); return nil }

fn _isNumericRgb(seq) {
  var n = seq.count()
  if (n != 3 && n != 4) return false
  return isnumber(seq[0]) && isnumber(seq[1]) && isnumber(seq[2])
}

/** True if color= is one shared color (not a per-grade list / ColorTable). */
fn _isSharedPlotColor(ColorTable color) { return false }
fn _isSharedPlotColor(color) {
  if (isnil(color)) return true
  if (ismatrix(color)) return false
  if (islist(color) || isarray(color) || istuple(color)) return _isNumericRgb(color)
  return true
}

fn _plotChannels(ColorTable color) { return color.channels() }
fn _plotChannels(Coloring color) { return (color.alpha(0) < 0.999) ? 4 : 3 }
fn _plotChannels(color) {
  if ((islist(color) || istuple(color)) && _isNumericRgb(color) && color.count() == 4) {
    return 4
  }
  return 3
}

fn _plotColorColumn(Coloring color, nch, x) {
  if (nch == 4) {
    var t = color.rgba(x)
    return Matrix([t[0], t[1], t[2], t[3]])
  }
  var t = color.rgb(x)
  return Matrix([t[0], t[1], t[2]])
}
fn _plotColorColumn(Coloring color, nch) { return _plotColorColumn(color, nch, 0) }
fn _plotColorColumn(color, nch) { return _plotColorColumn(asColoring(color), nch, 0) }

fn _gradeMax(glist) {
  var m = glist[0]
  for (g in glist) {
    if (g > m) m = g
  }
  return m
}

/** Grades in `glist` that the mesh actually has. */
fn _presentGrades(mesh, glist) {
  var out = []
  for (g in glist) {
    if (mesh.count(g) > 0) out.append(g)
  }
  return out
}

/** Deduces the plot color for a given grade.
 *  Shared color + a higher grade present → Darken (points/edges against faces). */
fn _plotColorForGrade(grade, color, drawn=nil) {
  var col
  if (isnil(color)) {
    col = Gray(0.5)
  } else if (islist(color) || isarray(color) || istuple(color)) {
    if (_isNumericRgb(color)) {
      col = Color(color)
    } else if (isnil(color[grade])) {
      col = Gray(0.5)
    } else {
      col = color[grade]
    }
  } else {
    col = _asPlotColor(color)
  }

  if (isnil(drawn) || drawn.count() == 0 || !_isSharedPlotColor(color)) return col
  var gap = _gradeMax(drawn) - grade
  if (gap <= 0) return col
  return Darken(asColoring(col), 1 - (2/3)^gap)
}

fn _plotColorForElement(ColorTable color, element) { return color.color(element) }
fn _plotColorForElement(color, element) { return color }

fn _isPerElementColor(ColorTable color, nel) { return color.count() == nel }
fn _isPerElementColor(color, nel) { return false }

/* --------------------------
 * Selection / field → colors
 * -------------------------- */

fn _selectionMesh(sel, mesh) {
  if (!isnil(mesh)) return mesh
  return sel.mesh()
}

/** Highlight color matrices for a selection (legacy plotselection logic). */
fn _selectionColors(mesh, selection, grade) {
  var ngrades = mesh.maxgrade()
  var col[ngrades+1]

  for (g in 0..ngrades) {
    col[g] = nil
    if (!_wantsGrade(grade, g)) continue

    var selected = selection.idlistforgrade(g)
    if (selected.count() == 0) continue

    var nel = mesh.count(g)
    var cmat = Matrix(3, nel)
    for (i in 0...nel) cmat.setColumn(i, Matrix([0.5, 0.5, 0.5]))
    for (i in selected) cmat.setColumn(i, Matrix([1, 0, 0]))
    col[g] = ColorTable(cmat)
  }
  return col
}

/* --------------------------
 * Field value → colormap [0,1]
 * -------------------------- */

fn _plotClamp01(x) { return (x < 0) ? 0 : ((x > 1) ? 1 : x) }

/** Linear map of val into [0,1] for colormap sampling.
 *  Zero data range (uniform field) → 0.5; never divides by zero.
 *  With center=: two-slope map vmin→0, center→0.5, vmax→1 (diverging). */
fn linearNormalize(val, vmin, vmax, center=nil) {
  if (!isnil(center)) {
    if (val >= center) {
      var hi = vmax - center
      if (abs(hi) < 1e-16) return 0.5
      return 0.5 + 0.5*_plotClamp01((val - center)/hi)
    }
    var lo = center - vmin
    if (abs(lo) < 1e-16) return 0.5
    return 0.5*_plotClamp01((val - vmin)/lo)
  }

  var span = vmax - vmin
  if (abs(span) < 1e-16) return 0.5 // uniform field → mid colormap
  return _plotClamp01((val - vmin)/span)
}

/** Clamp to [vmin,vmax] then normalize when scale=true; else return raw val. */
fn fieldSampleNorm(val, vmin, vmax, scale=true, center=nil) {
  if (!scale) return val
  if (val < vmin) val = vmin
  if (val > vmax) val = vmax
  return linearNormalize(val, vmin, vmax, center=center)
}

/** Resolve display range [vmin,vmax] from field bounds and optional cmin/cmax. */
fn _fieldRange(field, cmin=nil, cmax=nil) {
  var bnd = bounds(field)
  if (!isnil(cmin)) bnd[0] = cmin
  if (!isnil(cmax)) bnd[1] = cmax
  return bnd
}

/** Map a field to per-grade color matrices + grades to show. */
fn _fieldColors(field, selection=nil, grade=nil, colormap=nil, style=nil, scale=true,
                cmin=nil, cmax=nil, center=nil) {
  var mesh = field.mesh()
  var shape = field.shape()
  var sel = selection
  var ngrades = shape.count()
  var showgrades = []
  var col[ngrades+1]

  var cm = colormap
  if (isnil(cm)) cm = ViridisMap()

  var bnd = _fieldRange(field, cmin=cmin, cmax=cmax)
  var vmin = bnd[0], vmax = bnd[1]

  if (_styleHas(style, "interpolate")) {
    if (!_wantsGrade(grade, 2)) return (mesh, sel, showgrades, col, cm, bnd)

    var nv = mesh.count(0)
    var nch = _plotChannels(cm)
    var cmat = Matrix(nch, nv)

    if (field.shape()[0] == 0) _PltFldIntErr.throw()

    if (!isnil(sel)) {
      if (sel.count(2) == 0) {
        sel = sel.clone()
        sel.addgrade(2)
      } else if (sel.count(0) == 0) {
        sel = sel.clone()
        sel.addgrade(0)
      }
      if (sel.count(2) == 0 || sel.count(0) == 0) _PltSlctnEmptyErr.throw()
    }

    for (i in 0...nv) {
      if (!isnil(sel) && !sel[0, i]) continue
      var t = fieldSampleNorm(field[0, i], vmin, vmax, scale=scale, center=center)
      cmat.setColumn(i, _plotColorColumn(cm, nch, t))
    }

    col[2] = ColorTable(cmat)
    showgrades.append(2)
  } else {
    for (g in 0...ngrades) {
      if (shape[g] == 0) continue
      if (!_wantsGrade(grade, g)) continue

      var nel = mesh.count(g)
      var nch = _plotChannels(cm)
      var cmat = Matrix(nch, nel)
      for (i in 0...nel) {
        if (!isnil(sel) && !sel[g, i]) continue
        var t = fieldSampleNorm(field[g, i], vmin, vmax, scale=scale, center=center)
        cmat.setColumn(i, _plotColorColumn(cm, nch, t))
      }
      col[g] = ColorTable(cmat)
      showgrades.append(g)
    }
  }

  return (mesh, sel, showgrades, col, cm, bnd)
}

/* *******************************************************************************************
 * Presentation chrome — ticks, domain frame, axes labels
 ******************************************************************************************* */

fn _ticksForStep(a, b, dw) {
  return (dw*ceil(a/dw))..(dw*floor(b/dw)):dw
}

/** Nice ticks on [a,b] with at most nmax marks (1,2,5×10ⁿ spacing). */
fn _niceTicks(a, b, nmax) {
  var width = (b - a)
  if (abs(width) < 1e-16) return a..a:1

  var dw = 10^(floor(log10(width/nmax)) - 1)
  while (dw < width) {
    for (x in [dw, 2*dw, 5*dw]) {
      var r = _ticksForStep(a, b, x)
      if (r.count() <= nmax) return r
    }
    dw *= 10
  }
  return a..b:(b - a)/nmax
}

fn _tickLabel(t) {
  return Float(t).format("%0.4g")
}

/** Unit wireframe box as a LineSet (12 edges). */
fn _wirebox(lo, hi, color) {
  var x0 = lo[0], x1 = hi[0]
  var y0 = lo[1], y1 = hi[1]
  var z0 = lo[2], z1 = hi[2]
  var pos = Matrix([
    [x0, x1, x1, x0, x0, x1, x1, x0],
    [y0, y0, y1, y1, y0, y0, y1, y1],
    [z0, z0, z0, z0, z1, z1, z1, z1]
  ])
  var edges = [
    [0, 1], [1, 2], [2, 3], [3, 0],
    [4, 5], [5, 6], [6, 7], [7, 4],
    [0, 4], [1, 5], [2, 6], [3, 7]
  ]
  return LineSet(pos, edges, color=color)
}

/** Domain frame LineSet from scientific bounds (1D line / 2D rect / 3D box). */
fn _domainWire(bnds, color) {
  var info = _boundsLoHi(bnds)
  var lo = info[0], hi = info[1], dim = info[2]

  if (dim <= 1) {
    return LineSet(Matrix([
      [lo[0], hi[0]], [lo[1], hi[1]], [lo[2], hi[2]]
    ]), color=color)
  }

  if (dim == 2) {
    var x0 = lo[0], x1 = hi[0]
    var y0 = lo[1], y1 = hi[1]
    var z = lo[2]
    return LineSet(Matrix([
      [x0, x1, x1, x0],
      [y0, y0, y1, y1],
      [z, z, z, z]
    ]), [[0, 1], [1, 2], [2, 3], [3, 0]], color=color)
  }

  return _wirebox(lo, hi, color)
}

fn _segmentLine(p0, p1, color) {
  return LineSet(Matrix([
    [p0[0], p1[0]], [p0[1], p1[1]], [p0[2], p1[2]]
  ]), color=color)
}

/** Max absolute extent over the first `dim` axes. */
fn _boundsExtent(lo, hi, dim) {
  var extent = abs(hi[0] - lo[0])
  if (dim >= 2 && abs(hi[1] - lo[1]) > extent) extent = abs(hi[1] - lo[1])
  if (dim >= 3 && abs(hi[2] - lo[2]) > extent) extent = abs(hi[2] - lo[2])
  if (extent < 1e-12) extent = 1
  return extent
}

/** RGB spines + axis names + nice numerical ticks for the first `dim` axes. */
fn _frameLabels(bnds, size=18, ticksize=12, nticks=5) {
  var info = _boundsLoHi(bnds)
  var lo = info[0], hi = info[1], dim = info[2]
  var g = Graphics()
  if (dim < 1) return g

  var tip = 1.08
  var ticklen = 0.06*_boundsExtent(lo, hi, dim)
  var labeloff = 1.8*ticklen
  var tickColor = Color(0.75, 0.75, 0.8)
  var names = ["x", "y", "z"]
  var spineColor = [Red, Green, Blue]

  for (ax in 0...dim) {
    g.display(_segmentLine(_ptOnAxis(lo, ax, lo[ax]), _ptOnAxis(lo, ax, hi[ax]), spineColor[ax]))
    g.display(Text(names[ax], _ptOnAxis(lo, ax, lo[ax] + tip*(hi[ax] - lo[ax])),
                   dirn=[1, 0, 0], vertical=[0, 1, 0], size=size, color=White))
  }

  for (ax in 0...dim) {
    var mark = (ax == 1) ? 0 : 1 // tick into -y for x/z, -x for y
    for (t in _niceTicks(lo[ax], hi[ax], nticks)) {
      var p0 = _ptOnAxis(lo, ax, t)
      var p1 = _pt3(p0)
      p1[mark] = lo[mark] - ticklen
      g.display(_segmentLine(p0, p1, tickColor))

      var lp = _pt3(p0)
      lp[mark] = lo[mark] - labeloff
      g.display(Text(_tickLabel(t), lp,
                     dirn=[1, 0, 0], vertical=[0, 1, 0], size=ticksize, color=White))
    }
  }

  return g
}

/** Merge a Graphics displaylist into Plot, recording each id under role. */
fn _mergeGraphicsInto(plot, gfx, role) {
  for (el in gfx.displaylist) {
    var id = plot._append(el.item, position=el.position, scale=el.scale, rotate=el.rotate,
                          color=el.color, flat=el.flat, notify=false)
    plot._recordEntry(role, id)
  }
}

/** Face normal from triangle winding (no centroid flip). */
fn _faceNormal(v0, v1, v2) {
  return _plotCross3D(v2 - v1, v1 - v0)
}

/** Face normal oriented outward relative to centroid (flat shading only). */
fn _orientedFaceNormal(v0, v1, v2, centroid) {
  var normal = _faceNormal(v0, v1, v2)
  if (normal.inner(v0 - centroid) < 0) normal = -normal
  return normal
}

/** +1 if face winding contains a→b, -1 if b→a, else 0. */
fn _faceEdgeDir(el, a, b) {
  for (j in 0...3) {
    var u = el[j]
    var v = el[(j == 2) ? 0 : j+1]
    if (u == a && v == b) return 1
    if (u == b && v == a) return -1
  }
  return 0
}

/** Orient face normals consistently across the mesh (fixes alternating AreaMesh winding),
 *  then area-weighted average onto vertices. */
fn _smoothVertexNormals(mesh, vertMat, centroid, selection=nil) {
  var nv = mesh.count(0)
  var nf = mesh.count(2)
  var acc = Matrix(3, nv)
  var faces = mesh.connectivitymatrix(0, 2)
  if (!issparse(faces)) return acc

  // Raw winding normals + undirected edge → incident faces.
  var fnorm = Matrix(3, nf)
  var edgefaces = Dictionary()
  for (i in 0...nf) {
    if (isselection(selection) && !selection.isselected(2, i)) continue
    var el = faces.rowindices(i)
    fnorm.setColumn(i, _faceNormal(vertMat.column(el[0]), vertMat.column(el[1]),
                                   vertMat.column(el[2])))
    for (e in [[el[0], el[1]], [el[1], el[2]], [el[2], el[0]]]) {
      var a = e[0], b = e[1]
      var k = (a < b) ? "${a}_${b}" : "${b}_${a}"
      if (!edgefaces.contains(k)) edgefaces[k] = []
      edgefaces[k].append(i)
    }
  }

  // Face adjacency from shared edges.
  var neigh[nf]
  for (i in 0...nf) neigh[i] = []
  for (k in edgefaces) {
    var fs = edgefaces[k]
    if (fs.count() != 2) continue
    neigh[fs[0]].append(fs[1])
    neigh[fs[1]].append(fs[0])
  }

  // Flood-fill: adjacent faces must traverse a shared edge in opposite directions.
  var sign[nf]
  var seen[nf]
  for (i in 0...nf) { sign[i] = 1; seen[i] = false }

  for (seed in 0...nf) {
    if (seen[seed]) continue
    if (isselection(selection) && !selection.isselected(2, seed)) continue
    seen[seed] = true
    // Prefer +z for the seed hemisphere (AreaMesh / open surfaces).
    sign[seed] = (fnorm.column(seed)[2] < 0) ? -1 : 1
    var queue = [seed]
    var qi = 0
    while (qi < queue.count()) {
      var f = queue[qi]
      qi += 1
      var elf = faces.rowindices(f)
      for (g in neigh[f]) {
        if (seen[g]) continue
        if (isselection(selection) && !selection.isselected(2, g)) continue
        var elg = faces.rowindices(g)
        // Find a shared edge and compare winding direction.
        var flipped = false
        var found = false
        for (j in 0...3) {
          var a = elf[j], b = elf[(j == 2) ? 0 : j+1]
          var dirg = _faceEdgeDir(elg, a, b)
          if (dirg == 0) continue
          found = true
          // f has a→b; consistent neighbor has b→a (dirg == -1).
          flipped = (dirg == 1)
          break
        }
        if (!found) continue
        sign[g] = flipped ? -sign[f] : sign[f]
        seen[g] = true
        queue.append(g)
      }
    }
  }

  for (i in 0...nf) {
    if (isselection(selection) && !selection.isselected(2, i)) continue
    var n = sign[i]*fnorm.column(i)
    var el = faces.rowindices(i)
    for (pidx in el) acc.setColumn(pidx, acc.column(pidx) + n)
  }

  for (i in 0...nv) {
    var n = acc.column(i)
    var len = n.norm()
    if (len > 1e-16) acc.setColumn(i, n/len)
    else acc.setColumn(i, Matrix([0, 0, 1]))
  }
  return acc
}

/* *******************************************************************************************
 * ScaleBar — tube TriangleComplex; ScaleBarStrip is an open strip
 ******************************************************************************************* */

class ScaleBar {
  _asVec(val, default, unit=false) {
    if (isnil(val)) val = default
    var out = ismatrix(val) ? val.clone() :
              ((islist(val) || istuple(val)) ? Matrix(val) : nil)
    if (isnil(out) || out.count() != 3) _PltSclBrVctrErr.throw()
    if (unit) {
      var n = out.norm()
      if (n < 1e-12) _PltSclBrVctrErr.throw()
      out /= n
    }
    return out
  }

  _tri(conn, i, a, b, c) {
    conn[a, i] = 1; conn[b, i] = 1; conn[c, i] = 1
    conn.setrowindices(i, (a, b, c))
  }

  init(nticks=5, colormap=nil, length=1, posn=nil, dirn=nil, tickdirn=nil,
       textdirn=nil, textvertical=nil, textcolor=nil, fontsize=16) {
    if (!(length > 1e-12)) _PltSclBrVctrErr.throw()
    self.nticks = nticks
    self.length = length
    self.radius = 0.1*length
    self.nptsamples = 5
    self.npts = 16
    self.fontsize = fontsize
    self.colormap = isnil(colormap) ? ViridisMap() : colormap

    var givenTick = !isnil(tickdirn)
    self.posn = self._asVec(posn, [1, 0, 0])
    self.dirn = self._asVec(dirn, [0, 1, 0], unit=true)
    self.tickdirn = self._asVec(tickdirn, [1, 0, 0], unit=true)
    self.tickdirn -= self.tickdirn.inner(self.dirn)*self.dirn
    var tn = self.tickdirn.norm()
    if (tn < 1e-12) {
      if (givenTick) _PltSclBrVctrErr.throw()
      var a = (abs(self.dirn[0]) < 0.9) ? Matrix([1, 0, 0]) : Matrix([0, 1, 0])
      self.tickdirn = _plotCross3D(self.dirn, a)
      tn = self.tickdirn.norm()
    }
    self.tickdirn /= tn
    self.perp = _plotCross3D(self.tickdirn, self.dirn)
    self.textdirn = self._asVec(textdirn, self.tickdirn, unit=true)
    self.textvertical = self._asVec(textvertical, self.dirn, unit=true)
    self.textcolor = textcolor
  }

  ticks(a, b, nmax) { return _niceTicks(a, b, nmax) }

  coords(x, y, z) {
    return self.posn + x*self.tickdirn + y*self.perp + z*self.dirn
  }

  getFontSize(ticks) {
    var ngap = (ticks.count() > 1) ? ticks.count()-1 : 1
    var size = self.fontsize
    if (size/72 > self.length/ngap) size = floor(self.length/ngap*72)
    return size
  }
  getfontsize(ticks) { return self.getFontSize(ticks) } // [Compatibility shim]

  /** Extrude a (x,y) section along dirn. closed wraps the last edge to the first. */
  _mesh(section, closed) {
    var nsec = section.count()
    var nseg = 2*self.nptsamples
    if (nseg < 1) nseg = 1
    var nslice = nseg + 1, nv = nsec*nslice
    var nt = 2*nseg*(closed ? nsec : nsec-1)
    var L = self.length/2, nch = _plotChannels(self.colormap)
    var pos = Matrix(3, nv), nrm = Matrix(3, nv), col = Matrix(nch, nv)

    for (k in 0...nslice) {
      var z = -L + k*(self.length/nseg)
      var rgb = _plotColorColumn(self.colormap, nch, Float(k)/Float(nseg))
      for (j in 0...nsec) {
        var xy = section[j], x = xy[0], y = xy[1], idx = k*nsec + j
        pos.setColumn(idx, self.coords(x, y, z))
        var n = x*self.tickdirn + y*self.perp, nn = n.norm()
        nrm.setColumn(idx, closed ? ((nn > 1e-12) ? n/nn : self.perp) : self.perp)
        col.setColumn(idx, rgb)
      }
    }

    var conn = Sparse(nv, nt), itri = 0, nj = closed ? nsec : nsec-1
    for (k in 0...nseg) {
      for (j in 0...nj) {
        var jn = (j+1 == nsec) ? 0 : j+1
        var a = k*nsec + j, b = k*nsec + jn, c = (k+1)*nsec + j, d = (k+1)*nsec + jn
        self._tri(conn, itri, a, c, b); itri += 1
        self._tri(conn, itri, b, c, d); itri += 1
      }
    }
    return TriangleComplex(pos, nrm, ColorTable(col), conn)
  }

  _show(tri) {
    var g = Graphics()
    g.display(tri, flat=true)
    return g
  }

  drawBar() {
    var r = self.radius, n = self.npts, sec = []
    for (j in 0...n) {
      var th = 2*Pi*j/n
      sec.append((r*cos(th), r*sin(th)))
    }
    return self._show(self._mesh(sec, true))
  }
  drawbar() { return self.drawBar() } // [Compatibility shim]

  drawLabel(min, max) {
    var ticks = self.ticks(min, max, self.nticks)
    var w = max - min, g = Graphics()
    var fsize = self.getFontSize(ticks)
    var toffset = abs(self.dirn.inner(self.textdirn))
    var tvert = sqrt(1 - toffset^2)
    for (t in ticks) {
      var x = (abs(w) < 1e-12) ? 0 : (t - min)/w - 0.5
      var label = String(t)
      var width = (0.6*label.count()*fsize/72)/2, height = fsize/72
      g.display(Cylinder(self.coords(1.2*self.radius, 0, x*self.length),
                         self.coords(1.5*self.radius, 0, x*self.length), color=White))
      g.display(Text(label,
        self.coords((1.8 + toffset)*self.radius, 0,
                    x*self.length - 0.25*height*tvert - width*toffset),
        size=fsize, dirn=self.textdirn, vertical=self.textvertical, color=self.textcolor))
    }
    return g
  }
  drawlabel(min, max) { return self.drawLabel(min, max) } // [Compatibility shim]

  draw(min, max) { return self.drawBar() + self.drawLabel(min, max) }
}

class ScaleBarStrip is ScaleBar {
  drawBar() {
    var r = self.radius
    return self._show(self._mesh(((-r, 0), (r, 0)), false))
  }
}

fn _wantScalebar(Bool x) { return x }
fn _wantScalebar(ScaleBar x) { return true }
fn _wantScalebar(x) { return false }

fn _scalebarObj(ScaleBar x) { return x }
fn _scalebarObj(x) { return nil }

/* *******************************************************************************************
 * Plot — scientific visualization as a Scene
 ******************************************************************************************* */

class Plot is Scene {
  _setup(source, title=nil, background=nil, axes=false, scalebar=false) {
    super.init(title=title, background=background)
    self.source = source
    self.entries = Dictionary()
    self.bounds = nil
    self.wantAxes = axes
    self.wantScalebar = _wantScalebar(scalebar)
    self.scaleBar = _scalebarObj(scalebar)
    self.colormap = nil
    self.cmin = nil
    self.cmax = nil
    self.center = nil
    // Draw kwargs retained for live colormap/range refresh (Field plots).
    self.selection = nil
    self.grade = nil
    self.style = nil
    self.scale = true
  }

  _finish() {
    if (self.wantAxes) self._drawAxes()
    if (self.wantScalebar) self._drawScalebar()
  }

  _recordEntry(role, id) {
    if (isnil(id)) return
    if (!self.entries.contains(role)) self.entries[role] = []
    self.entries[role].append(id)
  }

  /** Remove every entry under a semantic role and drop the role key. */
  _clearRole(role) {
    if (!self.entries.contains(role)) return
    for (id in self.entries[role]) self.remove(id)
    self.entries.remove(role)
  }

  /** Union with Graphics (`plot + g`). Returns Scene; left-hand ids kept. */
  add(Graphics x) { return super.add(x) }

  /** In-place union (`plot += g`). */
  addr(Graphics x) { return super.addr(x) }

  _drawAxes(nticks=5) {
    if (isnil(self.bounds)) return
    self._recordEntry("axes", self.display(_domainWire(self.bounds, Color(0.55, 0.55, 0.6))))
    _mergeGraphicsInto(self, _frameLabels(self.bounds, nticks=nticks), "axes")
  }

  _drawScalebar() {
    if (self.entries.contains("scalebar")) return
    if (isnil(self.colormap) || isnil(self.cmin) || isnil(self.cmax)) return

    var bar = self.scaleBar
    if (isnil(bar)) {
      var length = 1.0
      var posn = Matrix([1, 0, 0])
      if (!isnil(self.bounds)) {
        var info = _boundsLoHi(self.bounds)
        var lo = info[0], hi = info[1], dim = info[2]
        var sx = hi[0] - lo[0]
        var sy = (dim >= 2) ? (hi[1] - lo[1]) : 1.0
        var sz = (dim >= 3) ? (hi[2] - lo[2]) : 0.0
        var span = abs(sy)
        if (abs(sz) > span) span = abs(sz)
        if (span < 1e-12) span = abs(sx)
        if (span < 1e-12) span = 1.0
        length = span
        var gap = 0.15*((abs(sx) > 1e-12) ? abs(sx) : span)
        posn = Matrix([
          hi[0] + gap,
          (dim >= 2) ? 0.5*(lo[1] + hi[1]) : 0,
          (dim >= 3) ? 0.5*(lo[2] + hi[2]) : 0
        ])
      }
      bar = ScaleBar(length=length, posn=posn, colormap=self.colormap)
    } else {
      bar.colormap = self.colormap
    }
    _mergeGraphicsInto(self, bar.draw(self.cmin, self.cmax), "scalebar")
  }

  /** Toggle domain-frame chrome via stored entry IDs. */
  axes(show) {
    if (show) {
      self.wantAxes = true
      if (!self.entries.contains("axes")) self._drawAxes()
    } else {
      self.wantAxes = false
      self._clearRole("axes")
    }
    return true
  }

  /** Toggle scalebar chrome via stored entry IDs. */
  scalebar(Bool show) {
    if (show) {
      self.wantScalebar = true
      if (!self.entries.contains("scalebar")) self._drawScalebar()
    } else {
      self.wantScalebar = false
      self._clearRole("scalebar")
    }
    return true
  }
  scalebar(ScaleBar bar) {
    self.wantScalebar = true
    self.scaleBar = bar
    self._clearRole("scalebar")
    self._drawScalebar()
    return true
  }

  /** Re-sample Field → rebuild data entries (+ scalebar if present).
   *  MD: refresh() / refresh(view). Optional-nil arity is a Morpho trap — keep overloads. */
  _rebuildField(view) {
    if (!isfield(self.source)) return false

    var hadScalebar = self.entries.contains("scalebar") || self.wantScalebar
    var info = _fieldColors(self.source, selection=self.selection, grade=self.grade,
                            colormap=self.colormap, style=self.style, scale=self.scale,
                            cmin=self.cmin, cmax=self.cmax, center=self.center)
    var mesh = info[0], sel = info[1], showgrades = info[2], col = info[3], cm = info[4], bnd = info[5]
    self.colormap = cm
    self.cmin = bnd[0]
    self.cmax = bnd[1]

    // Live path: same-length faces TriangleComplex → View.morph (U V).
    if (!isnil(view) && _styleHas(self.style, "interpolate") &&
        self.entries.contains("faces") && self.entries["faces"].count() == 1 &&
        !self.entries.contains("points") && !self.entries.contains("lines")) {
      var vertMat = _vertexMatrix3(mesh)
      var bb = _scientificBounds(mesh)
      self.bounds = bb
      var planar = _planarAxis(bb)
      var got = self._facesItem(mesh, sel, col,
                                vertMat, bb, planar, _boundsCentroid(bb), style=self.style)
      if (isnil(got)) return false
      var id = self.entries["faces"][0]
      return view.morph(id, got[0])
    }

    self._clearRole("points")
    self._clearRole("lines")
    self._clearRole("faces")
    self._meshInto(mesh, selection=sel, grade=showgrades, color=col,
                   style=self.style)

    if (hadScalebar) {
      self._clearRole("scalebar")
      self._drawScalebar()
    }
    return true
  }

  /** Headless / full redefine. */
  refresh() {
    return self._rebuildField(nil)
  }

  /** Morph faces through a live View (U V). */
  refresh(view) {
    return self._rebuildField(view)
  }

  /** Replace field colormap and rebuild colored geometry. */
  colormap(cm) {
    if (!isfield(self.source)) return false
    self.colormap = isnil(cm) ? ViridisMap() : cm
    return self._rebuildField(nil)
  }

  /** Set explicit field value range and rebuild. */
  range(cmin, cmax) {
    if (!isfield(self.source)) return false
    self.cmin = cmin
    self.cmax = cmax
    return self._rebuildField(nil)
  }

  /** Clear explicit range (use data bounds) and rebuild. */
  range() {
    if (!isfield(self.source)) return false
    self.cmin = nil
    self.cmax = nil
    return self._rebuildField(nil)
  }

  /** Set diverging-map center and rebuild. */
  center(c) {
    if (!isfield(self.source)) return false
    self.center = c
    return self._rebuildField(nil)
  }

  /** Clear diverging-map center and rebuild. */
  center() {
    if (!isfield(self.source)) return false
    self.center = nil
    return self._rebuildField(nil)
  }

  /** Grade 0: PointCloud by default; style spheres/thick → Sphere loop. */
  _pointsInto(mesh, selection, color, style, vertMat, drawn=nil) {
    var vcol = _plotColorForGrade(0, color, drawn=drawn)
    var np = mesh.count(0)

    if (_styleHas(style, "spheres") || _styleHas(style, "thick")) {
      for (i in _selectedIds(mesh, selection, 0)) {
        self._recordEntry("points",
          self.display(Sphere(vertMat.column(i), 0.025,
                              color=_plotColorForElement(vcol, i))))
      }
      return
    }

    var ids = _selectedIds(mesh, selection, 0)
    var nshow = ids.count()
    if (nshow == 0) return

    var pos = Matrix(3, nshow)
    var perVert = _isPerElementColor(vcol, np)
    var pcol = vcol
    var nch = _plotChannels(vcol)
    if (perVert) pcol = Matrix(nch, nshow)
    for (k in 0...nshow) {
      var i = ids[k]
      pos.setColumn(k, vertMat.column(i))
      if (perVert) pcol.setColumn(k, _plotColorColumn(_plotColorForElement(vcol, i), nch))
    }
    self._recordEntry("points",
      self.display(PointCloud(pos, color=perVert ? ColorTable(pcol) : pcol)))
  }

  /** Grade 1: LineSet by default; style tubes/thick → Cylinder loop.
   *  Per-edge colors duplicate endpoints; uniform color shares mesh verts. */
  _linesInto(mesh, selection, color, style, vertMat, drawn=nil) {
    var lines = mesh.connectivitymatrix(0, 1)
    if (!issparse(lines)) return

    var lcol = _plotColorForGrade(1, color, drawn=drawn)
    var nl = mesh.count(1)

    if (_styleHas(style, "tubes") || _styleHas(style, "thick")) {
      for (i in _selectedIds(mesh, selection, 1)) {
        var el = lines.rowindices(i)
        self._recordEntry("lines",
          self.display(Cylinder(vertMat.column(el[0]), vertMat.column(el[1]),
                                aspectratio=0.05, color=_plotColorForElement(lcol, i))))
      }
      return
    }

    var segs = _selectedIds(mesh, selection, 1)
    var ns = segs.count()
    if (ns == 0) return

    if (_isPerElementColor(lcol, nl)) {
      var nch = _plotChannels(lcol)
      var pos = Matrix(3, 2*ns)
      var ecol = Matrix(nch, 2*ns)
      var edges = []
      for (k in 0...ns) {
        var i = segs[k]
        var el = lines.rowindices(i)
        pos.setColumn(2*k, vertMat.column(el[0]))
        pos.setColumn(2*k + 1, vertMat.column(el[1]))
        var rgb = _plotColorColumn(_plotColorForElement(lcol, i), nch)
        ecol.setColumn(2*k, rgb)
        ecol.setColumn(2*k + 1, rgb)
        edges.append([2*k, 2*k + 1])
      }
      self._recordEntry("lines",
        self.display(LineSet(pos, edges, color=ColorTable(ecol))))
    } else {
      // Uniform color: share mesh vertices; connectivity is selected edges.
      var edges = []
      for (i in segs) {
        var el = lines.rowindices(i)
        edges.append([el[0], el[1]])
      }
      self._recordEntry("lines",
        self.display(LineSet(vertMat, edges, color=lcol)))
    }
  }

  /** Grade 2: TriangleComplex.
   *  Default / per-element / selection → unlit (GraphicsEntry.flat).
   *  style="shaded" or "interpolate" → Phong; smooth vertex normals if non-planar.
   *  Returns (TriangleComplex, unlit) or nil. */
  _facesItem(mesh, selection, color, vertMat, bb, planar, centroid, drawn=nil, style=nil) {
    var faces = mesh.connectivitymatrix(0, 2)
    if (!issparse(faces)) return nil

    var fcol = _plotColorForGrade(2, color, drawn=drawn)
    var nf = mesh.count(2)
    var nnt = isselection(selection) ? selection.idlistforgrade(2).count() : nf

    var perFace = _isPerElementColor(fcol, nf)
    var interpolate = _isPerElementColor(fcol, mesh.count(0)) && !perFace

    // Lit only when asked (shaded) or interpolating a field. Per-element hues stay unlit.
    var wantShade = interpolate || _styleHas(style, "shaded")
    var unlit = !wantShade || (perFace && !interpolate)
    var vnorm = nil
    if (!unlit && isnil(planar)) {
      vnorm = _smoothVertexNormals(mesh, vertMat, centroid, selection=selection)
    }

    // ColorTable only for per-face / interpolated colors (canonical per-vertex).
    // Uniform Coloring is preserved so Color.a is not baked into an RGBA table.
    var perVertex = interpolate || perFace
    var nch = perVertex ? _plotChannels(fcol) : 3
    var nvert = Matrix(3, 3*nnt)
    var norm = Matrix(3, 3*nnt)
    var ncol = perVertex ? Matrix(nch, 3*nnt) : nil
    var tri = Sparse(3*nnt, nnt)

    var nnv = 0
    nnt = 0
    for (i in 0...nf) {
      if (isselection(selection) && !selection.isselected(2, i)) continue

      var el = faces.rowindices(i)
      var v[3]
      for (pidx, j in el) v[j] = vertMat.column(pidx)

      var faceNormal
      if (!isnil(planar)) {
        faceNormal = Matrix(bb.count())
        faceNormal[planar] = 1
      } else if (isnil(vnorm)) {
        faceNormal = _orientedFaceNormal(v[0], v[1], v[2], centroid)
      }

      var tcol
      if (perVertex && !interpolate) tcol = _plotColorColumn(_plotColorForElement(fcol, i), nch)
      for (j in 0...3) {
        tri[nnv, nnt] = 1
        nvert.setColumn(nnv, v[j])
        if (!isnil(vnorm)) norm.setColumn(nnv, vnorm.column(el[j]))
        else norm.setColumn(nnv, faceNormal)
        if (perVertex) {
          if (interpolate) tcol = _plotColorColumn(_plotColorForElement(fcol, el[j]), nch)
          ncol.setColumn(nnv, tcol)
        }
        nnv += 1
      }
      nnt += 1
    }

    return (TriangleComplex(nvert, norm, perVertex ? ColorTable(ncol) : fcol, tri), unlit)
  }

  _facesInto(mesh, selection, color, vertMat, bb, planar, centroid, drawn=nil, style=nil) {
    var got = self._facesItem(mesh, selection, color, vertMat, bb, planar, centroid,
                             drawn=drawn, style=style)
    if (isnil(got)) return
    // Unlit facets unless style="shaded" or interpolate (Phong; smooth normals if curved).
    self._recordEntry("faces", self.display(got[0], flat=got[1]))
  }

  /** Display mesh grades. Default: PointCloud / LineSet / TriangleComplex. */
  _meshInto(mesh, selection=nil, grade=nil, color=nil, style=nil) {
    var glist = _gradeList(mesh, grade)
    var drawn = _presentGrades(mesh, glist)
    var vertMat = _vertexMatrix3(mesh)
    var bb = _scientificBounds(mesh)
    self.bounds = bb
    var planar = _planarAxis(bb)
    var centroid = _boundsCentroid(bb)

    if (_wantsGrade(glist, 0)) {
      self._pointsInto(mesh, selection, color, style, vertMat, drawn=drawn)
    }
    if (_wantsGrade(glist, 1)) {
      self._linesInto(mesh, selection, color, style, vertMat, drawn=drawn)
    }
    if (_wantsGrade(glist, 2)) {
      self._facesInto(mesh, selection, color, vertMat, bb, planar, centroid,
                     drawn=drawn, style=style)
    }
  }

  _drawMesh(mesh, selection=nil, grade=nil, color=nil, style=nil) {
    self._meshInto(mesh, selection=selection, grade=grade, color=color, style=style)
  }

  _drawSelection(sel, mesh=nil, grade=nil, color=nil, style=nil) {
    var m = _selectionMesh(sel, mesh)
    var col = isnil(color) ? _selectionColors(m, sel, grade) : color
    self._meshInto(m, grade=grade, color=col, style=style)
  }

  _drawField(field, selection=nil, grade=nil, colormap=nil, style=nil, scale=true,
             cmin=nil, cmax=nil, center=nil) {
    self.selection = selection
    self.grade = grade
    self.style = style
    self.scale = scale

    var info = _fieldColors(field, selection=selection, grade=grade, colormap=colormap,
                            style=style, scale=scale, cmin=cmin, cmax=cmax, center=center)
    var mesh = info[0], sel = info[1], showgrades = info[2], col = info[3], cm = info[4], bnd = info[5]
    self.colormap = cm
    self.cmin = bnd[0]
    self.cmax = bnd[1]
    self.center = center
    self._meshInto(mesh, selection=sel, grade=showgrades, color=col, style=style)
  }

  init(Mesh mesh, selection=nil, grade=nil, color=nil,
       title=nil, background=nil, axes=false, scalebar=false, style=nil) {
    self._setup(mesh, title=title, background=background, axes=axes, scalebar=scalebar)
    self._drawMesh(mesh, selection=selection, grade=grade, color=color, style=style)
    self._finish()
  }

  init(Selection sel, mesh=nil, grade=nil, color=nil,
       title=nil, background=nil, axes=false, scalebar=false, style=nil) {
    self._setup(sel, title=title, background=background, axes=axes, scalebar=scalebar)
    self._drawSelection(sel, mesh=mesh, grade=grade, color=color, style=style)
    self._finish()
  }

  init(Field field, selection=nil, grade=nil, colormap=nil, style=nil, scale=true,
       scalebar=false, cmin=nil, cmax=nil, center=nil,
       title=nil, background=nil, axes=false) {
    self._setup(field, title=title, background=background, axes=axes, scalebar=scalebar)
    self._drawField(field, selection=selection, grade=grade, colormap=colormap, style=style,
                    scale=scale, cmin=cmin, cmax=cmax, center=center)
    self._finish()
  }
}

/* *******************************************************************************************
 * Legacy veneers — one implementation path through Plot
 ******************************************************************************************* */

fn plotmesh(mesh, selection=nil, grade=nil, color=nil, style=nil, filter=nil, transmit=nil) {
  return Plot(mesh, selection=selection, grade=grade,
              color=_plotLegacyTransp(color, filter, transmit), // [Compatibility shim]
              style=_legacyStyle(style))
}

fn plotselection(mesh, selection, grade=nil, style=nil, filter=nil, transmit=nil) {
  var col = nil
  if (!isnil(filter) || !isnil(transmit)) {
    var m = _selectionMesh(selection, mesh)
    col = _plotLegacyTransp(_selectionColors(m, selection, grade), filter, transmit) // [Compatibility shim]
  }
  return Plot(selection, mesh=mesh, grade=grade, style=_legacyStyle(style), color=col)
}

fn plotfield(field, selection=nil, grade=nil, colormap=nil, style=nil, scale=true,
             scalebar=nil, cmin=nil, cmax=nil, center=nil, filter=nil, transmit=nil) {
  var cm = colormap
  if (!isnil(filter) || !isnil(transmit)) {
    cm = _plotLegacyTransp(isnil(cm) ? ViridisMap() : cm, filter, transmit) // [Compatibility shim]
  }
  return Plot(field, selection=selection, grade=grade, colormap=cm,
              style=_legacyStyle(style), scale=scale,
              scalebar=scalebar, cmin=cmin, cmax=cmax, center=center)
}

/** Arrow RGB triad (distinct from axes=true domain frame). */
fn plotaxes(xx0, size=1) {
  var x0 = islist(xx0) ? Matrix(xx0) : xx0
  var axes = Graphics()
  axes.display(Arrow(x0, x0 + Matrix([size, 0, 0]), color=Red))
  axes.display(Arrow(x0, x0 + Matrix([0, size, 0]), color=Green))
  axes.display(Arrow(x0, x0 + Matrix([0, 0, size]), color=Blue))
  return axes
}

fn plotmeshlabels(mesh, grade=0, selection=nil, fontsize=10, offset=nil, dirn=nil, vertical=nil, color=nil) {
  var gradelist = (islist(grade) || istuple(grade)) ? grade : [grade]
  var gout = Graphics()
  var dir = isnil(dirn) ? [1, 0, 0] : dirn
  var vert = isnil(vertical) ? [0, 1, 0] : vertical

  fn _defaultOffset(x) { return 0.05*(x + Matrix([0.001, 0, 0])) }

  var off = offset
  if (islist(off)) off = Matrix(offset)
  if (isnil(off)) off = _defaultOffset
  var dcol = isnil(color) ? White : color

  for (g in gradelist) {
    var col = dcol
    if (isdictionary(color)) col = color.contains(g) ? color[g] : White

    for (id in 0...mesh.count(g)) {
      if (!isnil(selection) && !selection[g, id]) continue
      var x = _to3D(_centroid(mesh, g, id))
      if (iscallable(dirn)) dir = dirn(x)
      if (iscallable(vertical)) vert = vertical(x)
      var o = iscallable(off) ? off(x) : off
      gout.display(Text("${id}", x + o, size=fontsize, dirn=dir, vertical=vert, color=col))
    }
  }
  return gout
}
