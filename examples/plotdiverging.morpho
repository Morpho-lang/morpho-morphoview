// Diverging colormap with center=0.
// Signed field on a warped surface — zero maps to white (BlueWhiteRed mid).
//
//   morpho6 examples/plotdiverging.morpho
//
// Close the viewer window to exit.

import morphoview
import meshtools
import plot
import color

var m = AreaMesh(fn (u, v) [u, v, 0.2*sin(2*u)*cos(3*v)],
                 -Pi..Pi:Pi/12, -Pi..Pi:Pi/12)

var f = Field(m, fn (x, y, z) x)

var p = Plot(f, style="interpolate",
             colormap=BlueWhiteRedMap,
             cmin=-Pi, cmax=Pi, center=0,
             axes=true, scalebar=true,
             title="Plot diverging",
             background=Color(0.08, 0.09, 0.11))

var v = View(p, connecttimeout=20000)
v.wait()
if (!v.closed) v.close()
