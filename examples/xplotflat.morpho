// xplot: flat mesh in the xy-plane through the origin + interesting field.
// Exercises the planar-normal path (constant +z) with interpolate coloring.
//
//   morpho6 examples/xplotflat.morpho
//
// Close the viewer window to exit.
// Requires: morphoview on PATH, morpho-zeromq, display.

import morphoview
import meshtools
import xplot
import xcolor

// Axis-aligned rectangle in z=0, centered on the origin.
var m = AreaMesh(fn (u, v) [u, v, 0],
                 -1.5..1.5:0.05, -1.5..1.5:0.05)

// Soft-envelope quadrupole (signed → diverging map); no atan2 needed.
fn quadrupole(x, y, z) {
  var r2 = x*x + y*y
  return exp(-0.55*r2)*(x*x - y*y)*cos(5*sqrt(r2))
}
var f = Field(m, quadrupole)

var p = Plot(f, style="interpolate",
             colormap=BlueWhiteRedMap,
             center=0,
             axes=true, scalebar=true,
             title="xplotflat (xy through origin)",
             background=Color(0.08, 0.09, 0.11))

var v = View(p, connecttimeout=20000)
v.wait()
if (!v.closed) v.close()
