// Field plot with domain-frame axes and a colormap scalebar.
//
//   morpho6 examples/plotaxes.morpho
//
// Close the viewer window to exit.

import morphoview
import meshtools
import plot
import color

var m = AreaMesh(fn (u, v) [u, v, 0.15*sin(3*u)*cos(2*v)],
                 -1..1:0.25, -1..1:0.25)
var f = Field(m, fn (x, y, z) x)

var p = Plot(f, style="interpolate", colormap=ViridisMap(),
             axes=true, scalebar=true,
             title="Plot axes",
             background=Color(0.08, 0.09, 0.11))

var v = View(p, connecttimeout=20000)
v.wait()
if (!v.closed) v.close()
