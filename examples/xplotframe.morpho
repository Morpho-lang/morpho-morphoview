// xplot Phase 3 yardstick: domain frame axes + optional colorbar.
//
//   morpho6 examples/xplotframe.morpho
//
// Close the viewer window to exit.
// Requires: morphoview on PATH, morpho-zeromq, display.

import morphoview
import meshtools
import xplot
import xcolor

var m = AreaMesh(fn (u, v) [u, v, 0.15*sin(3*u)*cos(2*v)],
                 -1..1:0.25, -1..1:0.25)
var f = Field(m, fn (x, y, z) x)

var p = Plot(f, style="interpolate", colormap=ViridisMap(),
             axes=true, colorbar=true,
             title="xplotframe (axes + colorbar)",
             background=Color(0.08, 0.09, 0.11))

var v = View(p, connecttimeout=20000)
v.wait()
if (!v.closed) v.close()
