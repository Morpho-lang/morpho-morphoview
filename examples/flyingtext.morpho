// Flying text yardstick — Text draw-slots with live move / recolor (Phase 5f).
// Unicode, emoji (🦋), and math symbols — define once, animate with Scene.move.
//
//   morpho6 examples/flyingtext.morpho
//
// Close the viewer window (or wait for the run to finish) to exit.

import morphoview
import xgraphics
import xcolor
import constants

var dt = 1/50
var nFrames = 1800   // ~36 s
var recolorEvery = 20

var fonts = FontFinder()
var symbolFont = fonts.symbol()
var cjkFont = fonts.cjk()

/** Each label: string, font (nil → default), point size. */
var labels = [
  ["🦋", symbolFont, 32],
  ["morpho", nil, 20],
  ["∑ ∫ ∞", symbolFont, 24],
  ["∇ · π", symbolFont, 22],
  ["α → Ω", symbolFont, 20],
  ["view", nil, 18],
  ["こんにちは", cjkFont, 18],
  ["Olá!", nil, 18],
  ["♥", symbolFont, 26],
  ["√2 ≈ 1.414", symbolFont, 16]
]

var palette = [
  White,
  Color(0.95, 0.45, 0.75),   // butterfly pink
  Color(0.3, 0.85, 1),
  Yellow,
  Color(0.5, 1, 0.4),
  Color(1, 0.55, 0.25),
  Red,
  Color(0.7, 0.75, 1),
  Color(1, 0.4, 0.55),
  Color(0.85, 0.9, 0.4)
]

var g = Scene(title="Flying text", background=Color(0.06, 0.07, 0.09))
var ids = []
var phases = []
var n = labels.count()

for (i in 0...n) {
  var a = 2*Pi*Float(i)/Float(n)
  phases.append(a)
  var x = 1.4*cos(a)
  var y = 0.45*sin(2*a)
  var z = 1.4*sin(a)
  var lab = labels[i]
  ids.append(g.display(Text(lab[0], [x, y, z], size=lab[2], font=lab[1],
                            color=palette[i])))
}

var v = View(g, connecttimeout=20000)

for (frame in 1...nFrames) {
  if (v.closed) break
  var t = Float(frame)*dt
  g.beginBatch()
  for (i in 0...ids.count()) {
    var ph = phases[i]
    var a = ph + 0.42*t
    var r = 1.25 + 0.35*sin(0.55*t + ph)
    var x = r*cos(a)
    var y = 0.65*sin(1.1*t + 2*ph)
    var z = r*sin(a)
    // Pulse size; tumble about a drifting axis
    var scl = 0.75 + 0.45*sin(1.4*t + 1.7*ph)
    var ang = 0.9*t + ph
    var ax = sin(0.3*t + ph)
    var ay = cos(0.25*t + 1.3*ph)
    var az = 0.4*sin(0.2*t + 0.7*ph)
    g.move(ids[i], [x, y, z], scale=scl, rotate=[ang, ax, ay, az])
  }
  // Recolor sparsely — color stamps force a GL prepare; pose-only moves do not.
  if (frame - recolorEvery*Int(Float(frame)/Float(recolorEvery)) == 0) {
    for (i in 0...ids.count()) {
      var ci = i + Int(0.28*t)
      ci = ci - palette.count()*Int(Float(ci)/Float(palette.count()))
      g.recolor(ids[i], palette[ci])
    }
  }
  g.endBatch()
  System.sleep(dt)
  v.poll(timeoutms=0)
}

if (!v.closed) v.close()
