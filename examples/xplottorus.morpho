// xplot demo: ImplicitMesh torus with domain frame + axis labels.
//
//   morpho6 examples/xplottorus.morpho
//
// Close the viewer window to exit.
// Requires: morphoview on PATH, morpho-zeromq, display.

import morphoview
import implicitmesh
import xplot
import xcolor

// Major radius r, tube radius a
var r = 1.0
var a = 0.35

var impl = ImplicitMeshBuilder(
  fn (x, y, z) (x^2+y^2+z^2+r^2-a^2)^2 - 4*r^2*(x^2+y^2)
)
var mesh = impl.build(start=Matrix([1, 0, 0.5]), stepsize=0.2, maxiterations=800)
mesh.addgrade(1)

// Color by height so the surface reads clearly inside the frame.
var f = Field(mesh, fn (x, y, z) z)
var p = Plot(f, style="interpolate", colormap=ViridisMap(),
             axes=true,
             title="xplottorus",
             background=Color(0.08, 0.09, 0.11))

var v = View(p, connecttimeout=20000)
v.wait()
if (!v.closed) v.close()
