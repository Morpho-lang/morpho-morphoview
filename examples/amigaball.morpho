// Amiga-style "Boing" bouncing ball — live MorphoView session.
// Red/white checkered ball, checkerboard floor, soft shadow, bounce physics.
//
//   morpho6 examples/amigaball.morpho
//
// Close the viewer window (or wait for the run to finish) to exit.
// Requires: morphoview on PATH, morpho-zeromq, display.

import morphoview
import xgraphics
import color
import constants

/* ---- world ---- */
var floorHalf = 3.0
var floorTiles = 8
var ballR = 0.55
var wall = floorHalf - ballR - 0.05
var gravity = -14.0
var restitution = 0.92
var dt = 1/60
var nFrames = 900            // ~15s; close the window anytime
var nCheck = 8

/* ---- unit checkered ball (painted once) ---- */
fn checkersphere(ncheck) {
  var s = Sphere([0, 0, 0], 1, color=Red, maxrefine=2)
  var t = s.totrianglecomplex()
  var x = t.position
  var nv = x.dimensions()[1]
  var col = Matrix(3, nv)

  for (i in 0...nv) {
    var px = x[0, i]
    var py = x[1, i]
    var pz = x[2, i]
    var theta = acos(py)
    var rxz = sqrt(px*px + pz*pz)
    var phi = 0.0
    if (rxz > 1e-8) {
      phi = acos(px/rxz)
      if (pz < 0) phi = -phi
    }
    var u = Int((phi + Pi)/(2*Pi)*ncheck)
    var v = Int(theta/Pi*ncheck)
    var parity = u + v - 2*Int(Float(u + v)/2)
    if (parity == 0) {
      col[0, i] = 0.92; col[1, i] = 0.05; col[2, i] = 0.08
    } else {
      col[0, i] = 0.98; col[1, i] = 0.98; col[2, i] = 0.96
    }
  }
  t.colors = col
  return t
}

var unitBall = checkersphere(nCheck)
var ballBase = unitBall.position.clone()
var ballNrm = unitBall.normals.clone()
var ballCol = unitBall.colors
var ballConn = unitBall.connectivity
var ballNv = ballBase.dimensions()[1]

/* Spin about z (classic Boing roll when moving in x). */
fn ballat(cx, cy, cz, angle) {
  var c = cos(angle)
  var s = sin(angle)
  var pos = ballBase.clone()
  var nrm = ballNrm.clone()
  for (i in 0...ballNv) {
    var x = ballBase[0, i]
    var y = ballBase[1, i]
    var z = ballBase[2, i]
    var xr = c*x + s*z
    var zr = -s*x + c*z
    pos[0, i] = ballR*xr + cx
    pos[1, i] = ballR*y + cy
    pos[2, i] = ballR*zr + cz

    x = ballNrm[0, i]
    y = ballNrm[1, i]
    z = ballNrm[2, i]
    nrm[0, i] = c*x + s*z
    nrm[1, i] = y
    nrm[2, i] = -s*x + c*z
  }
  return TriangleComplex(pos, nrm, ballCol, ballConn)
}

/* Checkerboard floor — duplicated verts so tile colors stay hard-edged. */
fn floorboard(half, n, y) {
  var nv = n*n*4
  var pos = Matrix(3, nv)
  var nrm = Matrix(3, nv)
  var col = Matrix(3, nv)
  var triplets = []
  var h = 2*half/Float(n)
  var vi = 0
  var fi = 0

  for (j in 0...n) {
    for (i in 0...n) {
      var x0 = -half + Float(i)*h
      var z0 = -half + Float(j)*h
      var x1 = x0 + h
      var z1 = z0 + h
      var parity = i + j - 2*Int(Float(i + j)/2)
      var r = 0.18
      var g = 0.20
      var b = 0.38
      if (parity != 0) {
        r = 0.62; g = 0.64; b = 0.78
      }

      pos[0, vi] = x0; pos[1, vi] = y; pos[2, vi] = z0
      pos[0, vi+1] = x1; pos[1, vi+1] = y; pos[2, vi+1] = z0
      pos[0, vi+2] = x1; pos[1, vi+2] = y; pos[2, vi+2] = z1
      pos[0, vi+3] = x0; pos[1, vi+3] = y; pos[2, vi+3] = z1

      for (k in 0...4) {
        nrm[1, vi+k] = 1
        col[0, vi+k] = r; col[1, vi+k] = g; col[2, vi+k] = b
      }

      triplets.append([vi, fi, 1])
      triplets.append([vi+1, fi, 1])
      triplets.append([vi+2, fi, 1])
      fi += 1
      triplets.append([vi, fi, 1])
      triplets.append([vi+2, fi, 1])
      triplets.append([vi+3, fi, 1])
      fi += 1
      vi += 4
    }
  }
  return TriangleComplex(pos, nrm, col, Sparse(triplets))
}

var floorMesh = floorboard(floorHalf, floorTiles, 0)

/* Soft elliptical shadow on the floor (grows with height). */
fn shadowat(cx, cz, radius) {
  var n = 20
  var pos = Matrix(3, n+1)
  var nrm = Matrix(3, n+1)
  var col = Matrix(3, n+1)
  var triplets = []

  pos[0, 0] = cx; pos[1, 0] = 0.02; pos[2, 0] = cz
  nrm[1, 0] = 1
  col[0, 0] = 0.05; col[1, 0] = 0.05; col[2, 0] = 0.08

  for (i in 0...n) {
    var a = 2*Pi*Float(i)/Float(n)
    pos[0, i+1] = cx + radius*cos(a)
    pos[1, i+1] = 0.02
    pos[2, i+1] = cz + radius*0.55*sin(a)
    nrm[1, i+1] = 1
    col[0, i+1] = 0.05; col[1, i+1] = 0.05; col[2, i+1] = 0.08
  }

  for (i in 0...n) {
    var j = i + 1
    if (j == n) j = 0
    triplets.append([0, i, 1])
    triplets.append([i+1, i, 1])
    triplets.append([j+1, i, 1])
  }

  var sh = TriangleComplex(pos, nrm, col, Sparse(triplets))
  sh.transmit = 0.55
  return sh
}

fn scene(cx, cy, cz, angle) {
  var g = Graphics()
  g.title = "Amiga Boing"
  g.display(floorMesh)
  var height = cy - ballR
  if (height < 0) height = 0
  g.display(shadowat(cx, cz, ballR*(1.15 + 0.35*height)))
  g.display(ballat(cx, cy, cz, angle))
  return g
}

/* ---- bounce ---- */
var x = -1.2
var y = 2.4
var z = 0.4
var vx = 2.8
var vy = 0.0
var vz = 1.6
var angle = 0.0

var v = View(connectTimeOut=10000)
if (!v.open(scene(x, y, z, angle))) {
  print "open failed"
} else {
  for (frame in 1...nFrames) {
    if (v.closed) break

    vy += gravity*dt
    x += vx*dt
    y += vy*dt
    z += vz*dt

    if (y < ballR) {
      y = ballR
      vy = -vy*restitution
      if (abs(vy) < 0.4) vy = 0
    }

    if (x > wall)  { x = wall;  vx = -abs(vx) }
    if (x < -wall) { x = -wall; vx =  abs(vx) }
    if (z > wall)  { z = wall;  vz = -abs(vz) }
    if (z < -wall) { z = -wall; vz =  abs(vz) }

    angle += sqrt(vx*vx + vz*vz)/ballR*dt

    if (!v.update(scene(x, y, z, angle))) break
    System.sleep(dt)
    v.poll(timeoutMs=0)
  }

  if (!v.closed) v.close()
  print "ok"
}
