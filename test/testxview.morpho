// Live XView session: SceneSerializer over ZMQ.
// Expect: a morphoview window, then "ok".
// Requires: morphoview on PATH, morpho-zeromq, display.
//
//   cd test && morpho6 testxview.morpho

import graphicsserializer
import graphics
import color

fn expect(cond, msg) {
  if (!cond) {
    print "FAIL: ${msg}"
    System.exit()
  }
}

fn tri() {
  return TriangleComplex(
    Matrix([[-0.5, 0.5, 0], [-0.5, -0.5, 0.5], [0, 0, 0]]),
    Matrix([[0, 0, 0], [0, 0, 0], [1, 1, 1]]),
    Matrix([[1, 1, 1], [0.4, 0.4, 0.4], [0.1, 0.1, 0.1]]),
    Matrix([[1], [1], [1]])
  )
}

var g = Scene()
g.title = "XView"
var idSph = g.display(Sphere([0, 0, 0], 1, color=Red), [-0.8, 0.4, 0], scale=0.25)
var idCyl = g.display(Cylinder([0, 0, 0], [0, 0.6, 0], n=8, color=Green), [0.2, 0, 0])
var idArr = g.display(Arrow([0, 0, 0], [0.5, 0, 0], n=8, color=Blue), [0, -0.5, 0])
var idTri = g.display(tri(), [0.8, 0.3, 0], scale=0.6)
var idTxt = g.display(Text("XView", [0, 0, 0], color=White), [0, 0.7, 0])
var idPC = g.display(PointCloud([[0, 0, 0], [0.15, 0, 0], [0, 0.15, 0]], color=Yellow),
                    [-0.6, -0.5, 0])
var idLS = g.display(LineSet([[0, 0, 0], [0.4, 0, 0]], color=White), [0.4, -0.6, 0])

print "opening XView..."
var v = XView(g)
expect(!v.closed, "XView opened")
expect(!isnil(v.serializer), "SceneSerializer bound")

for (i in 1...12) {
  if (v.closed) {
    print "FAIL: closed during move ${i}"
    System.exit()
  }
  var t = Float(i)
  g.move(idSph, [-0.8 + 0.02*t, 0.4, 0], scale=0.25 + 0.04*t)
  g.move(idCyl, [0.2, 0.02*sin(0.4*t), 0])
  g.move(idTxt, [0.05*sin(0.3*t), 0.7, 0])
  g.move(idTri, rotate=[0.15*t, 0, 0, 1])
  System.sleep(0.08)
  v.poll(timeoutms=0)
}

g.recolor(idSph, Cyan)
System.sleep(0.2)
v.poll(timeoutms=0)
expect(!v.closed, "open after recolor")

g.remove(idPC)
System.sleep(0.15)
v.poll(timeoutms=0)
expect(!v.closed, "open after remove")

expect(g.replace(idCyl, Arrow([0, 0, 0], [0, 0.6, 0], n=8, color=Magenta)),
       "Cylinder -> Arrow")
System.sleep(0.2)
v.poll(timeoutms=0)
expect(!v.closed, "open after replace")

expect(g.replace(idTxt, tri()), "Text -> TriangleComplex")
System.sleep(0.2)
v.poll(timeoutms=0)
expect(!v.closed, "open after Text replace")

g.title = "XView reset"
expect(v.update(g), "update(Scene) rebuild")
expect(!v.closed, "open after update")
expect(!isnil(v.serializer), "serializer rebound")
g.move(idSph, [0, 0.4, 0], scale=0.35)
System.sleep(0.15)
v.poll(timeoutms=0)
expect(!v.closed, "live pose after reset")

var idNew = g.display(Sphere([0, 0, 0], 1, color=Orange), [0.5, -0.2, 0], scale=0.2)
System.sleep(0.15)
v.poll(timeoutms=0)
expect(!v.closed, "Defined while listening")

g.beginBatch()
g.move(idSph, [-0.4, 0.3, 0])
g.move(idArr, [0.1, -0.4, 0])
g.endBatch()
System.sleep(0.15)
v.poll(timeoutms=0)
expect(!v.closed, "coalesced multi-id move")

g.setLights("threepoint")
System.sleep(0.15)
v.poll(timeoutms=0)
g.setLights([Light([-2, 1, 2], color=White, intensity=1)])
System.sleep(0.15)
v.poll(timeoutms=0)
g.resetLights()
System.sleep(0.15)
v.poll(timeoutms=0)
expect(!v.closed, "live lighting including Neutral reset")

expect(v.morph(idTri, tri()), "View.morph redefine")
System.sleep(0.15)
v.poll(timeoutms=0)
expect(!v.closed, "open after morph")

if (!v.closed) v.close()
expect(v.closed, "closed")
expect(!g.listeners.contains(v), "detached after close")
print "ok"
