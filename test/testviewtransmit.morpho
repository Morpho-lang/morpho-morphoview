// Translucent spheres via Color.a → View.
// A few overlapping colored spheres; depth sort should keep nearer ones on top.
// Expect: window opens; prints "ok" on close / timeout.
// Requires: morphoview on PATH, morpho-zeromq, display, xgraphics, xcolor.
//
//   cd test && morpho6 testviewtransmit.morpho

import morphoview
import xgraphics
import xcolor

fn glassSpheres() {
  var g = Graphics()
  g.title = "alpha spheres"

  g.display(Sphere([-0.38, 0.0, 0.0], 0.28, color=Red.opacity(0.45), maxrefine=2))
  g.display(Sphere([ 0.38, 0.0, 0.0], 0.28, color=Blue.opacity(0.45), maxrefine=2))
  g.display(Sphere([ 0.0,  0.38, 0.12], 0.24, color=Green.opacity(0.55), maxrefine=2))
  g.display(Sphere([ 0.0, -0.32, 0.22], 0.22, color=Yellow.opacity(0.5), maxrefine=2))

  return g
}

var v = View()
if (!v.open(glassSpheres())) {
  print "open failed"
} else {
  v.wait(sessiontimeout=8000)
  print "ok"
}
