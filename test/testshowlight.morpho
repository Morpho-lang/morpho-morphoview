// Show emits L from Graphics.light; empty list is Neutral (no L line).
// Expect: prints "ok" then exits.
//
//   cd test && morpho6 testshowlight.morpho

import xgraphics
import xshow
import xcolor

class Buf {
  init() { self.lines = [] }
  write(line) { self.lines.append(line) }
}

fn expect(cond, msg) {
  if (!cond) {
    print "FAIL: ${msg}"
    System.exit()
  }
}

fn anyExact(lines, want) {
  for (line in lines) {
    if (line == want) return true
  }
  return false
}

fn anyStarts(lines, prefix) {
  for (line in lines) {
    if (line.count() >= prefix.count()) {
      var ok = true
      for (i in 0...prefix.count()) {
        if (line[i] != prefix[i]) { ok = false; break }
      }
      if (ok) return true
    }
  }
  return false
}

fn anyHasL(lines) {
  for (line in lines) {
    if (line.count() >= 2 && line[0] == "L" && line[1] == " ") return true
    if (line == "L 0") return true
  }
  return false
}

var sph = Sphere([0, 0, 0], 1, color=Red)

var g0 = Graphics()
g0.display(sph)
var b0 = Buf()
Show().write(g0, b0)
expect(!anyHasL(b0.lines), "nil light omits L")

var gn = Graphics()
gn.light = "neutral"
gn.display(sph)
var bn = Buf()
Show().write(gn, bn)
expect(anyExact(bn.lines, "L \"neutral\""), "neutral emits L \"neutral\"")

var ga = Graphics()
ga.light = "auto"
ga.display(sph)
var ba = Buf()
Show().write(ga, ba)
expect(anyExact(ba.lines, "L \"neutral\""), "auto aliases neutral")

var gt = Graphics()
gt.light = "threepoint"
gt.display(sph)
var bt = Buf()
Show().write(gt, bt)
expect(anyExact(bt.lines, "L \"threepoint\""), "threepoint emits L \"threepoint\"")

var gx = Graphics()
gx.light = Matrix([-2.5, 0.4, 0.2])
gx.display(sph)
var bx = Buf()
Show().write(gx, bx)
expect(anyStarts(bx.lines, "L 1 \"xc\""), "Matrix emits L 1 \"xc\"")

var gxyz = Graphics()
gxyz.light = [-2.5, 0.4, 0.2]
gxyz.display(sph)
var bxyz = Buf()
Show().write(gxyz, bxyz)
expect(anyStarts(bxyz.lines, "L 1 \"xc\""), "[x,y,z] is one lamp, not three")

var gtup = Graphics()
gtup.light = (-2.5, 0.4, 0.2)
gtup.display(sph)
var btup = Buf()
Show().write(gtup, btup)
expect(anyStarts(btup.lines, "L 1 \"xc\""), "(x,y,z) is one lamp")

var g2 = Graphics()
g2.light = [Matrix([10, 10, 10]), Matrix([-10, -10, 10])]
g2.display(sph)
var b2 = Buf()
Show().write(g2, b2)
expect(anyStarts(b2.lines, "L 2 \"xc\""), "two matrices emit L 2 \"xc\"")

var gZ = Graphics()
gZ.light = []
gZ.display(sph)
var bz = Buf()
Show().write(gZ, bz)
expect(!anyHasL(bz.lines), "empty list is Neutral (no L line)")
expect(islist(g0.light) && g0.light.count() == 0, "Graphics() stores empty light list")

var gOff = Graphics()
gOff.light = "off"
gOff.display(sph)
var bOff = Buf()
Show().write(gOff, bOff)
expect(anyExact(bOff.lines, "L \"off\""), "off emits L \"off\"")

var gAdd = Graphics()
gAdd.display(sph)
gAdd.addLight([-2.5, 0.4, 0.2])
var bAdd = Buf()
Show().write(gAdd, bAdd)
expect(anyStarts(bAdd.lines, "L 1 \"xc\""), "addLight white lamp emits L 1 \"xc\"")
expect(gAdd.light.count() == 1, "addLight stores one Light")

var gCol = Graphics()
gCol.display(sph)
gCol.addLight(Light([-10, 5, 8], color=Red, intensity=0.4))
var bCol = Buf()
Show().write(gCol, bCol)
expect(anyStarts(bCol.lines, "L 1 \"xc\""), "colored Light emits xc")
expect(anyExact(bCol.lines, "L 1 \"xc\" -10 5 8 0.4 0 0"), "xc includes scaled RGB")

gAdd.addLight([1, 2, 3])
expect(gAdd.light.count() == 2, "second addLight appends")
gAdd.resetLights()
expect(gAdd.light.count() == 0, "resetLights clears to Neutral")
var bRst = Buf()
Show().write(gAdd, bRst)
expect(!anyHasL(bRst.lines), "resetLights Show omits L")

var bLive = Buf()
Show().writeLights([], bLive)
expect(anyExact(bLive.lines, "L \"neutral\""), "live writeLights empty emits L \"neutral\"")

var gTPAdd = Graphics()
gTPAdd.light = "threepoint"
gTPAdd.addLight([1, 0, 0])
expect(islist(gTPAdd.light) && gTPAdd.light.count() == 1, "addLight replaces threepoint")

var gInit = Graphics(light="auto")
expect(gInit.light == "neutral", "Graphics(light=) canonicalizes auto")
var bi = Buf()
Show().write(gInit, bi)
expect(anyExact(bi.lines, "L \"neutral\""), "init light=auto emits L \"neutral\"")

var badName = false
try {
  var gBad = Graphics()
  gBad.light = "studio"
  Show().write(gBad, Buf())
} catch {
  "GfxLightName" : badName = true
}
expect(badName, "unknown light name throws")

var badPos = false
try {
  var g2v = Graphics()
  g2v.light = [1, 2]
  Show().write(g2v, Buf())
} catch {
  "GfxLightPos" : badPos = true
}
expect(badPos, "2-vector lamp throws")

var badN = false
try {
  var g5 = Graphics()
  g5.light = [Matrix([0,0,0]), Matrix([1,0,0]), Matrix([2,0,0]), Matrix([3,0,0]), Matrix([4,0,0])]
  Show().write(g5, Buf())
} catch {
  "GfxLightN" : badN = true
}
expect(badN, "five lamps throw")

var badAdd = false
try {
  var g4 = Graphics()
  for (i in 0...4) g4.addLight([i, 0, 0])
  g4.addLight([4, 0, 0])
} catch {
  "GfxLightN" : badAdd = true
}
expect(badAdd, "fifth addLight throws")

print "ok"
