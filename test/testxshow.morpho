// XShow IR smoke test and Show parity. Does not open a morphoview window.
// For a live viewer, run testxview.morpho.
// Expect: prints "ok" then exits.
//
//   cd test && morpho6 testxshow.morpho

import graphicsserializer
import xshow
import graphics
import color

class Buf {
  init() { self.lines = [] }
  write(line) { self.lines.append(line) }
}

fn countPrefix(lines, prefix) {
  var n = 0
  for (line in lines) {
    if (line.count() >= prefix.count()) {
      var ok = true
      for (i in 0...prefix.count()) {
        if (line[i] != prefix[i]) { ok = false; break }
      }
      if (ok) n += 1
    }
  }
  return n
}

fn firstPrefix(lines, prefix) {
  for (line in lines) {
    if (line.count() >= prefix.count()) {
      var ok = true
      for (j in 0...prefix.count()) {
        if (line[j] != prefix[j]) { ok = false; break }
      }
      if (ok) return line
    }
  }
  return nil
}

fn expect(cond, msg) {
  if (!cond) {
    print "FAIL: ${msg}"
    System.exit()
  }
}

/* ---- XShow.write uses GraphicsSerializer ---- */
var g = Graphics()
g.title = "xshow"
g.display(Sphere([0, 0, 0], 1, color=Red), [0, 0, 0], scale=0.3)
g.display(Text("Hi", [0, 0, 0], color=White))
var buf = Buf()
XShow().write(g, buf)
expect(firstPrefix(buf.lines, "S ") == "S 1 3", "XShow static preamble")
expect(countPrefix(buf.lines, "o ") == 1, "sphere object")
expect(countPrefix(buf.lines, "T ") == 1, "text draw")
expect(countPrefix(buf.lines, "U S") == 0, "static write is not U S")

buf.lines = []
XShow().write(g, buf, replace=true)
expect(firstPrefix(buf.lines, "U S") == "U S 1", "XShow replace preamble")

/* ---- XView constructs closed; SceneSerializer is selected for Scene ---- */
var v = XView()
expect(v.closed, "XView starts closed")
expect(isnil(v.serializer), "no serializer until open")

var scene = Scene()
var sid = scene.display(Sphere([0, 0, 0], 1, color=Blue), [0, 0, 0], scale=0.3)
var sbuf = Buf()
var ser = SceneSerializer(scene, sbuf)
ser.serialize()
expect(ser.objects.contains(sid), "SceneSerializer still maps spheres")

/* ---- XShow vs Show: same IR modulo color intern / c-M placement ---- */
fn rstrip(s) {
  var n = s.count()
  while (n > 0 && s[n-1] == " ") n -= 1
  return s.substring(0, n)
}

fn same(a, b) {
  if (a.count() != b.count()) return false
  for (i in 0...a.count()) if (a[i] != b[i]) return false
  return true
}

fn canon(lines) {
  var pre = []
  var cols = []
  var seen = Dictionary()
  var idpay = Dictionary()
  var modes = []
  var rest = []
  var inpre = true
  for (line in lines) {
    var t = rstrip(line)
    if (t.count() >= 2 && t[0] == "c" && t[1] == " ") {
      var tok = t.split(" ")
      var pay = String.join(tok[2...tok.count()], " ")
      idpay[tok[1]] = pay
      if (!seen.contains(pay)) {
        seen[pay] = true
        cols.append("c ${pay}")
      }
      continue
    }
    if (t == "M flat" || t == "M shaded") { modes.append(t); continue }
    if (inpre) {
      var ch = t.count() > 0 ? t[0] : ""
      if (ch == "S" || ch == "W" || ch == "G" || ch == "L" || ch == "U") {
        pre.append(t)
        continue
      }
      inpre = false
    }
    if (t.count() >= 2 && t[0] == "C" && t[1] == " ") {
      var tok = t.split(" ")
      rest.append("C ${idpay[tok[1]]}")
    } else rest.append(t)
  }
  return [pre, cols, modes, rest]
}

fn hasL(lines) {
  for (line in lines) {
    if (line.count() >= 2 && line[0] == "L" && line[1] == " ") return true
  }
  return false
}

fn parity(label, g) {
  var a = Buf()
  var b = Buf()
  Show().write(g, a)
  XShow().write(g, b)
  var ca = canon(a.lines)
  var cb = canon(b.lines)
  var ok = same(ca[0], cb[0]) && same(ca[1], cb[1]) &&
           same(ca[2], cb[2]) && same(ca[3], cb[3])
  if (!ok) {
    print "FAIL: ${label} show=${a.lines.count()} xshow=${b.lines.count()}"
    for (k in 0..3) {
      if (same(ca[k], cb[k])) continue
      print "  part ${k} ${ca[k].count()} vs ${cb[k].count()}"
      var n = ca[k].count() < cb[k].count() ? ca[k].count() : cb[k].count()
      for (i in 0...n) {
        if (ca[k][i] != cb[k][i]) {
          print "  show: ${ca[k][i]}"
          print "  xshow:${cb[k][i]}"
          break
        }
      }
    }
    System.exit()
  }
}

var gn = Graphics()
gn.display(Sphere([0, 0, 0], 1, color=Red), [0, 0, 0], scale=0.3)
var bn = Buf()
XShow().write(gn, bn)
expect(!hasL(bn.lines), "Neutral XShow omits L")
parity("neutral sphere", gn)

var gShare = Graphics()
gShare.display(Sphere([0, 0, 0], 1, color=Red), [0, 0, 0], scale=0.3)
gShare.display(Sphere([0, 0, 0], 1, color=Blue), [1, 0, 0], scale=0.3)
parity("shared spheres", gShare)
var bShare = Buf()
XShow().write(gShare, bShare)
expect(countPrefix(bShare.lines, "o ") == 1, "shared spheres emit one o")
expect(countPrefix(bShare.lines, "d ") == 2, "shared spheres emit two draws")

var gCyl = Graphics()
gCyl.display(Cylinder([0, 0, 0], [0, 0, 1], n=6, color=Red))
gCyl.display(Cylinder([1, 0, 0], [1, 0, 1], n=6, color=Green))
parity("shared cylinders", gCyl)

var gL = Graphics()
gL.setLights("threepoint")
gL.display(Sphere([0, 0, 0], 1, color=Red))
parity("threepoint", gL)

var mix = Graphics()
mix.display(PointCloud([[0, 0, 0]], color=Red))
mix.display(LineSet([[0, 0, 0], [1, 0, 0]], color=Green))
mix.display(Text("Hi", [0, 1, 0], color=White))
mix.display(Sphere([0, 0, 0], 0.2, color=Blue))
mix.display(Cylinder([0, 0, 0], [0, 0, 0.5], n=6, color=Yellow))
mix.display(Arrow([1, 0, 0], [1, 0, 1], n=6, aspectratio=0.25, color=Orange))
mix.display(Polygon([[2, 0, 0], [3, 0, 0], [2, 1, 0]], color=Cyan))
mix.display(TriangleComplex(
  Matrix([[0, 1, 0], [0, 0, 1], [0, 0, 0]]),
  Matrix([[0, 0, 0], [0, 0, 0], [1, 1, 1]]),
  Matrix([[1, 1, 1], [0, 0, 0], [0, 0, 0]]),
  Matrix([[1], [1], [1]])
), [4, 0, 0])
parity("mixed primitives", mix)

print "ok"
