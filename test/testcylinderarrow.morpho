// Cylinder/Arrow: authored storage and replace keeps entry pose.
// Expect: prints "ok" then exits.
//
//   cd test && morpho6 testcylinderarrow.morpho

import graphics
import color

fn expect(cond, msg) {
  if (!cond) {
    print "FAIL: ${msg}"
    System.exit()
  }
}

/* ---- zero-length stored, not drawn ---- */
var gz = Graphics()
var zcid = gz.display(Cylinder([0, 0, 0], [0, 0, 0], n=6))
var zaid = gz.display(Arrow([1, 1, 1], [1, 1, 1], n=6))
expect(!isnil(zcid) && !isnil(zaid), "degenerate still allocated ids")
expect(gz.findEntry(zcid).item.start[0] == 0, "stores authored zero cylinder")

/* ---- authored start/end stored; identity entry ---- */
var g = Graphics()
var cid = g.display(Cylinder([0, 0, 0], [0, 0, 2], aspectratio=0.2, n=8, color=Red))
var aid = g.display(Arrow([0, 0, 0], [1, 0, 0], aspectratio=0.25, n=8, color=Blue))
expect(cid == 1 && aid == 2, "ids allocated")

var ce = g.findEntry(cid)
expect(ce.item.start[2] == 0 && ce.item.end[2] == 2, "cylinder stores authored shaft")
expect(ce.item.n == 8, "cylinder keeps n")
expect(ce.scale == 1, "no pose args → identity scale")
expect(ce.position[0] == 0 && ce.position[1] == 0 && ce.position[2] == 0,
       "no pose args → identity translation")

var ae = g.findEntry(aid)
expect(ae.item.end[0] == 1, "arrow stores authored end")
expect(isnil(ae.rotate), "no pose args → nil rotate")

/* ---- replace Sphere keeps entry pose; stores authored item ---- */
var gsph = Scene()
var sid = gsph.display(Sphere([0, 0, 0], 1, color=Red), [1, 2, 3], scale=2)
var se = gsph.findEntry(sid)
expect(se.position[0] == 1 && se.scale == 2, "initial sphere pose")
expect(gsph.replace(sid, Sphere([2, 3, 4], 0.5, color=Blue)), "replace sphere")
se = gsph.findEntry(sid)
expect(se.item.r == 0.5 && se.item.center[0] == 2, "replaced stores authored sphere")
expect(abs(se.position[0]-1) < 1e-9 && abs(se.position[1]-2) < 1e-9 && abs(se.position[2]-3) < 1e-9,
       "replace keeps position")
expect(abs(se.scale - 2) < 1e-9, "replace keeps scale")

print "ok"
