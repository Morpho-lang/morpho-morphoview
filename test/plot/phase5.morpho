// xplot Phase 5: semantic Scene mutations (axes / colormap / range / center).
// Expect: prints "ok" then exits.
//
//   morpho6 test/plot/phase5.morpho

import meshtools
import xplot
import color
import graphics
import broadcast

fn expect(cond, msg) {
  if (!cond) {
    print "FAIL: ${msg}"
    System.exit()
  }
}

fn approx(a, b) { return abs(a - b) < 1e-9 }
fn approxEps(a, b, eps) { return abs(a - b) < eps }

fn faceRgb0(plot) {
  var face = plot.findEntry(plot._entries["faces"][0]).item
  return face.color.rgb(0)
}

/* ---- axes(false/true) ---- */
var am = AreaMesh(fn (u, v) [u, v, 0], 0..1:0.5, 0..1:0.5)
var pAx = Plot(am, color=Red, axes=true)
expect(pAx._entries.contains("axes"), "axes present after construct")
var nBefore = pAx.displaylist.count()
expect(pAx.axes(false), "axes(false) ok")
expect(!pAx._entries.contains("axes"), "axes role cleared")
expect(pAx.displaylist.count() < nBefore, "axes entries removed from scene")
expect(pAx.wantAxes == false, "wantAxes false")

expect(pAx.axes(true), "axes(true) ok")
expect(pAx._entries.contains("axes"), "axes redrawn")
expect(pAx._entries["axes"].count() > 1, "wire + labels")
expect(pAx.wantAxes, "wantAxes true")

/* ---- field semantic methods store kwargs ---- */
var f = Field(am, fn (x, y, z) x)
var p = Plot(f, style="interpolate", colormap=ViridisMap(), scalebar=true,
             cmin=0, cmax=1)
expect(p.style == "interpolate", "stores style")
expect(approx(p.cmin, 0) && approx(p.cmax, 1), "stores range")
expect(p._entries.contains("faces") && p._entries.contains("scalebar"), "faces+scalebar")
expect(p.scalebar(false), "scalebar(false) ok")
expect(!p._entries.contains("scalebar"), "scalebar role cleared")
expect(p.scalebar(true), "scalebar(true) ok")
expect(p._entries.contains("scalebar"), "scalebar redrawn")

var rgbViridis0 = Matrix(ViridisMap().rgb(0))
var rgb0 = faceRgb0(p)
expect(approxEps(rgb0[0], rgbViridis0[0], 1e-5) &&
       approxEps(rgb0[1], rgbViridis0[1], 1e-5) &&
       approxEps(rgb0[2], rgbViridis0[2], 1e-5), "initial colormap at low end")

/* ---- colormap(...) rebuilds geometry colors ---- */
var nFaces = p._entries["faces"].count()
expect(p.colormap(MagmaMap()), "colormap swap")
expect(p._entries.contains("faces"), "faces after colormap")
expect(p._entries["faces"].count() == nFaces, "same face entry count")
expect(p._entries.contains("scalebar"), "scalebar rebuilt")

var rgbMagma0 = Matrix(MagmaMap().rgb(0))
rgb0 = faceRgb0(p)
expect(approxEps(rgb0[0], rgbMagma0[0], 1e-5) &&
       approxEps(rgb0[1], rgbMagma0[1], 1e-5) &&
       approxEps(rgb0[2], rgbMagma0[2], 1e-5), "Magma at low end after swap")

/* ---- range(...) ---- */
expect(p.range(0.5, 1), "range ok")
expect(approx(p.cmin, 0.5) && approx(p.cmax, 1), "range stored")
// x=0 is below cmin → clamped → t=0 → still Magma(0)
rgb0 = faceRgb0(p)
expect(approxEps(rgb0[0], rgbMagma0[0], 1e-5) &&
       approxEps(rgb0[1], rgbMagma0[1], 1e-5) &&
       approxEps(rgb0[2], rgbMagma0[2], 1e-5), "clamped low stays map(0)")

/* ---- center(...) for diverging ---- */
var pDiv = Plot(f, style="interpolate", colormap=BlueWhiteRedMap, cmin=-1, cmax=1)
expect(pDiv.center(0), "center ok")
expect(approx(pDiv.center, 0), "center stored")
// At x=0 → normalized 0.5 → white mid of BlueWhiteRed
var mid = Matrix(BlueWhiteRedMap.rgb(0.5))
rgb0 = faceRgb0(pDiv)
expect(approxEps(rgb0[0], mid[0], 1e-5) &&
       approxEps(rgb0[1], mid[1], 1e-5) &&
       approxEps(rgb0[2], mid[2], 1e-5), "center maps mid to white")

/* ---- no-op on non-Field ---- */
var pMesh = Plot(am, color=Blue)
expect(!pMesh.colormap(ViridisMap()), "colormap rejected on mesh")
expect(!pMesh.range(0, 1), "range rejected on mesh")
expect(!pMesh.center(0), "center rejected on mesh")

/* ---- live axes/scalebar generate Scene events ---- */
class PlotCap with Listener {
  init() {
    self.definedIds = nil
    self.removedIds = nil
    self.morphed = nil
    self.nDefined = 0
    self.nRemoved = 0
    self.nMorphed = 0
  }
  receive(Scene scene, GraphicsEventDefined ev) {
    self.nDefined += 1
    self.definedIds = ev.ids
  }
  receive(Scene scene, GraphicsEventRemoved ev) {
    self.nRemoved += 1
    self.removedIds = ev.ids
  }
  receive(Scene scene, GraphicsEventMorphed ev) {
    self.nMorphed += 1
    self.morphed = ev
  }
}

var pLive = Plot(am, color=Red)
var capLive = PlotCap()
capLive.listen(pLive)
expect(pLive.axes(true), "axes(true) live")
expect(capLive.nDefined == 1, "axes one coalesced Defined")
expect(!isnil(capLive.definedIds) && capLive.definedIds.count() > 1,
       "axes Defined includes ticks/labels")
expect(pLive.axes(false), "axes(false) live")
expect(capLive.nRemoved == 1, "axes one coalesced Removed")
expect(!isnil(capLive.removedIds) && capLive.removedIds.count() > 1,
       "axes Removed includes ticks/labels")

var pBar = Plot(f, style="interpolate", colormap=ViridisMap(), cmin=0, cmax=1)
var capBar = PlotCap()
capBar.listen(pBar)
expect(pBar.scalebar(true), "scalebar(true) live")
expect(capBar.nDefined == 1, "scalebar one coalesced Defined")
expect(!isnil(capBar.definedIds) && capBar.definedIds.count() >= 1,
       "scalebar Defined has ids")
expect(pBar.scalebar(false), "scalebar(false) live")
expect(capBar.nRemoved == 1, "scalebar one coalesced Removed")

/* ---- fast morph path keeps face id and rebuilds scalebar ---- */
var pFast = Plot(f, style="interpolate", colormap=ViridisMap(), scalebar=true,
                 cmin=0, cmax=1)
var faceId = pFast._entries["faces"][0]
var bar0 = pFast._entries["scalebar"][0]
var nBar = pFast._entries["scalebar"].count()
var capFast = PlotCap()
capFast.listen(pFast)
expect(pFast.refresh(), "headless refresh")
expect(pFast._entries["faces"][0] == faceId, "fast path morphs same face id")
expect(pFast._entries.contains("scalebar"), "scalebar present after fast refresh")
expect(pFast._entries["scalebar"].count() == nBar, "scalebar entry count")
expect(pFast._entries["scalebar"][0] != bar0, "scalebar rebuilt with new ids")
expect(capFast.nMorphed == 1, "refresh morphs faces")
expect(capFast.nRemoved >= 1 && capFast.nDefined >= 1, "scalebar remove+define")

fn axesWireZHi(plot) {
  var pos = plot.findEntry(plot._entries["axes"][0]).item.position
  var n = pos.dimensions()[1]
  return bounds(pos[2, 0...n])[1]
}

/* ---- deforming Field rebuilds axes to match new bounds ---- */
var amB = AreaMesh(fn (u, v) [u, v, 0], 0..1:0.5, 0..1:0.5)
var pBounds = Plot(Field(amB, fn (x, y, z) z), style="interpolate", axes=true)
expect(pBounds._entries.contains("axes"), "axes at construct")
var axesId0 = pBounds._entries["axes"][0]
var nAxes = pBounds._entries["axes"].count()
var zHi0 = pBounds.bounds[2][1]
var wireZ0 = axesWireZHi(pBounds)
var faceZ0 = pBounds.findEntry(pBounds._entries["faces"][0]).item.position[2, 0]
var vert = amB.vertexmatrix().clone()
for (i in 0...vert.dimensions()[1]) vert[2, i] = 3
amB.setvertexmatrix(vert)
pBounds.source = Field(amB, fn (x, y, z) z) // Field samples z once
expect(pBounds.refresh(), "refresh after deform")
expect(pBounds.bounds[2][1] > zHi0 + 1, "bounds z updated")
expect(pBounds.findEntry(pBounds._entries["faces"][0]).item.position[2, 0] > faceZ0 + 1,
       "refresh morphs face vertices")
expect(pBounds._entries.contains("axes"), "axes still present")
expect(pBounds._entries["axes"].count() == nAxes, "same number of axes entries")
expect(pBounds._entries["axes"][0] != axesId0, "axes rebuilt")
expect(axesWireZHi(pBounds) > wireZ0 + 1, "axes frame tracks new extent")

print "ok"
