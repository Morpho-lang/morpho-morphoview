// Smoke: define once, D+redraw, pose-only `d`, draw-slots, then Phase 5d
// object/draw update-delete ops.
// Expect: prints "ok" then exits.
// Requires: morphoview on PATH, morpho-zeromq, display.
//
//   cd test && morpho6 testdefinedraw.morpho

import morphoview

fn load(path) {
  var f = File(path, "read")
  var s = f.readall()
  f.close()
  return s
}

var once = load("command/definedraw-once")
var redraw = load("command/definedraw-redraw")
var pose = load("command/definedraw-pose-update")
var slots = load("command/definedraw-drawslots")
var slotsPose = load("command/definedraw-drawslots-pose")
var updObj = load("command/definedraw-update-object")
var delObj = load("command/definedraw-delete-object")
var delDraw = load("command/definedraw-delete-draw")
var updVerts = load("command/definedraw-update-vertices")

var v = View()
if (!v.open(once)) {
  print "open failed"
  System.exit()
}

if (!v.redraw(redraw)) {
  print "redraw failed"
  v.close()
  System.exit()
}

// In-place matrix replace for existing object draws (Phase 5b).
if (!v.update(pose)) {
  print "pose update failed"
  v.close()
  System.exit()
}

// Phase 5d: same-length vertex morph (original object 2).
if (!v.update(updVerts)) {
  print "update vertices failed"
  v.close()
  System.exit()
}

// Phase 5d: redefine object 2 geometry via U O + v/f + draw.
if (!v.update(updObj)) {
  print "update object failed"
  v.close()
  System.exit()
}

// Phase 5d: delete object 3 (shadow) and its draws.
if (!v.update(delObj)) {
  print "delete object failed"
  v.close()
  System.exit()
}

v.close()

// Two draw slots sharing one object; pose updates only slot 10.
var v2 = View()
if (!v2.open(slots)) {
  print "drawslots open failed"
  System.exit()
}
if (!v2.update(slotsPose)) {
  print "drawslots pose failed"
  v2.close()
  System.exit()
}
// Phase 5d: delete one draw-slot; object and other slot remain.
if (!v2.update(delDraw)) {
  print "delete draw failed"
  v2.close()
  System.exit()
}
v2.wait(sessiontimeout=1500)
print "ok"
