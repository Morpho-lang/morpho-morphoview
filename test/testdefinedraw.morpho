// Smoke: define once, D+redraw, pose-only `d`, then draw-slot instancing.
// Expect: prints "ok" then exits.
// Requires: morphoview on PATH, morpho-zeromq, display.
//
//   cd test && morpho6 testdefinedraw.morpho

import morphoview

fn load(path) {
  var f = File(path, "read")
  var s = f.readall()
  f.close()
  return s
}

var once = load("command/definedraw-once")
var redraw = load("command/definedraw-redraw")
var pose = load("command/definedraw-pose-update")
var slots = load("command/definedraw-drawslots")
var slotsPose = load("command/definedraw-drawslots-pose")

var v = View()
if (!v.open(once)) {
  print "open failed"
  System.exit()
}

if (!v.redraw(redraw)) {
  print "redraw failed"
  v.close()
  System.exit()
}

// In-place matrix replace for existing object draws (Phase 5b).
if (!v.update(pose)) {
  print "pose update failed"
  v.close()
  System.exit()
}

v.close()

// Two draw slots sharing one object; pose updates only slot 10.
var v2 = View()
if (!v2.open(slots)) {
  print "drawslots open failed"
  System.exit()
}
if (!v2.update(slotsPose)) {
  print "drawslots pose failed"
  v2.close()
  System.exit()
}
v2.wait(sessionTimeOut=1500)
print "ok"
