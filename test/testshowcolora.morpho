// Color always has .a (default 1). Show uses Color.a / Coloring.opacity.
// Expect: prints "ok" then exits.
//
//   cd test && morpho6 testshowcolora.morpho

import morphoview
import xgraphics
import xcolor

class Buf {
  init() { self.lines = [] }
  write(line) { self.lines.append(line) }
}

fn anyHasAlpha(lines, a) {
  for (line in lines) {
    var parts = line.split(" ")
    if (parts.count() == 6 && parts[0] == "c" && parts[5] == a) return true
  }
  return false
}

fn anyExact(lines, want) {
  for (line in lines) {
    if (line == want) return true
  }
  return false
}

fn expect(cond, msg) {
  if (!cond) {
    print "FAIL: ${msg}"
    System.exit()
  }
}

var pos = Matrix([[0, 1, 0.5], [0, 0, 0.8], [0, 0, 0]])
var nrm = Matrix([[0, 0, 0], [0, 0, 0], [1, 1, 1]])
var conn = Matrix([[1], [1], [1]])

/* ---- item Color(r,g,b,a) ---- */
var g1 = Graphics()
g1.display(TriangleComplex(pos, nrm, Color(1, 0, 0, 0.4), conn))
var buf1 = Buf()
Show().write(g1, buf1)
expect(anyHasAlpha(buf1.lines, "0.4"), "item Color.a → alpha 0.4")
expect(anyExact(buf1.lines, "v \"xn\""), "Color.a translucent → xn")

/* ---- presentation color=Color(...,a) on display ---- */
var g4 = Graphics()
g4.display(TriangleComplex(pos, nrm, Blue, conn), color=Color(0, 0, 1, 0.25))
var buf4 = Buf()
Show().write(g4, buf4)
expect(anyHasAlpha(buf4.lines, "0.25"), "entry color Color.a → alpha 0.25")

/* ---- Scene.recolor with Color.a ---- */
var sc = Scene()
var id = sc.display(Sphere([0, 0, 0], 1, color=White), [0, 0, 0])
var show = Show()
var buf5 = Buf()
show.write(sc, buf5)
expect(sc.recolor(id, Color(1, 0.5, 0, 0.3)), "recolor with Color.a")
var buf6 = Buf()
expect(show.emitEntryRecolor(sc, id, buf6), "emit recolor")
expect(anyHasAlpha(buf6.lines, "0.3"), "recolor Color.a → alpha 0.3")

/* ---- Color API smoke ---- */
var c = Color(0.2, 0.4, 0.6, 0.8)
expect(c.alpha(0) == 0.8, "alpha()")
expect(istuple(c.rgba(0)) && c.rgba(0).count() == 4 && c.rgba(0)[3] == 0.8, "rgba() Tuple")
expect(Red.a == 1, "opaque named color has a=1")
expect(Red.alpha(0) == 1, "alpha() is 1 for opaque")

print "ok"
