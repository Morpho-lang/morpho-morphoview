// Scene move / listeners (no viewer required). Graphics stays static.
// Expect: prints "ok" then exits.
//
//   cd test && morpho6 testgraphicsmove.morpho

import xgraphics
import broadcast
import xcolor

fn expect(cond, msg) {
  if (!cond) {
    print "FAIL: ${msg}"
    System.exit()
  }
}

class Capture with Listener {
  init() {
    self.events = []
    self.movedIds = nil
    self.recolorIds = nil
  }
  receive(g, event) {
    self.events.append(self._kind(event))
  }
  receive(g, GraphicsEventMoved ev) {
    self.events.append(GraphicsEventMoved)
    self.movedIds = ev.ids
  }
  receive(g, GraphicsEventRecolored ev) {
    self.events.append(GraphicsEventRecolored)
    self.recolorIds = ev.ids
  }
  _kind(GraphicsEventDefined ev) { return GraphicsEventDefined }
  _kind(GraphicsEventMoved ev) { return GraphicsEventMoved }
  _kind(GraphicsEventRecolored ev) { return GraphicsEventRecolored }
  _kind(GraphicsEventRemoved ev) { return GraphicsEventRemoved }
  _kind(GraphicsEventReplaced ev) { return GraphicsEventReplaced }
}

/* ---- Scene is Graphics; static Graphics has no move ---- */
var staticG = Graphics()
expect(!isnil(staticG.displaylist), "Graphics constructs")
expect(!staticG.respondsto("move"), "Graphics has no move")
expect(!staticG.respondsto("subscribe"), "Graphics is not a Broadcaster")
var sceneProbe = Scene()
expect(sceneProbe.superclass() == Graphics, "Scene is Graphics")
expect(sceneProbe.respondsto("move") && sceneProbe.respondsto("subscribe"), "Scene is live")

/* ---- move merge ---- */
var g = Scene()
var tc = TriangleComplex(
  Matrix([[0, 1, 0], [0, 0, 1], [0, 0, 0]]),
  Matrix([[0, 0, 0], [0, 0, 0], [1, 1, 1]]),
  Matrix([[1, 1, 1], [0, 0, 0], [0, 0, 0]]),
  Matrix([[1], [1], [1]])
)
var id = g.display(tc, [1, 2, 3], scale=2, rotate=[0.1, 0, 1, 0])
var e = g.findEntry(id)
expect(e.position[0] == 1 && e.scale == 2, "initial pose")

expect(g.move(id, [4, 5, 6]), "move position")
expect(e.position[0] == 4 && e.position[1] == 5 && e.position[2] == 6, "position set")
expect(e.scale == 2, "scale unchanged when omitted")
expect(!isnil(e.rotate), "rotate unchanged when omitted")

expect(g.move(id, scale=3.5), "move scale only")
expect(e.position[0] == 4, "position unchanged on scale-only move")
expect(e.scale == 3.5, "scale updated")

expect(g.move(id, [0, 0, 0], rotate=[1, 0, 0, 1]), "move position+rotate")
expect(e.position[0] == 0 && e.position[1] == 0 && e.position[2] == 0, "position origin")
expect(e.scale == 3.5, "scale still 3.5")
expect(e.rotate[0] == 1, "rotate updated")

expect(!g.move(999, [0, 0, 0]), "missing id fails")

/* ---- immediate listener ---- */
var g2 = Scene()
var cap = Capture()
cap.listen(g2)
var id2 = g2.display(tc, [0, 1, 0])
expect(cap.events.count() == 1 && cap.events[0] == GraphicsEventDefined, "immediate defined")
g2.move(id2, [1, 1, 1])
expect(cap.events.count() == 2 && cap.events[1] == GraphicsEventMoved, "immediate moved")

/* ---- ignore ---- */
var g5 = Scene()
var cap5 = Capture()
cap5.listen(g5)
cap5.ignore(g5)
g5.display(tc)
expect(cap5.events.count() == 0, "ignored silent")

/* ---- begin/end batching ---- */
var gBatch = Scene()
var capBatch = Capture()
capBatch.listen(gBatch)
var idA = gBatch.display(tc, [0, 0, 0])
var idB = gBatch.display(tc, [1, 0, 0])
expect(capBatch.events.count() == 2, "display outside batch still notifies")
capBatch.events = []
gBatch.beginBatch()
gBatch.move(idA, [2, 0, 0])
gBatch.move(idB, [3, 0, 0], scale=2)
expect(capBatch.events.count() == 0, "moves inside batch silent")
gBatch.endBatch()
expect(capBatch.events.count() == 1 && capBatch.events[0] == GraphicsEventMoved, "one coalesced Moved")
capBatch.events = []
gBatch.beginBatch()
gBatch.endBatch()
expect(capBatch.events.count() == 0, "empty batch silent")
capBatch.events = []
gBatch.beginBatch()
gBatch.beginBatch()
gBatch.move(idA, [4, 0, 0])
gBatch.endBatch()
expect(capBatch.events.count() == 0, "inner end does not flush")
gBatch.endBatch()
expect(capBatch.events.count() == 1 && capBatch.events[0] == GraphicsEventMoved, "outer end flushes")
capBatch.events = []
gBatch.beginBatch()
var idC = gBatch.display(tc, [5, 0, 0])
gBatch.move(idA, [6, 0, 0])
gBatch.endBatch()
expect(capBatch.events.count() == 2, "batch flushes Defined then Moved")
expect(capBatch.events[0] == GraphicsEventDefined, "Defined first")
expect(capBatch.events[1] == GraphicsEventMoved, "Moved after Defined")

/* ---- Show objectMap for TriangleComplex ---- */
var g6 = Scene()
var id6 = g6.display(tc, [1, 0, 0], scale=2)
class Buf {
  init() { self.lines = [] }
  write(line) { self.lines.append(line) }
}
var buf = Buf()
var show = Show()
show.write(g6, buf)
expect(show.objectMap[id6] == 1, "objectMap records viewer id")
expect(show.objectMap.contains(id6), "TC is mapped")

var buf2 = Buf()
show.emitPoseDraws(g6, buf2)
expect(buf2.lines.count() > 0, "emitPoseDraws emits")
var hasT = false
for (line in buf2.lines) {
  if (line.count() >= 2 && line[0] == "t") hasT = true
}
expect(hasT, "pose redraw includes translation")

/* ---- event.ids + emitEntryPose (selective, no D) ---- */
var g7 = Scene()
var id7a = g7.display(tc, [0, 0, 0], scale=1)
var id7b = g7.display(tc, [1, 0, 0], scale=1)
var cap7 = Capture()
cap7.listen(g7)
var show7 = Show()
var buf7 = Buf()
show7.write(g7, buf7)
g7.beginBatch()
g7.move(id7a, [2, 0, 0])
g7.move(id7b, [3, 0, 0], scale=2)
g7.endBatch()
expect(cap7.events.count() == 1 && cap7.events[0] == GraphicsEventMoved, "one coalesced Moved")
expect(!isnil(cap7.movedIds) && cap7.movedIds.count() == 2, "event.ids has both movers")
expect(cap7.movedIds[0] == id7a && cap7.movedIds[1] == id7b, "event.ids first-seen order")

var bufPose = Buf()
expect(show7.emitEntryPose(g7, id7a, bufPose), "emitEntryPose a")
expect(show7.emitEntryPose(g7, id7b, bufPose), "emitEntryPose b")
var hasD = false
var hasClear = false
for (line in bufPose.lines) {
  if (line.count() >= 1 && line[0] == "D") hasClear = true
  if (line.count() >= 2 && line[0] == "d") hasD = true
}
expect(hasD && !hasClear, "selective pose emits d without D")

// Unmapped id: no emit (View must not D+redraw — would blank the window).
var bufMiss = Buf()
expect(!show7.emitEntryPose(g7, 999, bufMiss), "unmapped pose fails")
expect(bufMiss.lines.count() == 0, "unmapped pose emits nothing")

/* ---- two listeners see the same full id list ---- */
var gMulti = Scene()
var idMa = gMulti.display(tc, [0, 0, 0])
var idMb = gMulti.display(tc, [1, 0, 0])
var capM1 = Capture()
var capM2 = Capture()
capM1.listen(gMulti)
capM2.listen(gMulti)
gMulti.beginBatch()
gMulti.move(idMa, [2, 0, 0])
gMulti.move(idMb, [3, 0, 0])
gMulti.endBatch()
expect(capM1.movedIds.count() == 2 && capM2.movedIds.count() == 2, "both listeners get two ids")
expect(capM1.movedIds[0] == idMa && capM1.movedIds[1] == idMb, "listener 1 full set")
expect(capM2.movedIds[0] == idMa && capM2.movedIds[1] == idMb, "listener 2 full set")

/* ---- recolor ---- */
var g8 = Scene()
var id8 = g8.display(Sphere([0, 0, 0], 1, color=Red, maxrefine=1), [0, 0, 0], scale=0.5)
expect(g8.recolor(id8, Blue), "recolor ok")
expect(g8.findEntry(id8).color == Blue, "entry color updated")
expect(!g8.recolor(999, Red), "missing id fails")

var cap8 = Capture()
cap8.listen(g8)
g8.beginBatch()
g8.recolor(id8, Green)
g8.recolor(id8, Yellow)
expect(cap8.events.count() == 0, "recolor inside batch silent")
g8.endBatch()
expect(cap8.events.count() == 1 && cap8.events[0] == GraphicsEventRecolored, "one coalesced Recolored")
expect(!isnil(cap8.recolorIds) && cap8.recolorIds.count() == 1, "recolor event.ids")
expect(cap8.recolorIds[0] == id8, "recolor id on event")

var show8 = Show()
var buf8 = Buf()
show8.write(g8, buf8)
var bufRecolor = Buf()
expect(show8.emitEntryRecolor(g8, id8, bufRecolor), "emitEntryRecolor")
var hasC = false
var hasPoseD = false
for (line in bufRecolor.lines) {
  if (line.count() >= 1 && line[0] == "C") hasC = true
  if (line == "d ${id8}") hasPoseD = true
}
expect(hasC && hasPoseD, "recolor emits C and d <id>")

/* ---- remove / replace (Phase 5d) ---- */
var g9 = Scene()
var id9a = g9.display(tc, [0, 0, 0])
var id9b = g9.display(tc, [1, 0, 0])
var cap9 = Capture()
cap9.listen(g9)
expect(g9.remove(id9a), "remove ok")
expect(isnil(g9.findEntry(id9a)), "entry gone")
expect(!isnil(g9.findEntry(id9b)), "other entry kept")
expect(cap9.events.count() == 1 && cap9.events[0] == GraphicsEventRemoved, "Removed event")
expect(!g9.remove(id9a), "remove missing fails")

var g10 = Scene()
var id10 = g10.display(tc, [0, 0, 0], scale=2)
var cap10 = Capture()
cap10.listen(g10)
var tc2 = TriangleComplex(
  Matrix([[0, 2, 0], [0, 0, 2], [0, 0, 0]]),
  Matrix([[0, 0, 0], [0, 0, 0], [1, 1, 1]]),
  Matrix([[0, 0, 0], [1, 1, 1], [0, 0, 0]]),
  Matrix([[1], [1], [1]])
)
expect(g10.replace(id10, tc2), "replace ok")
expect(g10.findEntry(id10).item == tc2, "item replaced")
expect(g10.findEntry(id10).scale == 2, "SRT unchanged on replace")
expect(cap10.events.count() == 1 && cap10.events[0] == GraphicsEventReplaced, "Replaced event")

/* ---- morph (same-length item swap, no event) vs replace ---- */
var gMorph = Scene()
var capMorph = Capture()
capMorph.listen(gMorph)
var idM = gMorph.display(tc)
expect(capMorph.events.count() == 1, "display Defined")
var tcMorph = TriangleComplex(
  Matrix([[0, 1.1, 0], [0, 0, 1.1], [0, 0, 0]]),
  Matrix([[0, 0, 0], [0, 0, 0], [1, 1, 1]]),
  Matrix([[1, 1, 1], [0, 0, 0], [0, 0, 0]]),
  Matrix([[1], [1], [1]])
)
expect(gMorph.morph(idM, tcMorph), "morph ok")
expect(gMorph.findEntry(idM).item == tcMorph, "morph sets item")
expect(capMorph.events.count() == 1, "morph does not notify")
expect(!gMorph.morph(999, tcMorph), "morph missing id fails")
expect(!gMorph.morph(idM, 1), "morph bad item fails")

var show9 = Show()
var buf9 = Buf()
show9.write(g9, buf9)
expect(show9.objectMap.contains(id9b), "remaining mapped")
var bufRm = Buf()
expect(show9.emitEntryRemove(id9b, bufRm), "emitEntryRemove")
var hasXD = false
var hasXO = false
for (line in bufRm.lines) {
  if (line == "X D ${id9b}") hasXD = true
  if (line.count() >= 3 && line[0] == "X" && line[2] == "O") hasXO = true
}
expect(hasXD && hasXO, "remove emits X D and X O for last user")
expect(!show9.objectMap.contains(id9b), "map cleared after remove emit")

var show10 = Show()
var buf10w = Buf()
show10.write(g10, buf10w)
expect(show10.objectMap.contains(id10), "mapped before replace emit")
var bufRep = Buf()
expect(show10.emitEntryReplace(g10, id10, bufRep), "emitEntryReplace")
var hasXD = false
var hasDefine = false
for (line in bufRep.lines) {
  if (line == "X D ${id10}") hasXD = true
  if (line.count() >= 1 && line[0] == "o") hasDefine = true
}
expect(hasXD && hasDefine, "replace drops slot then redefines")
expect(show10.objectMap.contains(id10), "replace remaps entry")

/* ---- shared Sphere remove: X D only while other users remain ---- */
var g11 = Scene()
var sUnit = Sphere([0, 0, 0], 1, color=Red, maxrefine=1)
var id11a = g11.display(sUnit, [0, 0, 0], scale=0.4)
var id11b = g11.display(sUnit, [1, 0, 0], scale=0.4)
var show11 = Show()
var buf11 = Buf()
show11.write(g11, buf11)
expect(show11.objectMap[id11a] == show11.objectMap[id11b], "spheres share viewer o")
var sharedVid = show11.objectMap[id11a]
var bufRmA = Buf()
show11.emitEntryRemove(id11a, bufRmA)
var hasXOa = false
for (line in bufRmA.lines) {
  if (line == "X O ${sharedVid}") hasXOa = true
}
expect(!hasXOa, "shared sphere remove skips X O while sibling remains")
expect(show11.objectMap.contains(id11b), "sibling still mapped")
var bufRmB = Buf()
show11.emitEntryRemove(id11b, bufRmB)
var hasXOb = false
for (line in bufRmB.lines) {
  if (line == "X O ${sharedVid}") hasXOb = true
}
expect(hasXOb, "last shared sphere user emits X O")

print "ok"
