// Color.a maps to uniform RGBA in Show (no display needed).
// Expect: prints "ok" then exits.
//
//   cd test && morpho6 testshowtransmit.morpho

import morphoview
import xgraphics
import xcolor

class Buf {
  init() { self.lines = [] }
  write(line) { self.lines.append(line) }
}

fn anyExact(lines, want) {
  for (line in lines) {
    if (line == want) return true
  }
  return false
}

fn anyHasAlpha(lines, a) {
  for (line in lines) {
    var parts = line.split(" ")
    if (parts.count() == 6 && parts[0] == "c" && parts[5] == a) return true
  }
  return false
}

fn expect(cond, msg) {
  if (!cond) {
    print "FAIL: ${msg}"
    System.exit()
  }
}

fn approx(a, b, eps) { return abs(a-b) < eps }

var pos = Matrix([[0, 1, 0.5], [0, 0, 0.8], [0, 0, 0]])
var nrm = Matrix([[0, 0, 0], [0, 0, 0], [1, 1, 1]])
var conn = Matrix([[1], [1], [1]])

var g = Graphics()
g.title = "alpha"
g.display(TriangleComplex(pos, nrm, Color(1, 0, 0, 0.6), conn))
g.display(TriangleComplex(pos, nrm, Blue.opacity(0.75), conn))

var buf = Buf()
var show = Show()
show.write(g, buf)
var lines = buf.lines

expect(anyExact(lines, "C 0"), "expected color select")
expect(anyExact(lines, "v \"xn\""), "transparent meshes should use xn (uniform albedo)")
expect(anyHasAlpha(lines, "0.6"), "Color.a 0.6")
expect(anyHasAlpha(lines, "0.75"), "opacity 0.75")
expect(!anyExact(lines, "v \"xnc\""), "should not bake vertex colors when translucent")

/* [Compatibility shim] transmit=/filter= → Color.a */
var st = Sphere([0, 0, 0], 1, color=Red, transmit=0.4)
expect(approx(st.color.a, 0.6, 1e-9), "transmit=0.4 → alpha 0.6")
expect(!st.has("transmit"), "transmit not stored on the primitive")
var sf = Sphere([0, 0, 0], 1, color=Blue, filter=0.25)
expect(approx(sf.color.a, 0.75, 1e-9), "filter=0.25 → alpha 0.75")
var sboth = Cylinder([0, 0, 0], [0, 0, 1], color=Green, filter=0.2, transmit=0.3)
expect(approx(sboth.color.a, 0.5, 1e-9), "filter+transmit clamped sum")

print "ok"
