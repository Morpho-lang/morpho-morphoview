// Live Scene: Cylinder replace (authored start/end; shared unit mesh).
// Expect: prints "ok" then exits.
// Requires: morphoview on PATH, morpho-zeromq, display.
//
//   cd test && morpho6 testviewcylinder.morpho

import morphoview
import xgraphics
import color

var g = Scene()
g.title = "cylinder-replace"
var id = g.display(Cylinder([0, 0, 0], [0, 0, 1], aspectratio=0.2, n=8, color=Red))

var v = View(g)

for (i in 1...8) {
  if (v.closed) break
  var L = 0.8 + 0.1*Float(i)
  var x = 0.05*Float(i)
  g.replace(id, Cylinder([x, 0, 0], [x, 0, L], aspectratio=0.2, n=8, color=Red))
  System.sleep(0.05)
  v.poll(timeoutms=0)
}

if (!v.closed) v.close()
print "ok"
