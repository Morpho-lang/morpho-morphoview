// Higher-level smoke test via the morphoview `View` helper.
// Expect: prints "ok" then exits.
// Requires: morphoview on PATH, morpho-zeromq package, display available.
//
//   cd test && morpho6 testview.morpho

import morphoview

var f = File("polyhedra", "read")
var commands = f.readall()
f.close()

var v = View()
if (!v.open(commands)) {
  print "open failed"
} else {
  v.wait(sessionTimeOut=1500)
  print "ok"
}
