// Live Scene: open → move without U S.
// Expect: prints "ok" then exits.
// Requires: morphoview on PATH, morpho-zeromq, display.
//
//   cd test && morpho6 testviewmove.morpho

import morphoview
import xgraphics

fn tri() {
  return TriangleComplex(
    Matrix([[-0.5, 0.5, 0], [-0.5, -0.5, 0.5], [0, 0, 0]]),
    Matrix([[0, 0, 0], [0, 0, 0], [1, 1, 1]]),
    Matrix([[1, 1, 1], [0.4, 0.4, 0.4], [0.1, 0.1, 0.1]]),
    Matrix([[1], [1], [1]])
  )
}

var g = Scene()
g.title = "move"
var id = g.display(tri(), [0, 0, 0], scale=1)

var v = View(g)

for (i in 1...8) {
  if (v.closed) break
  var a = Float(i) * 0.15
  g.move(id, [0.1*i, 0, 0], scale=1 + 0.05*i, rotate=[a, 0, 0, 1])
  System.sleep(0.05)
  v.poll(timeoutms=0)
}

if (!v.closed) v.close()
print "ok"
