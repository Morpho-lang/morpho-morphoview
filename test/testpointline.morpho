// PointCloud / LineSet → viewer p / l (no display needed).
// Expect: prints "ok" then exits.
//
//   cd test && morpho6 testpointline.morpho

import morphoview
import xgraphics
import xcolor

class Buf {
  init() { self.lines = [] }
  write(line) { self.lines.append(line) }
}

fn anyExact(lines, want) {
  for (line in lines) {
    if (line == want) return true
  }
  return false
}

fn anyStarts(lines, prefix) {
  for (line in lines) {
    if (line.count() >= prefix.count()) {
      var ok = true
      for (i in 0...prefix.count()) {
        if (line[i] != prefix[i]) { ok = false; break }
      }
      if (ok) return true
    }
  }
  return false
}

fn expect(cond, msg) {
  if (!cond) {
    print "FAIL: ${msg}"
    System.exit()
  }
}

var pos = Matrix([[0, 1, 0], [0, 0, 1], [0, 0, 0]])

var g = Graphics()
g.title = "pointline"
g.display(PointCloud(pos, color=Red))
g.display(LineSet(pos, color=Blue))
g.display(LineSet(pos, [[0, 2], [1, 2]], color=Green))

var buf = Buf()
var show = Show()
show.write(g, buf)
var lines = buf.lines

expect(anyExact(lines, "v \"x\""), "uniform points/lines should use colorless x + C")
expect(!anyExact(lines, "v \"xc\""), "uniform points/lines should not bake per-vertex RGB")
expect(anyStarts(lines, "p "), "expected point element command")
expect(anyExact(lines, "p 0 1 2") || anyStarts(lines, "p 0"), "expected point indices")
expect(anyStarts(lines, "l "), "expected line element command")
expect(anyExact(lines, "l 0 1 1 2"), "polyline should connect successive vertices")
expect(anyExact(lines, "l 0 2 1 2"), "explicit segment pairs")
expect(anyExact(lines, "M flat"), "points/lines should request flat shading")
expect(!anyExact(lines, "v \"xnc\""), "should not emit triangle xnc for point/line prims")

var g4 = Graphics()
g4.display(PointCloud(pos, color=ColorTable(Matrix([[1, 0, 0], [0, 1, 0], [0, 0, 1], [0.4, 0.5, 0.6]]))))
var buf4 = Buf()
Show().write(g4, buf4)
expect(anyExact(buf4.lines, "v \"xca\""), "RGBA PointCloud → xca")
expect(!anyExact(buf4.lines, "v \"xc\""), "RGBA PointCloud is not xc")

// Translucent points → alpha on color table
var g2 = Graphics()
g2.display(PointCloud(pos, color=Color(1, 0, 0, 0.5)))
var buf2 = Buf()
Show().write(g2, buf2)
expect(anyStarts(buf2.lines, "c "), "expected color command for translucent points")

/* ---- entry SRT on PointCloud ---- */
var g3 = Graphics()
var id3 = g3.display(PointCloud(pos, color=Red), [1, 2, 3], scale=2)
var buf3 = Buf()
var show3 = Show()
show3.write(g3, buf3)
expect(show3.slots.contains(id3), "PointCloud entry is mapped")
expect(anyStarts(buf3.lines, "t 1"), "posed PointCloud emits translation")
expect(anyExact(buf3.lines, "d ${id3} ${show3.slots[id3].objectid}"), "d graphicsId objectId")

print "ok"
