// Text: authored posn, replace keeps SRT, dirn/vertical.
// Expect: prints "ok" then exits.
//
//   cd test && morpho6 testtextslot.morpho

import graphics
import color

fn expect(cond, msg) {
  if (!cond) {
    print "FAIL: ${msg}"
    System.exit()
  }
}

/* ---- display keeps posn on the item; identity entry unless pose args ---- */
var g = Graphics()
var tid = g.display(Text("hi", [1, 2, 3], color=Red))
expect(tid == 1, "id allocated")
var te = g.findEntry(tid)
expect(te.item.posn[0] == 1 && te.item.posn[1] == 2 && te.item.posn[2] == 3,
       "item keeps authored posn")
expect(te.position[0] == 0 && te.position[1] == 0 && te.position[2] == 0,
       "no pose args → identity entry translation")
expect(te.item.dirn[0] == 1 && te.item.dirn[1] == 0 && te.item.dirn[2] == 0,
       "default dirn is +x")
expect(te.item.vertical[0] == 0 && te.item.vertical[1] == 0 && te.item.vertical[2] == 1,
       "default vertical is in xz, perp to +x")

var tid2 = g.display(Text("bye", [0, 0, 0], color=Blue), [0.5, 0, 0], scale=2)
expect(tid2 == 2, "posed id")
expect(g.findEntry(tid2).scale == 2, "explicit scale on entry")

/* ---- replace content keeps SRT ---- */
var sc2 = Scene()
var rid = sc2.display(Text("old", [2, 3, 4], color=Green))
expect(sc2.replace(rid, Text("new", [9, 9, 9], color=White)), "replace")
var re = sc2.findEntry(rid)
expect(re.item.string == "new", "string replaced")
expect(re.position[0] == 0 && re.position[1] == 0 && re.position[2] == 0,
       "entry pose kept (identity)")
expect(re.item.posn[0] == 9, "replaced item keeps its posn")

/* ---- dirn/vertical defaults and errors ---- */
var tz = Text("z", [0, 0, 0], dirn=[0, 0, 1])
expect(tz.vertical[0] == -1 && tz.vertical[1] == 0 && tz.vertical[2] == 0,
       "default vertical perp to +z in xz")
var ty = Text("y", [0, 0, 0], dirn=[0, 1, 0])
expect(ty.vertical[0] == 1 && ty.vertical[1] == 0 && ty.vertical[2] == 0,
       "dirn along y → default vertical +x")

var badPar = false
try {
  Text("bad", [0, 0, 0], dirn=[1, 0, 0], vertical=[2, 0, 0])
} catch {
  "GfxTxtDrnVrtPrll" : badPar = true
}
expect(badPar, "parallel dirn/vertical throws")

var badZ = false
try {
  Text("bad", [0, 0, 0], dirn=[0, 0, 0])
} catch {
  "GfxTxtDrnVrtPrll" : badZ = true
}
expect(badZ, "zero dirn throws")

print "ok"
