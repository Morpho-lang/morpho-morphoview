// Phase 5f: Text draw-slots — entry pose, Show emit, move/remove/recolor.
// Expect: prints "ok" then exits.
//
//   cd test && morpho6 testtextslot.morpho

import xgraphics
import color

class Buf {
  init() { self.lines = [] }
  write(line) { self.lines.append(line) }
}

fn countPrefix(lines, prefix) {
  var n = 0
  for (line in lines) {
    if (line.count() >= prefix.count()) {
      var ok = true
      for (i in 0...prefix.count()) {
        if (line[i] != prefix[i]) { ok = false; break }
      }
      if (ok) n += 1
    }
  }
  return n
}

fn expect(cond, msg) {
  if (!cond) {
    print "FAIL: ${msg}"
    System.exit()
  }
}

/* ---- display lifts posn onto entry ---- */
var g = Graphics()
var tid = g.display(Text("hi", [1, 2, 3], color=Red))
expect(tid == 1, "id allocated")
var te = g.findEntry(tid)
expect(te.item.posn[0] == 0 && te.item.posn[1] == 0 && te.item.posn[2] == 0,
       "item at origin")
expect(te.position[0] == 1 && te.position[1] == 2 && te.position[2] == 3,
       "entry has authored posn")

var tid2 = g.display(Text("bye", [0, 0, 0], color=Blue), [0.5, 0, 0], scale=2)
expect(tid2 == 2, "posed id")
expect(g.findEntry(tid2).scale == 2, "explicit scale on entry")

/* ---- Show: T <entryId> <fontId> "…" + maps ---- */
var buf = Buf()
var show = Show()
show.write(g, buf)
expect(countPrefix(buf.lines, "T ") == 2, "two text slots")
expect(countPrefix(buf.lines, "T 1 ") == 1, "draw-slot id 1")
expect(countPrefix(buf.lines, "T 2 ") == 1, "draw-slot id 2")
expect(show.textIds.contains(1) && show.textIds.contains(2), "textIds mapped")
expect(show.objectMap.contains(1) && show.objectMap.contains(2), "objectMap mapped")

/* ---- Scene move / recolor / remove ---- */
var sc = Scene()
var id1 = sc.display(Text("a", [0, 0, 0], color=Red))
var id2 = sc.display(Text("b", [1, 0, 0], color=Blue))

var show2 = Show()
var openBuf = Buf()
show2.write(sc, openBuf)
expect(show2.textIds.contains(id1), "scene text mapped")

expect(sc.move(id1, [0.5, 0.25, 0]), "move text")
var poseBuf = Buf()
expect(show2.emitEntryPose(sc, id1, poseBuf), "pose emit")
expect(countPrefix(poseBuf.lines, "T ") == 0, "pose has no T redefine")
expect(poseBuf.lines[poseBuf.lines.count()-1] == "d ${id1}", "pose ends with d id")

expect(sc.recolor(id2, Yellow), "recolor text")
var colBuf = Buf()
expect(show2.emitEntryRecolor(sc, id2, colBuf), "recolor emit")
expect(countPrefix(colBuf.lines, "d ${id2}") == 1, "recolor redraws slot")

expect(sc.remove(id2), "remove text")
var remBuf = Buf()
show2.emitEntryRemove(id2, remBuf)
expect(countPrefix(remBuf.lines, "X D ${id2}") == 1, "X D for removed")
expect(countPrefix(remBuf.lines, "X O ") == 0, "no X O for text")
expect(show2.objectMap.contains(id1), "sibling text still mapped")
expect(!show2.textIds.contains(id2), "removed from textIds")

/* ---- replace content keeps SRT ---- */
var sc2 = Scene()
var rid = sc2.display(Text("old", [2, 3, 4], color=Green))
expect(sc2.replace(rid, Text("new", [9, 9, 9], color=White)), "replace")
var re = sc2.findEntry(rid)
expect(re.item.string == "new", "string replaced")
expect(re.position[0] == 2 && re.position[1] == 3 && re.position[2] == 4,
       "entry pose kept")
expect(re.item.posn[0] == 0, "replaced item at origin")

print "ok"
