// Graphics → View via Show serializer (open + update).
// Expect: prints "ok" then exits.
// Requires: morphoview on PATH, morpho-zeromq, display, xgraphics.
//
//   cd test && morpho6 testviewgraphics.morpho

import morphoview
import xgraphics

fn triangle(angle) {
  var c = cos(angle)
  var s = sin(angle)
  var x0 = c*(-0.5) - s*(-0.5)
  var y0 = s*(-0.5) + c*(-0.5)
  var x1 = c*( 0.5) - s*(-0.5)
  var y1 = s*( 0.5) + c*(-0.5)
  var x2 = c*( 0.0) - s*( 0.5)
  var y2 = s*( 0.0) + c*( 0.5)

  var pos = Matrix([[x0, x1, x2], [y0, y1, y2], [0, 0, 0]])
  var nrm = Matrix([[0, 0, 0], [0, 0, 0], [1, 1, 1]])
  var col = Matrix([[1, 1, 1], [0.4, 0.4, 0.4], [0.1, 0.1, 0.1]])
  var conn = Matrix([[1], [1], [1]])

  var g = Graphics()
  g.title = "graphics"
  g.display(TriangleComplex(pos, nrm, col, conn))
  return g
}

var v = View()
if (!v.open(triangle(0))) {
  print "open failed"
} else {
  for (i in 1...12) {
    if (v.closed) break
    v.update(triangle(Float(i)*0.2))
    System.sleep(0.05)
    v.poll(timeoutms=0)
  }
  v.close()
  print "ok"
}
